<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:mosair.ViewModels"
        xmlns:ctrl="using:mosair.Controls"
        xmlns:svc="using:mosair.Services"
        xmlns:conv="using:mosair.Converters"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="800"
        x:Class="mosair.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="avares://mosair/Assets/mosair-icon.png"
        Title=" " Width="1200" Height="800"
        MinWidth="900" MinHeight="600"
        WindowState="Maximized"
        Background="{DynamicResource BgMain}"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="32">

  <Window.Resources>
    <ResourceDictionary>
      <conv:InvariantDoubleConverter x:Key="InvDouble"/>
    </ResourceDictionary>
  </Window.Resources>

  <Window.Styles>
    <Style Selector="Button.icon-btn">
      <Setter Property="Width" Value="32"/>
      <Setter Property="Height" Value="32"/>
      <Setter Property="Padding" Value="6"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="4"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Button.icon-btn:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource BgHover}"/>
    </Style>
    <Style Selector="Button.icon-btn:disabled">
      <Setter Property="Opacity" Value="0.3"/>
    </Style>
    <Style Selector="Button.icon-btn.exporting:disabled">
      <Setter Property="Opacity" Value="1"/>
    </Style>
    <Style Selector="MenuItem">
      <Setter Property="Foreground" Value="{DynamicResource FgMenu}"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Padding" Value="8,4"/>
    </Style>
    <Style Selector="MenuItem:pointerover /template/ Border#PART_LayoutRoot">
      <Setter Property="Background" Value="{DynamicResource BgHover}"/>
    </Style>
    <Style Selector="Button.mos-btn">
      <Setter Property="Background" Value="{DynamicResource AccentFill}"/>
      <Setter Property="Padding" Value="10,5"/>
      <Setter Property="CornerRadius" Value="6"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Foreground" Value="{DynamicResource OnAccent}"/>
      <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style Selector="Button.mos-btn:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AccentFillHover}"/>
      <Setter Property="Foreground" Value="{DynamicResource OnAccent}"/>
    </Style>
    <Style Selector="Button.mos-btn:pressed /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AccentFillPressed}"/>
      <Setter Property="Foreground" Value="{DynamicResource OnAccent}"/>
    </Style>
    <Style Selector="Button.mos-btn:disabled">
      <Setter Property="Opacity" Value="0.75"/>
    </Style>
    <Style Selector="Button.mos-btn:disabled /template/ ContentPresenter">
      <Setter Property="Opacity" Value="1"/>
    </Style>
    <Style Selector="TextBlock.section-title">
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="Foreground" Value="{DynamicResource FgMuted}"/>
      <Setter Property="Margin" Value="0,6,0,2"/>
    </Style>
    <!-- Cards of the properties panel's image information -->
    <Style Selector="Border.info-card">
      <Setter Property="Background" Value="{DynamicResource BgInput}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BrdrMain}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="6"/>
      <Setter Property="Padding" Value="9,8"/>
    </Style>
  </Window.Styles>

  <DockPanel>
    <!-- ===== TITLE BAR: green "mosair" + Menu ===== -->
    <Border DockPanel.Dock="Top" Background="{DynamicResource BgBar}" Height="32"
            BorderBrush="{DynamicResource BrdrMain}" BorderThickness="0,0,0,1"
            PointerPressed="OnTitleBarPointerPressed">
      <Panel>
      <!-- Right margin keeps clear of the system window buttons -->
      <DockPanel Margin="0,0,142,0">
        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal"
                    VerticalAlignment="Center" Spacing="0">
          <TextBlock Text="mosair" FontWeight="Bold" FontSize="14"
                     Foreground="{DynamicResource Brand}" VerticalAlignment="Center"
                     Margin="12,0,10,0" IsHitTestVisible="False"/>
          <Menu Background="Transparent" VerticalAlignment="Center">
            <MenuItem Header="{Binding [MenuFile], Source={x:Static svc:Loc.Instance}}">
              <!-- Shortcut texts (InputGesture) are set in code so they show ⌘ on macOS and Ctrl elsewhere. -->
              <MenuItem x:Name="menuLoadImage" Header="{Binding [MenuLoadImage], Source={x:Static svc:Loc.Instance}}" Click="OnLoadImage"/>
              <MenuItem x:Name="menuOpenProject" Header="{Binding [MenuOpenProject], Source={x:Static svc:Loc.Instance}}" Click="OnOpenProject"/>
              <Separator/>
              <MenuItem x:Name="menuSave" Header="{Binding [MenuSave], Source={x:Static svc:Loc.Instance}}" Click="OnSaveProject" IsEnabled="{Binding CanSaveProject}"/>
              <MenuItem x:Name="menuSaveAs" Header="{Binding [MenuSaveAs], Source={x:Static svc:Loc.Instance}}" Click="OnSaveAsProject" IsEnabled="{Binding CanSaveProject}"/>
              <Separator/>
              <!-- Both open "Görüntü kalitesi seçiniz" with the quality choices (filled in code) -->
              <MenuItem x:Name="menuExport" Header="{Binding [MenuExport], Source={x:Static svc:Loc.Instance}}" IsEnabled="{Binding CanExport}"/>
              <MenuItem x:Name="menuExportAs" Header="{Binding [MenuExportAs], Source={x:Static svc:Loc.Instance}}" IsEnabled="{Binding CanExport}"/>
              <MenuItem Header="{Binding [MenuScreenshot], Source={x:Static svc:Loc.Instance}}" Click="OnScreenshot" IsEnabled="{Binding ImageLoaded}"/>
              <Separator/>
              <MenuItem Header="{Binding [MenuWatchImages], Source={x:Static svc:Loc.Instance}}" Click="OnToggleWatchImages">
                <MenuItem.Icon>
                  <PathIcon Width="12" Height="12" IsVisible="{Binding WatchNewImages}" Data="M9,16.17 L4.83,12 L3.41,13.41 L9,19 L21,7 L19.59,5.59 Z"/>
                </MenuItem.Icon>
              </MenuItem>
              <Separator/>
              <MenuItem Header="{Binding [MenuDrive], Source={x:Static svc:Loc.Instance}}" IsEnabled="{Binding CanUseDrive}">
                <MenuItem Header="{Binding [MenuDriveSave], Source={x:Static svc:Loc.Instance}}" Click="OnDriveSave"/>
                <MenuItem Header="{Binding [MenuDriveOpen], Source={x:Static svc:Loc.Instance}}" Click="OnDriveOpen"/>
                <Separator/>
                <MenuItem Header="{Binding [MenuDriveSettings], Source={x:Static svc:Loc.Instance}}" Click="OnDriveSettings"/>
              </MenuItem>
            </MenuItem>
            <MenuItem Header="{Binding [MenuEdit], Source={x:Static svc:Loc.Instance}}">
              <MenuItem Header="{Binding [MenuSelectAll], Source={x:Static svc:Loc.Instance}}" Click="OnSelectAll"/>
              <MenuItem Header="{Binding [MenuDeselectAll], Source={x:Static svc:Loc.Instance}}" Click="OnDeselectAll"/>
              <Separator/>
              <MenuItem Header="{Binding [MenuCancelWork], Source={x:Static svc:Loc.Instance}}" Click="OnCancelWork"
                        IsEnabled="{Binding CanCancel}" InputGesture="Escape"/>
            </MenuItem>
            <MenuItem Header="{Binding [MenuView], Source={x:Static svc:Loc.Instance}}">
              <MenuItem x:Name="menuFitToScreen" Header="{Binding [MenuFitToScreen], Source={x:Static svc:Loc.Instance}}" Click="OnResetSize"/>
              <MenuItem Header="{Binding [MenuAdjustPanel], Source={x:Static svc:Loc.Instance}}" Click="OnToggleAdjustPanel">
                <MenuItem.Icon>
                  <PathIcon Width="12" Height="12" IsVisible="{Binding IsAdjustPanelOpen}" Data="M9,16.17 L4.83,12 L3.41,13.41 L9,19 L21,7 L19.59,5.59 Z"/>
                </MenuItem.Icon>
              </MenuItem>
              <MenuItem Header="{Binding [MenuSmoothMouse], Source={x:Static svc:Loc.Instance}}" Click="OnToggleSmoothMouse">
                <MenuItem.Icon>
                  <PathIcon Width="12" Height="12" IsVisible="{Binding SmoothMouse}" Data="M9,16.17 L4.83,12 L3.41,13.41 L9,19 L21,7 L19.59,5.59 Z"/>
                </MenuItem.Icon>
              </MenuItem>
              <!-- Colour theme: five palettes, each dark or light; the user's own choice (ThemeService) -->
              <MenuItem Header="{Binding [MenuTheme], Source={x:Static svc:Loc.Instance}}">
                <MenuItem Header="{Binding [ThemeLapis], Source={x:Static svc:Loc.Instance}}" Click="OnPickTheme" Tag="lapis">
                  <MenuItem.Icon>
                    <PathIcon x:Name="themeCheck_lapis" Width="12" Height="12" IsVisible="False" Data="M9,16.17 L4.83,12 L3.41,13.41 L9,19 L21,7 L19.59,5.59 Z"/>
                  </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="{Binding [ThemePastel], Source={x:Static svc:Loc.Instance}}" Click="OnPickTheme" Tag="pastel">
                  <MenuItem.Icon>
                    <PathIcon x:Name="themeCheck_pastel" Width="12" Height="12" IsVisible="False" Data="M9,16.17 L4.83,12 L3.41,13.41 L9,19 L21,7 L19.59,5.59 Z"/>
                  </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="{Binding [ThemeGraphite], Source={x:Static svc:Loc.Instance}}" Click="OnPickTheme" Tag="grafit">
                  <MenuItem.Icon>
                    <PathIcon x:Name="themeCheck_grafit" Width="12" Height="12" IsVisible="False" Data="M9,16.17 L4.83,12 L3.41,13.41 L9,19 L21,7 L19.59,5.59 Z"/>
                  </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="{Binding [ThemeTravertine], Source={x:Static svc:Loc.Instance}}" Click="OnPickTheme" Tag="traverten">
                  <MenuItem.Icon>
                    <PathIcon x:Name="themeCheck_traverten" Width="12" Height="12" IsVisible="False" Data="M9,16.17 L4.83,12 L3.41,13.41 L9,19 L21,7 L19.59,5.59 Z"/>
                  </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="{Binding [ThemeInk], Source={x:Static svc:Loc.Instance}}" Click="OnPickTheme" Tag="murekkep">
                  <MenuItem.Icon>
                    <PathIcon x:Name="themeCheck_murekkep" Width="12" Height="12" IsVisible="False" Data="M9,16.17 L4.83,12 L3.41,13.41 L9,19 L21,7 L19.59,5.59 Z"/>
                  </MenuItem.Icon>
                </MenuItem>
                <Separator/>
                <MenuItem Header="{Binding [MenuLightTheme], Source={x:Static svc:Loc.Instance}}" Click="OnToggleTheme">
                  <MenuItem.Icon>
                    <PathIcon x:Name="themeCheckLight" Width="12" Height="12" IsVisible="False" Data="M9,16.17 L4.83,12 L3.41,13.41 L9,19 L21,7 L19.59,5.59 Z"/>
                  </MenuItem.Icon>
                </MenuItem>
              </MenuItem>
              <MenuItem Header="{Binding [MenuPropertiesPanel], Source={x:Static svc:Loc.Instance}}" Click="OnTogglePropertiesPanel"
                        InputGesture="F4">
                <MenuItem.Icon>
                  <PathIcon Width="12" Height="12" IsVisible="{Binding IsPropertiesPanelOpen}"
                            Data="M9,16.17 L4.83,12 L3.41,13.41 L9,19 L21,7 L19.59,5.59 Z"/>
                </MenuItem.Icon>
              </MenuItem>
            </MenuItem>
            <MenuItem Header="{Binding [MenuTools], Source={x:Static svc:Loc.Instance}}">
              <MenuItem x:Name="menuMosaicize" Header="{Binding [MenuMosaicize], Source={x:Static svc:Loc.Instance}}" Click="OnRunMosaic"/>
              <Separator/>
              <MenuItem Header="{Binding [MenuPixelEdit], Source={x:Static svc:Loc.Instance}}"
                        Click="OnTogglePixelEdit" IsEnabled="{Binding MosaicDone}">
                <MenuItem.Icon>
                  <PathIcon Width="12" Height="12" IsVisible="{Binding IsPixelEditActive}"
                            Data="M9,16.17 L4.83,12 L3.41,13.41 L9,19 L21,7 L19.59,5.59 Z"/>
                </MenuItem.Icon>
              </MenuItem>
              <Separator/>
              <MenuItem Header="{Binding [MenuShowGrid], Source={x:Static svc:Loc.Instance}}" Click="OnToggleGrid">
                <MenuItem.Icon>
                  <PathIcon Width="12" Height="12" IsVisible="{Binding ShowGrid}"
                            Data="M9,16.17 L4.83,12 L3.41,13.41 L9,19 L21,7 L19.59,5.59 Z"/>
                </MenuItem.Icon>
              </MenuItem>
              <MenuItem x:Name="menuGridColor" Header="{Binding [MenuGridColor], Source={x:Static svc:Loc.Instance}}"/>
              <MenuItem x:Name="menuInterp" Header="{Binding [MenuInterp], Source={x:Static svc:Loc.Instance}}"/>
              <Separator/>
              <MenuItem Header="{Binding [MenuOptimum], Source={x:Static svc:Loc.Instance}}" Click="OnToggleOptimum">
                <MenuItem.Icon>
                  <PathIcon Width="12" Height="12" IsVisible="{Binding UseOptimal}"
                            Data="M9,16.17 L4.83,12 L3.41,13.41 L9,19 L21,7 L19.59,5.59 Z"/>
                </MenuItem.Icon>
              </MenuItem>
              <MenuItem Header="{Binding [MenuStockAware], Source={x:Static svc:Loc.Instance}}" Click="OnToggleStockAware">
                <MenuItem.Icon>
                  <PathIcon Width="12" Height="12" IsVisible="{Binding UseStockAware}"
                            Data="M9,16.17 L4.83,12 L3.41,13.41 L9,19 L21,7 L19.59,5.59 Z"/>
                </MenuItem.Icon>
              </MenuItem>
              <MenuItem Header="{Binding [AdjLiveMos], Source={x:Static svc:Loc.Instance}}" Click="OnToggleLiveMos">
                <MenuItem.Icon>
                  <PathIcon Width="12" Height="12" IsVisible="{Binding LiveMos}" Data="M9,16.17 L4.83,12 L3.41,13.41 L9,19 L21,7 L19.59,5.59 Z"/>
                </MenuItem.Icon>
              </MenuItem>
              <MenuItem Header="{Binding [MenuLiveMosAll], Source={x:Static svc:Loc.Instance}}" Click="OnLiveMosAllColors">
                <MenuItem.Icon>
                  <PathIcon Width="12" Height="12" IsVisible="{Binding LiveMosAllColors}" Data="M9,16.17 L4.83,12 L3.41,13.41 L9,19 L21,7 L19.59,5.59 Z"/>
                </MenuItem.Icon>
              </MenuItem>
              <MenuItem Header="{Binding [MenuLiveMosSelected], Source={x:Static svc:Loc.Instance}}" Click="OnLiveMosSelectedColors">
                <MenuItem.Icon>
                  <PathIcon Width="12" Height="12" IsVisible="{Binding LiveMosSelectedColors}" Data="M9,16.17 L4.83,12 L3.41,13.41 L9,19 L21,7 L19.59,5.59 Z"/>
                </MenuItem.Icon>
              </MenuItem>
              <MenuItem Header="{Binding [MenuStoneCount], Source={x:Static svc:Loc.Instance}}"
                        IsEnabled="{Binding OptimalAvailable}">
                <MenuItem Header="{Binding [MenuStonesSuggested], Source={x:Static svc:Loc.Instance}}"
                          Click="OnStonesSuggested"/>
                <MenuItem Header="{Binding [MenuStonesMore], Source={x:Static svc:Loc.Instance}}"
                          Click="OnStonesMore"/>
                <MenuItem Header="{Binding [MenuStonesLess], Source={x:Static svc:Loc.Instance}}"
                          Click="OnStonesLess"/>
              </MenuItem>
              <Separator/>
              <MenuItem Header="{Binding [MenuStock], Source={x:Static svc:Loc.Instance}}"
                        IsEnabled="{Binding CanUseStock}">
                <MenuItem Header="{Binding [MenuStockOpen], Source={x:Static svc:Loc.Instance}}" Click="OnStockSheet"/>
                <MenuItem Header="{Binding [MenuStockSettings], Source={x:Static svc:Loc.Instance}}" Click="OnStockSettings"/>
                <Separator/>
                <MenuItem Header="{Binding [MenuStockFetch], Source={x:Static svc:Loc.Instance}}">
                  <MenuItem Header="{Binding [MenuStockFetchDisable], Source={x:Static svc:Loc.Instance}}" Click="OnStockFetch"/>
                  <MenuItem Header="{Binding [MenuStockFetchMark], Source={x:Static svc:Loc.Instance}}" Click="OnStockFetchMark"/>
                </MenuItem>
                <MenuItem Header="{Binding [MenuStockCheck], Source={x:Static svc:Loc.Instance}}" Click="OnStockCheck"/>
                <MenuItem Header="{Binding [MenuStockClearOne], Source={x:Static svc:Loc.Instance}}" Click="OnStockClearOne"/>
                <MenuItem Header="{Binding [MenuStockClearAll], Source={x:Static svc:Loc.Instance}}" Click="OnStockClearAll"/>
                <MenuItem Header="{Binding [MenuStockAdd], Source={x:Static svc:Loc.Instance}}" Click="OnStockAdd"/>
              </MenuItem>
            </MenuItem>
            <MenuItem Header="{Binding [MenuHelp], Source={x:Static svc:Loc.Instance}}">
              <MenuItem Header="{Binding [MenuUserGuide], Source={x:Static svc:Loc.Instance}}" Click="OnShowHelp"
                        InputGesture="F1"/>
            </MenuItem>
          </Menu>
        </StackPanel>
      </DockPanel>
      <!-- Name of the open file (the project once saved or opened, otherwise the loaded image), centred on the
           whole window width independently of the menu -->
      <TextBlock Text="{Binding DocumentTitle}" HorizontalAlignment="Center" VerticalAlignment="Center"
                 FontSize="12" Foreground="{DynamicResource FgSecondary}" TextTrimming="CharacterEllipsis"
                 MaxWidth="340" IsHitTestVisible="False"/>
      </Panel>
    </Border>

    <!-- ===== TOOLBAR ===== -->
    <Border DockPanel.Dock="Top" Background="{DynamicResource BgBar}" Padding="4,2"
            BorderBrush="{DynamicResource BrdrMain}" BorderThickness="0,0,0,1">
      <DockPanel>
        <StackPanel Orientation="Horizontal" Spacing="1" DockPanel.Dock="Left">
          <!-- File: Load Image -->
          <Button Classes="icon-btn" ToolTip.Tip="{Binding [TipLoadImage], Source={x:Static svc:Loc.Instance}}" Click="OnLoadImage">
            <PathIcon Width="18" Height="18" Foreground="{DynamicResource FgIcon}"
                      Data="M18,15 L18,18 L15,18 L15,20 L18,20 L18,23 L20,23 L20,20 L23,20 L23,18 L20,18 L20,15 Z M13.3,21 L5,21 C3.9,21 3,20.1 3,19 L3,5 C3,3.9 3.9,3 5,3 L19,3 C20.1,3 21,3.9 21,5 L21,13.3 C20.4,13.1 19.7,13 19,13 C17.9,13 16.8,13.3 15.9,13.9 L14.5,12 L11,16.5 L8.5,13.5 L5,18 L13.1,18 C13,18.3 13,18.7 13,19 C13,19.7 13.1,20.4 13.3,21 Z"/>
          </Button>
          <!-- File: Open Project -->
          <Button Classes="icon-btn" ToolTip.Tip="{Binding [TipOpenProject], Source={x:Static svc:Loc.Instance}}" Click="OnOpenProject">
            <PathIcon Width="18" Height="18" Foreground="{DynamicResource FgIcon}"
                      Data="M19,20 L4,20 C2.89,20 2,19.1 2,18 L2,6 C2,4.89 2.89,4 4,4 L10,4 L12,6 L19,6 C20.1,6 21,6.9 21,8 L4,8 L4,18 L6.14,10 L23.21,10 L20.93,18.5 C20.7,19.37 19.92,20 19,20 Z"/>
          </Button>
          <Border Width="1" Height="24" Background="{DynamicResource BrdrMain}" Margin="3,0"/>
          <!-- File: Save Project -->
          <Button x:Name="saveProjectBtn" Classes="icon-btn" ToolTip.Tip="{Binding [TipSave], Source={x:Static svc:Loc.Instance}}" Click="OnSaveProject"
                  IsEnabled="{Binding CanSaveProject}">
            <Panel>
              <PathIcon x:Name="saveIcon" Width="18" Height="18" Foreground="{DynamicResource FgIcon}"
                        Data="M17,3 L5,3 C3.9,3 3,3.9 3,5 L3,19 C3,20.1 3.9,21 5,21 L19,21 C20.1,21 21,20.1 21,19 L21,7 Z M12,19 C10.34,19 9,17.66 9,16 C9,14.34 10.34,13 12,13 C13.66,13 15,14.34 15,16 C15,17.66 13.66,19 12,19 Z M15,9 L5,9 L5,5 L15,5 Z"/>
              <PathIcon x:Name="saveCheckIcon" Width="18" Height="18" Foreground="{DynamicResource Success}" IsVisible="False"
                        Data="M9,16.17 L4.83,12 L3.41,13.41 L9,19 L21,7 L19.59,5.59 Z"/>
            </Panel>
          </Button>
          <!-- File: Save Project As -->
          <Button Classes="icon-btn" ToolTip.Tip="{Binding [TipSaveAs], Source={x:Static svc:Loc.Instance}}" Click="OnSaveAsProject"
                  IsEnabled="{Binding CanSaveProject}">
            <PathIcon Width="18" Height="18" Foreground="{DynamicResource FgIcon}"
                      Data="M7.3,4.66 L8,4.66 L8,8.66 C8,9.38 8.58,9.97 9.3,9.97 L14.36,9.97 C15.08,9.97 15.66,9.38 15.66,8.66 L15.66,4.66 L16.3,4.66 C16.66,4.66 17,4.8 17.26,5.06 L18.9,6.7 C19.16,6.96 19.3,7.3 19.3,7.66 L19.3,11.06 C18.75,11.18 18.32,11.46 17.86,11.9 L16,13.86 C15.92,12.98 15.2,12.3 14.32,12.3 L9.66,12.3 C8.74,12.3 8,13.04 8,13.96 L8,16.64 L13.2,16.64 L12.12,17.72 C11.66,18.18 11.48,18.6 11.2,19.34 L7.3,19.34 C5.84,19.34 4.66,18.16 4.66,16.7 L4.66,7.3 C4.66,5.84 5.84,4.66 7.3,4.66 Z M12.32,5 L13.3,5 C13.68,5 13.98,5.3 13.98,5.66 L13.98,8.32 C13.98,8.7 13.68,9 13.3,9 L12.32,9 C11.96,9 11.66,8.7 11.66,8.32 L11.66,5.66 C11.66,5.3 11.96,5 12.32,5 Z M17.7,14.06 L19.58,15.94 L14.7,20.82 L12.6,21.6 C12.2,21.72 11.9,21.4 12.04,21.02 L12.82,18.94 Z M18.24,13.56 L19.1,12.7 C19.6,12.2 20.4,12.2 20.9,12.7 L21,12.8 C21.5,13.3 21.5,14.1 21,14.6 L20.1,15.42 Z"/>
          </Button>
          <Border Width="1" Height="24" Background="{DynamicResource BrdrMain}" Margin="3,0"/>
          <!-- Action: Mos -->
          <Button Classes="mos-btn" Click="OnRunMosaic" IsEnabled="{Binding CanRunMosaic}"
                  ToolTip.Tip="{Binding [TipMosaicize], Source={x:Static svc:Loc.Instance}}">
            <StackPanel Orientation="Horizontal" Spacing="5">
              <Panel Width="16" Height="16">
                <PathIcon Width="16" Height="16" Foreground="{DynamicResource OnAccent}"
                          IsVisible="{Binding !IsProcessing}"
                          Data="M2,2 L2,10 C2,10.5 2.5,11 3,11 L9,11 C9.5,11 10,10.5 10,10 L10,2 C10,1.5 9.5,1 9,1 L3,1 C2.5,1 2,1.5 2,2 Z M14,2 L14,10 C14,10.5 14.5,11 15,11 L21,11 C21.5,11 22,10.5 22,10 L22,2 C22,1.5 21.5,1 21,1 L15,1 C14.5,1 14,1.5 14,2 Z M2,14 L2,22 C2,22.5 2.5,23 3,23 L9,23 C9.5,23 10,22.5 10,22 L10,14 C10,13.5 9.5,13 9,13 L3,13 C2.5,13 2,13.5 2,14 Z M14,14 L14,22 C14,22.5 14.5,23 15,23 L21,23 C21.5,23 22,22.5 22,22 L22,14 C22,13.5 21.5,13 21,13 L15,13 C14.5,13 14,13.5 14,14 Z"/>
                <Grid x:Name="mosAnimGrid" IsVisible="{Binding IsProcessing}"
                      ColumnDefinitions="7,2,7" RowDefinitions="7,2,7">
                  <Border x:Name="mosQ0" Grid.Row="0" Grid.Column="0"
                          Background="{DynamicResource OnAccent}" CornerRadius="1.5" Opacity="0.15"/>
                  <Border x:Name="mosQ1" Grid.Row="0" Grid.Column="2"
                          Background="{DynamicResource OnAccent}" CornerRadius="1.5" Opacity="0.15"/>
                  <Border x:Name="mosQ2" Grid.Row="2" Grid.Column="2"
                          Background="{DynamicResource OnAccent}" CornerRadius="1.5" Opacity="0.15"/>
                  <Border x:Name="mosQ3" Grid.Row="2" Grid.Column="0"
                          Background="{DynamicResource OnAccent}" CornerRadius="1.5" Opacity="0.15"/>
                </Grid>
              </Panel>
              <TextBlock Text="Mos" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
          <Border Width="1" Height="24" Background="{DynamicResource BrdrMain}" Margin="3,0"/>
          <!-- Pixel Edit Toggle -->
          <Button Classes="icon-btn" Click="OnTogglePixelEdit"
                  IsEnabled="{Binding MosaicDone}"
                  ToolTip.Tip="{Binding [TipPixelEdit], Source={x:Static svc:Loc.Instance}}">
            <Panel>
              <PathIcon Width="18" Height="18" Foreground="{DynamicResource FgIcon}"
                        IsVisible="{Binding !IsPixelEditActive}"
                        Data="M3,17.25 L3,21 L6.75,21 L17.81,9.94 L14.06,6.19 Z M20.71,7.04 C21.1,6.65 21.1,6.02 20.71,5.63 L18.37,3.29 C17.98,2.9 17.35,2.9 16.96,3.29 L15.13,5.12 L18.88,8.87 Z"/>
              <PathIcon Width="18" Height="18" Foreground="{DynamicResource EditMode}"
                        IsVisible="{Binding IsPixelEditActive}"
                        Data="M3,17.25 L3,21 L6.75,21 L17.81,9.94 L14.06,6.19 Z M20.71,7.04 C21.1,6.65 21.1,6.02 20.71,5.63 L18.37,3.29 C17.98,2.9 17.35,2.9 16.96,3.29 L15.13,5.12 L18.88,8.87 Z"/>
            </Panel>
          </Button>
          <!-- sourcePix / targetPix indicator -->
          <Border Background="{DynamicResource BgCard}" CornerRadius="4" Padding="6,2" Margin="2,0"
                  BorderBrush="{DynamicResource BrdrTer}" BorderThickness="1"
                  IsVisible="{Binding IsPixelEditActive}">
            <StackPanel Orientation="Horizontal" Spacing="4">
              <Border Width="8" Height="8" CornerRadius="4"
                      IsVisible="{Binding IsSourcePixelMode}">
                <Border.Background>
                  <SolidColorBrush Color="{DynamicResource EditMode}"/>
                </Border.Background>
              </Border>
              <TextBlock Text="source" FontWeight="Bold" FontSize="10"
                         IsVisible="{Binding IsSourcePixelMode}" Foreground="{DynamicResource EditMode}"/>
              <TextBlock Text="source" FontWeight="Bold" FontSize="10"
                         IsVisible="{Binding !IsSourcePixelMode}" Foreground="{DynamicResource FgDisabled}"/>
              <PathIcon Width="10" Height="10" Foreground="{DynamicResource FgMuted}"
                        Data="M8,4 L12,8 L8,12" Margin="0,1,0,0"/>
              <Border Width="8" Height="8" CornerRadius="4"
                      IsVisible="{Binding IsTargetPixelMode}">
                <Border.Background>
                  <SolidColorBrush Color="{DynamicResource EditMode}"/>
                </Border.Background>
              </Border>
              <TextBlock Text="target" FontWeight="Bold" FontSize="10"
                         IsVisible="{Binding IsTargetPixelMode}" Foreground="{DynamicResource EditMode}"/>
              <TextBlock Text="target" FontWeight="Bold" FontSize="10"
                         IsVisible="{Binding !IsTargetPixelMode}" Foreground="{DynamicResource FgDisabled}"/>
            </StackPanel>
          </Border>
          <Border Width="1" Height="24" Background="{DynamicResource BrdrMain}" Margin="3,0"/>
          <!-- Grid -->
          <Button Classes="icon-btn"
                  ToolTip.Tip="{Binding [TipGrid], Source={x:Static svc:Loc.Instance}}">
            <Button.Flyout>
              <Flyout Placement="BottomEdgeAlignedLeft" ShowMode="TransientWithDismissOnPointerMoveAway">
                <Border Background="{DynamicResource BgPanel}" CornerRadius="6" Padding="8,6"
                        BorderBrush="{DynamicResource BrdrSec}" BorderThickness="1" MaxWidth="220">
                  <StackPanel Spacing="6">
                    <Button Click="OnToggleGrid" Padding="6,4"
                            Background="Transparent" BorderThickness="0" CornerRadius="4" Cursor="Hand">
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <Panel Width="16" Height="16">
                          <PathIcon Width="16" Height="16" IsVisible="{Binding ShowGrid}" Foreground="{DynamicResource AccentText}"
                                    Data="M2,2 H7 V7 H2 Z M9,2 H15 V7 H9 Z M17,2 H22 V7 H17 Z M2,9 H7 V15 H2 Z M9,9 H15 V15 H9 Z M17,9 H22 V15 H17 Z M2,17 H7 V22 H2 Z M9,17 H15 V22 H9 Z M17,17 H22 V22 H17 Z"/>
                          <PathIcon Width="16" Height="16" IsVisible="{Binding !ShowGrid}" Foreground="{DynamicResource FgMuted}"
                                    Data="M2,2 H7 V7 H2 Z M9,2 H15 V7 H9 Z M17,2 H22 V7 H17 Z M2,9 H7 V15 H2 Z M9,9 H15 V15 H9 Z M17,9 H22 V15 H17 Z M2,17 H7 V22 H2 Z M9,17 H15 V22 H9 Z M17,17 H22 V22 H17 Z"/>
                        </Panel>
                        <TextBlock Text="{Binding [LblGrid], Source={x:Static svc:Loc.Instance}}"
                                   FontSize="11" Foreground="{DynamicResource FgPrimary}" VerticalAlignment="Center"/>
                        <TextBlock FontSize="10" VerticalAlignment="Center"
                                   IsVisible="{Binding ShowGrid}" Foreground="{DynamicResource AccentText}" Text="ON"/>
                        <TextBlock FontSize="10" VerticalAlignment="Center"
                                   IsVisible="{Binding !ShowGrid}" Foreground="{DynamicResource FgMuted}" Text="OFF"/>
                      </StackPanel>
                    </Button>
                    <Border Height="1" Background="{DynamicResource BrdrMain}"/>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <TextBlock Text="{Binding [LblGridColor], Source={x:Static svc:Loc.Instance}}" FontSize="11" FontWeight="SemiBold"
                                 Foreground="{DynamicResource FgMuted}" VerticalAlignment="Center" Margin="2,0,0,0"/>
                      <Border Width="16" Height="16" CornerRadius="3"
                              BorderThickness="1.5" BorderBrush="{DynamicResource BrdrTer}">
                        <Border.Background>
                          <SolidColorBrush Color="{Binding GridColor}"/>
                        </Border.Background>
                      </Border>
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding GridColorPresets}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Button Margin="1" Padding="0" BorderThickness="0"
                                  Background="Transparent" Cursor="Hand"
                                  Click="OnGridMainColorPick" Tag="{Binding}">
                            <Border Width="22" Height="22" CornerRadius="3"
                                    BorderThickness="1.5" BorderBrush="{DynamicResource BrdrTer}">
                              <Border.Background>
                                <SolidColorBrush Color="{Binding}"/>
                              </Border.Background>
                            </Border>
                          </Button>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Border Height="1" Background="{DynamicResource BrdrMain}" Margin="0,2"
                            IsVisible="{Binding GridColorShades.Length}"/>
                    <ItemsControl ItemsSource="{Binding GridColorShades}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Button Margin="1" Padding="0" BorderThickness="0"
                                  Background="Transparent" Cursor="Hand"
                                  Click="OnGridColorPick" Tag="{Binding}">
                            <Border Width="26" Height="26" CornerRadius="3"
                                    BorderThickness="1.5" BorderBrush="{DynamicResource BrdrTer}">
                              <Border.Background>
                                <SolidColorBrush Color="{Binding}"/>
                              </Border.Background>
                            </Border>
                          </Button>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </Border>
              </Flyout>
            </Button.Flyout>
            <Panel>
              <PathIcon Width="16" Height="16" IsVisible="{Binding ShowGrid}" Foreground="{DynamicResource AccentText}"
                        Data="M2,2 H7 V7 H2 Z M9,2 H15 V7 H9 Z M17,2 H22 V7 H17 Z M2,9 H7 V15 H2 Z M9,9 H15 V15 H9 Z M17,9 H22 V15 H17 Z M2,17 H7 V22 H2 Z M9,17 H15 V22 H9 Z M17,17 H22 V22 H17 Z"/>
              <PathIcon Width="16" Height="16" IsVisible="{Binding !ShowGrid}" Foreground="{DynamicResource FgMuted}"
                        Data="M2,2 H7 V7 H2 Z M9,2 H15 V7 H9 Z M17,2 H22 V7 H17 Z M2,9 H7 V15 H2 Z M9,9 H15 V15 H9 Z M17,9 H22 V15 H17 Z M2,17 H7 V22 H2 Z M9,17 H15 V22 H9 Z M17,17 H22 V22 H17 Z"/>
            </Panel>
          </Button>
          <!-- Interp -->
          <Button Padding="4,2" Height="32" Background="Transparent"
                  BorderThickness="0" CornerRadius="4" Cursor="Hand"
                  ToolTip.Tip="{Binding [TipInterp], Source={x:Static svc:Loc.Instance}}">
            <Button.Flyout>
              <Flyout Placement="BottomEdgeAlignedLeft" ShowMode="TransientWithDismissOnPointerMoveAway">
                <Border Background="{DynamicResource BgPanel}" CornerRadius="6" Padding="4"
                        BorderBrush="{DynamicResource BrdrSec}" BorderThickness="1" MinWidth="120">
                  <ItemsControl ItemsSource="{Binding InterpolationMethods}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Button Padding="8,5" Background="Transparent"
                                BorderThickness="0" CornerRadius="4" Cursor="Hand"
                                Click="OnSelectInterpolation" Tag="{Binding}"
                                HorizontalContentAlignment="Left">
                          <TextBlock Text="{Binding}" FontSize="11" Foreground="{DynamicResource FgPrimary}"/>
                        </Button>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </Border>
              </Flyout>
            </Button.Flyout>
            <StackPanel Orientation="Horizontal" Spacing="3">
              <PathIcon Width="14" Height="14" Foreground="{DynamicResource FgIcon}"
                        Data="M3,20 C6,20 8,4 12,4 C16,4 14,16 18,16 C20,16 21,12 21,12"/>
              <TextBlock Text="{Binding SelectedInterpolation}" Foreground="{DynamicResource FgSecondary}"
                         FontSize="10" VerticalAlignment="Center"
                         FontFamily="{StaticResource MonoFont}"/>
              <PathIcon Width="6" Height="6" Foreground="{DynamicResource FgMuted}" VerticalAlignment="Center"
                        Data="M2,3 L6,7 L10,3"/>
            </StackPanel>
          </Button>
          <Border Width="1" Height="24" Background="{DynamicResource BrdrMain}" Margin="3,0"/>
          <!-- Google Drive: save the project to the Drive folder; the arrow also opens from Drive and holds the
               folder settings (DriveService, Apps Script) -->
          <Button Classes="icon-btn" Click="OnDriveSave" IsEnabled="{Binding CanUseDrive}"
                  ToolTip.Tip="{Binding [TipDrive], Source={x:Static svc:Loc.Instance}}">
            <Viewbox Width="18" Height="18">
              <Canvas Width="24" Height="24">
                <Path Fill="#4285F4" Data="M4.9,22.4 L9.3,14.8 L23.5,14.8 L19.1,22.4 Z"/>
                <Path Fill="#0F9D58" Data="M7.6,2.5 L12,10.1 L4.9,22.4 L0.5,14.8 Z"/>
                <Path Fill="#FFC107" Data="M7.6,2.5 L16.4,2.5 L23.5,14.8 L14.7,14.8 Z"/>
              </Canvas>
            </Viewbox>
          </Button>
          <Button Classes="icon-btn" Width="14" Padding="1" IsEnabled="{Binding CanUseDrive}"
                  ToolTip.Tip="{Binding [TipDrive], Source={x:Static svc:Loc.Instance}}">
            <Button.Flyout>
              <Flyout Placement="BottomEdgeAlignedLeft" ShowMode="TransientWithDismissOnPointerMoveAway">
                <Border Background="{DynamicResource BgPanel}" CornerRadius="6" Padding="4"
                        BorderBrush="{DynamicResource BrdrSec}" BorderThickness="1">
                  <StackPanel Spacing="2">
                    <Button Click="OnDriveSave" Padding="8,5" MinWidth="200"
                            Background="Transparent" BorderThickness="0" CornerRadius="4" Cursor="Hand"
                            HorizontalContentAlignment="Left">
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <PathIcon Width="14" Height="14" Foreground="#4285F4" Data="M9,16 L15,16 L15,10 L19,10 L12,3 L5,10 L9,10 Z M5,18 L19,18 L19,20 L5,20 Z"/>
                        <TextBlock Text="{Binding [MenuDriveSave], Source={x:Static svc:Loc.Instance}}" FontSize="11" Foreground="{DynamicResource FgPrimary}"/>
                      </StackPanel>
                    </Button>
                    <Button Click="OnDriveOpen" Padding="8,5" MinWidth="200"
                            Background="Transparent" BorderThickness="0" CornerRadius="4" Cursor="Hand"
                            HorizontalContentAlignment="Left">
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <PathIcon Width="14" Height="14" Foreground="#0F9D58" Data="M20,6 L12,6 L10,4 L4,4 C2.9,4 2,4.9 2,6 L2,18 C2,19.1 2.9,20 4,20 L20,20 C21.1,20 22,19.1 22,18 L22,8 C22,6.9 21.1,6 20,6 Z"/>
                        <TextBlock Text="{Binding [MenuDriveOpen], Source={x:Static svc:Loc.Instance}}" FontSize="11" Foreground="{DynamicResource FgPrimary}"/>
                      </StackPanel>
                    </Button>
                    <Button Click="OnDriveSettings" Padding="8,5" MinWidth="200"
                            Background="Transparent" BorderThickness="0" CornerRadius="4" Cursor="Hand"
                            HorizontalContentAlignment="Left">
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <PathIcon Width="14" Height="14" Foreground="{DynamicResource FgIcon}" Data="M19.14,12.94 C19.18,12.64 19.2,12.33 19.2,12 C19.2,11.68 19.18,11.36 19.13,11.06 L21.16,9.48 C21.34,9.34 21.39,9.07 21.28,8.87 L19.36,5.55 C19.24,5.33 18.99,5.26 18.77,5.33 L16.38,6.29 C15.88,5.91 15.35,5.59 14.76,5.35 L14.4,2.81 C14.36,2.57 14.16,2.4 13.92,2.4 L10.08,2.4 C9.84,2.4 9.65,2.57 9.61,2.81 L9.25,5.35 C8.66,5.59 8.12,5.92 7.63,6.29 L5.24,5.33 C5.02,5.25 4.77,5.33 4.65,5.55 L2.74,8.87 C2.62,9.08 2.66,9.34 2.86,9.48 L4.89,11.06 C4.84,11.36 4.8,11.69 4.8,12 C4.8,12.31 4.82,12.64 4.87,12.94 L2.84,14.52 C2.66,14.66 2.61,14.93 2.72,15.13 L4.64,18.45 C4.76,18.67 5.01,18.74 5.23,18.67 L7.62,17.71 C8.12,18.09 8.65,18.41 9.24,18.65 L9.6,21.19 C9.65,21.43 9.84,21.6 10.08,21.6 L13.92,21.6 C14.16,21.6 14.36,21.43 14.39,21.19 L14.75,18.65 C15.34,18.41 15.88,18.09 16.37,17.71 L18.76,18.67 C18.98,18.75 19.23,18.67 19.35,18.45 L21.27,15.13 C21.39,14.91 21.34,14.66 21.15,14.52 Z M12,15.6 C10.02,15.6 8.4,13.98 8.4,12 C8.4,10.02 10.02,8.4 12,8.4 C13.98,8.4 15.6,10.02 15.6,12 C15.6,13.98 13.98,15.6 12,15.6 Z"/>
                        <TextBlock Text="{Binding [MenuDriveSettings], Source={x:Static svc:Loc.Instance}}" FontSize="11" Foreground="{DynamicResource FgPrimary}"/>
                      </StackPanel>
                    </Button>
                  </StackPanel>
                </Border>
              </Flyout>
            </Button.Flyout>
            <PathIcon Width="8" Height="8" Foreground="{DynamicResource FgIcon}" Data="M2,4 L6,8 L10,4"/>
          </Button>
          <!-- Google Sheet stock: open sheet, fetch, check, clear, add -->
          <Button Classes="icon-btn" Click="OnStockSheet" IsEnabled="{Binding CanUseStock}"
                  ToolTip.Tip="{Binding [TipStockSheet], Source={x:Static svc:Loc.Instance}}">
            <Button.ContextMenu>
              <ContextMenu>
                <MenuItem Header="{Binding [MenuStockSettings], Source={x:Static svc:Loc.Instance}}" Click="OnStockSettings"/>
              </ContextMenu>
            </Button.ContextMenu>
            <Viewbox Width="18" Height="18">
              <Canvas Width="24" Height="24">
                <Path Fill="#0F9D58"
                      Data="M6,2 L14.5,2 L20,7.5 L20,20.5 C20,21.33 19.33,22 18.5,22 L6,22 C5.17,22 4.5,21.33 4.5,20.5 L4.5,3.5 C4.5,2.67 5.17,2 6,2 Z"/>
                <Path Fill="#87CEAC" Data="M14.5,2 L20,7.5 L14.5,7.5 Z"/>
                <Path Fill="#FFFFFF"
                      Data="M7.5,10.5 L16.5,10.5 L16.5,18 L7.5,18 Z M8.5,11.5 L8.5,12.83 L11.5,12.83 L11.5,11.5 Z M12.5,11.5 L12.5,12.83 L15.5,12.83 L15.5,11.5 Z M8.5,13.58 L8.5,14.92 L11.5,14.92 L11.5,13.58 Z M12.5,13.58 L12.5,14.92 L15.5,14.92 L15.5,13.58 Z M8.5,15.67 L8.5,17 L11.5,17 L11.5,15.67 Z M12.5,15.67 L12.5,17 L15.5,17 L15.5,15.67 Z"/>
              </Canvas>
            </Viewbox>
          </Button>
          <!-- Sheet options: open the sheet / stock sheet settings -->
          <Button Classes="icon-btn" Width="14" Padding="1" IsEnabled="{Binding CanUseStock}"
                  ToolTip.Tip="{Binding [TipStockSheetMenu], Source={x:Static svc:Loc.Instance}}">
            <Button.Flyout>
              <Flyout Placement="BottomEdgeAlignedLeft" ShowMode="TransientWithDismissOnPointerMoveAway">
                <Border Background="{DynamicResource BgPanel}" CornerRadius="6" Padding="4"
                        BorderBrush="{DynamicResource BrdrSec}" BorderThickness="1">
                  <StackPanel Spacing="2">
                    <Button Click="OnStockSheet" Padding="8,5" MinWidth="180"
                            Background="Transparent" BorderThickness="0" CornerRadius="4" Cursor="Hand"
                            HorizontalContentAlignment="Left">
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <PathIcon Width="14" Height="14" Foreground="#0F9D58"
                                  Data="M6,2 L14.5,2 L20,7.5 L20,20.5 C20,21.33 19.33,22 18.5,22 L6,22 C5.17,22 4.5,21.33 4.5,20.5 L4.5,3.5 C4.5,2.67 5.17,2 6,2 Z"/>
                        <TextBlock Text="{Binding [MenuStockOpen], Source={x:Static svc:Loc.Instance}}" FontSize="11" Foreground="{DynamicResource FgPrimary}"/>
                      </StackPanel>
                    </Button>
                    <Button Click="OnStockSettings" Padding="8,5" MinWidth="180"
                            Background="Transparent" BorderThickness="0" CornerRadius="4" Cursor="Hand"
                            HorizontalContentAlignment="Left">
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <PathIcon Width="14" Height="14" Foreground="{DynamicResource FgIcon}"
                                  Data="M19.14,12.94 C19.18,12.64 19.2,12.33 19.2,12 C19.2,11.68 19.18,11.36 19.13,11.06 L21.16,9.48 C21.34,9.34 21.39,9.07 21.28,8.87 L19.36,5.55 C19.24,5.33 18.99,5.26 18.77,5.33 L16.38,6.29 C15.88,5.91 15.35,5.59 14.76,5.35 L14.4,2.81 C14.36,2.57 14.16,2.4 13.92,2.4 L10.08,2.4 C9.84,2.4 9.65,2.57 9.61,2.81 L9.25,5.35 C8.66,5.59 8.12,5.92 7.63,6.29 L5.24,5.33 C5.02,5.25 4.77,5.33 4.65,5.55 L2.74,8.87 C2.62,9.08 2.66,9.34 2.86,9.48 L4.89,11.06 C4.84,11.36 4.8,11.69 4.8,12 C4.8,12.31 4.82,12.64 4.87,12.94 L2.84,14.52 C2.66,14.66 2.61,14.93 2.72,15.13 L4.64,18.45 C4.76,18.67 5.01,18.74 5.23,18.67 L7.62,17.71 C8.12,18.09 8.65,18.41 9.24,18.65 L9.6,21.19 C9.65,21.43 9.84,21.6 10.08,21.6 L13.92,21.6 C14.16,21.6 14.36,21.43 14.39,21.19 L14.75,18.65 C15.34,18.41 15.88,18.09 16.37,17.71 L18.76,18.67 C18.98,18.75 19.23,18.67 19.35,18.45 L21.27,15.13 C21.39,14.91 21.34,14.66 21.15,14.52 Z M12,15.6 C10.02,15.6 8.4,13.98 8.4,12 C8.4,10.02 10.02,8.4 12,8.4 C13.98,8.4 15.6,10.02 15.6,12 C15.6,13.98 13.98,15.6 12,15.6 Z"/>
                        <TextBlock Text="{Binding [MenuStockSettings], Source={x:Static svc:Loc.Instance}}" FontSize="11" Foreground="{DynamicResource FgPrimary}"/>
                      </StackPanel>
                    </Button>
                  </StackPanel>
                </Border>
              </Flyout>
            </Button.Flyout>
            <PathIcon Width="8" Height="8" Foreground="{DynamicResource FgIcon}" Data="M2,4 L6,8 L10,4"/>
          </Button>
          <Button Classes="icon-btn" Click="OnStockFetch" IsEnabled="{Binding CanUseStock}"
                  ToolTip.Tip="{Binding [TipStockFetch], Source={x:Static svc:Loc.Instance}}">
            <Viewbox Width="18" Height="18">
              <Canvas Width="24" Height="24">
                <!-- Warehouse with stacked boxes -->
                <Path Stroke="{DynamicResource FgIcon}" StrokeThickness="1.6"
                      StrokeLineCap="Round" StrokeJoin="Round"
                      Data="M9,10 L15.5,5 L22,10 M10,9.5 L10,21.5 M21,9.5 L21,21.5 M11.5,12 L19.5,12 L19.5,21 L11.5,21 Z M15.5,12 L15.5,21 M11.5,16.5 L19.5,16.5"/>
                <!-- Arrow bringing a box in -->
                <Path Stroke="{DynamicResource FgIcon}" StrokeThickness="1.6"
                      StrokeLineCap="Round" StrokeJoin="Round"
                      Data="M5.5,2.5 L5.5,10 M3.5,8 L5.5,10.2 L7.5,8 M2.5,12.5 L8.5,12.5 L8.5,21 L2.5,21 Z M2.5,16.75 L8.5,16.75"/>
              </Canvas>
            </Viewbox>
          </Button>
          <!-- Fetch options: disable stones without stock / only mark them red -->
          <Button Classes="icon-btn" Width="14" Padding="1" IsEnabled="{Binding CanUseStock}"
                  ToolTip.Tip="{Binding [TipStockFetchMenu], Source={x:Static svc:Loc.Instance}}">
            <Button.Flyout>
              <Flyout Placement="BottomEdgeAlignedLeft" ShowMode="TransientWithDismissOnPointerMoveAway">
                <Border Background="{DynamicResource BgPanel}" CornerRadius="6" Padding="4"
                        BorderBrush="{DynamicResource BrdrSec}" BorderThickness="1">
                  <StackPanel Spacing="2">
                    <Button Click="OnStockFetch" Padding="8,5" MinWidth="230"
                            Background="Transparent" BorderThickness="0" CornerRadius="4" Cursor="Hand"
                            HorizontalContentAlignment="Left">
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <PathIcon Width="14" Height="14" Foreground="{DynamicResource FgIcon}"
                                  Data="M19,6.41 L17.59,5 L12,10.59 L6.41,5 L5,6.41 L10.59,12 L5,17.59 L6.41,19 L12,13.41 L17.59,19 L19,17.59 L13.41,12 Z"/>
                        <TextBlock Text="{Binding [MenuStockFetchDisable], Source={x:Static svc:Loc.Instance}}" FontSize="11" Foreground="{DynamicResource FgPrimary}"/>
                      </StackPanel>
                    </Button>
                    <Button Click="OnStockFetchMark" Padding="8,5" MinWidth="230"
                            Background="Transparent" BorderThickness="0" CornerRadius="4" Cursor="Hand"
                            HorizontalContentAlignment="Left">
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <Panel Width="14" Height="14">
                          <Ellipse Width="8" Height="8" Fill="{DynamicResource Danger}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Panel>
                        <TextBlock Text="{Binding [MenuStockFetchMark], Source={x:Static svc:Loc.Instance}}" FontSize="11" Foreground="{DynamicResource FgPrimary}"/>
                      </StackPanel>
                    </Button>
                  </StackPanel>
                </Border>
              </Flyout>
            </Button.Flyout>
            <PathIcon Width="8" Height="8" Foreground="{DynamicResource FgIcon}" Data="M2,4 L6,8 L10,4"/>
          </Button>
          <Button Classes="icon-btn" Click="OnStockCheck" IsEnabled="{Binding CanUseStock}"
                  ToolTip.Tip="{Binding [TipStockCheck], Source={x:Static svc:Loc.Instance}}">
            <Viewbox Width="18" Height="18">
              <Canvas Width="24" Height="24">
                <!-- Clipboard with a checklist -->
                <Path Stroke="{DynamicResource FgIcon}" StrokeThickness="1.6"
                      StrokeLineCap="Round" StrokeJoin="Round"
                      Data="M8,4 L6.5,4 C5.67,4 5,4.67 5,5.5 L5,15 M11,21 L15.5,21 C16.33,21 17,20.33 17,19.5 L17,16 M17,10 L17,5.5 C17,4.67 16.33,4 15.5,4 L14,4 M8.5,2.5 L13.5,2.5 L13.5,5.5 L8.5,5.5 Z M7.5,9 L8.5,9 M10.5,9 L14,9 M7.5,12.5 L8.5,12.5 M10.5,12.5 L13,12.5"/>
                <!-- Pencil -->
                <Path Fill="{DynamicResource FgIcon}"
                      Data="M20.2,8.6 L22,10.4 L15.6,16.8 L13.3,17.7 L14.2,15.4 Z"/>
                <!-- Stone (cube) -->
                <Path Fill="{DynamicResource FgIcon}"
                      Data="M2,17.2 L5.5,15.4 L9,17.2 L5.5,19 Z M2,17.9 L5.2,19.55 L5.2,23 L2,21.35 Z M5.8,19.55 L9,17.9 L9,21.35 L5.8,23 Z"/>
              </Canvas>
            </Viewbox>
          </Button>
          <Button Classes="icon-btn" Click="OnStockClearOne" IsEnabled="{Binding CanUseStock}"
                  ToolTip.Tip="{Binding [TipStockClear], Source={x:Static svc:Loc.Instance}}">
            <Button.ContextMenu>
              <ContextMenu>
                <MenuItem Header="{Binding [MenuStockClearOne], Source={x:Static svc:Loc.Instance}}" Click="OnStockClearOne"/>
                <MenuItem Header="{Binding [MenuStockClearAll], Source={x:Static svc:Loc.Instance}}" Click="OnStockClearAll"/>
              </ContextMenu>
            </Button.ContextMenu>
            <Viewbox Width="18" Height="18">
              <Canvas Width="24" Height="24">
                <!-- Cube -->
                <Path Stroke="{DynamicResource FgIcon}" StrokeThickness="1.6"
                      StrokeLineCap="Round" StrokeJoin="Round"
                      Data="M2.5,10 L10,6.25 L17.5,10 L10,13.75 Z M2.5,10 L2.5,18.25 L10,22 L17.5,18.25 L17.5,10 M10,13.75 L10,22"/>
                <!-- Badge with − -->
                <Path Fill="{DynamicResource FgIcon}"
                      Data="M18,1.25 A4.75,4.75 0 1 1 18,10.75 A4.75,4.75 0 1 1 18,1.25 Z M15.5,5.25 L20.5,5.25 L20.5,6.75 L15.5,6.75 Z"/>
              </Canvas>
            </Viewbox>
          </Button>
          <Button Classes="icon-btn" Click="OnStockAdd" IsEnabled="{Binding CanUseStock}"
                  ToolTip.Tip="{Binding [TipStockAdd], Source={x:Static svc:Loc.Instance}}">
            <Viewbox Width="18" Height="18">
              <Canvas Width="24" Height="24">
                <!-- Cube -->
                <Path Stroke="{DynamicResource FgIcon}" StrokeThickness="1.6"
                      StrokeLineCap="Round" StrokeJoin="Round"
                      Data="M2.5,10 L10,6.25 L17.5,10 L10,13.75 Z M2.5,10 L2.5,18.25 L10,22 L17.5,18.25 L17.5,10 M10,13.75 L10,22"/>
                <!-- Badge with + -->
                <Path Fill="{DynamicResource FgIcon}"
                      Data="M18,1.25 A4.75,4.75 0 1 1 18,10.75 A4.75,4.75 0 1 1 18,1.25 Z M17.25,3.5 L18.75,3.5 L18.75,5.25 L20.5,5.25 L20.5,6.75 L18.75,6.75 L18.75,8.5 L17.25,8.5 L17.25,6.75 L15.5,6.75 L15.5,5.25 L17.25,5.25 Z"/>
              </Canvas>
            </Viewbox>
          </Button>
          <Border Width="1" Height="24" Background="{DynamicResource BrdrMain}" Margin="3,0"/>
          <!-- Stock-aware: after Optimum, keep every stone within its "Bizdeki (kg)" stock -->
          <CheckBox IsChecked="{Binding UseStockAware}" VerticalAlignment="Center" Margin="4,0,0,0"
                    ToolTip.Tip="{Binding StockAwareTip}">
            <TextBlock Text="{Binding [LblStockAware], Source={x:Static svc:Loc.Instance}}" FontSize="11"
                       Foreground="{DynamicResource FgSecondary}" VerticalAlignment="Center"/>
          </CheckBox>
          <!-- Optimum stone count -->
          <CheckBox IsChecked="{Binding UseOptimal}" VerticalAlignment="Center" Margin="14,0,0,0"
                    ToolTip.Tip="{Binding [TipOptimum], Source={x:Static svc:Loc.Instance}}">
            <TextBlock Text="{Binding [LblOptimum], Source={x:Static svc:Loc.Instance}}" FontSize="11"
                       Foreground="{DynamicResource FgSecondary}" VerticalAlignment="Center"/>
          </CheckBox>
          <!-- The stone count of an Optimum Mos, while Optimum is ticked: the Görsel Ayarları slider with the value
               above its triangle; right-click goes back to the suggested count -->
          <ctrl:AdjustSlider Minimum="1" Maximum="{Binding OptimalKMax}" Value="{Binding OptimalK}"
                             DefaultValue="{Binding OptimalKSuggested}" ShowValue="True"
                             EmptyTrackBrush="{DynamicResource BrdrTer}" ThumbBrush="{DynamicResource FgPrimary}"
                             ThumbBorderBrush="{DynamicResource BgInput}" ValueBrush="{DynamicResource FgPrimary}"
                             Width="160" Margin="4,0,0,0" VerticalAlignment="Center"
                             ToolTip.Tip="{Binding [TipOptimalSlider], Source={x:Static svc:Loc.Instance}}">
            <ctrl:AdjustSlider.IsVisible>
              <MultiBinding Converter="{x:Static BoolConverters.And}">
                <Binding Path="UseOptimal"/>
                <Binding Path="OptimalAvailable"/>
              </MultiBinding>
            </ctrl:AdjustSlider.IsVisible>
          </ctrl:AdjustSlider>
        </StackPanel>
        <!-- Right: Export -->
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="1"
                    HorizontalAlignment="Right">
          <!-- Screenshot: what the image area shows right now, saved as PNG in mosairEXPORT -->
          <Button Classes="icon-btn" Click="OnScreenshot" IsEnabled="{Binding ImageLoaded}"
                  ToolTip.Tip="{Binding [TipScreenshot], Source={x:Static svc:Loc.Instance}}">
            <PathIcon Width="18" Height="18" Foreground="{DynamicResource FgIcon}"
                      Data="M9,3 L7.17,5 L4,5 C2.9,5 2,5.9 2,7 L2,19 C2,20.1 2.9,21 4,21 L20,21 C21.1,21 22,20.1 22,19 L22,7 C22,5.9 21.1,5 20,5 L16.83,5 L15,3 Z M12,18 C9.24,18 7,15.76 7,13 C7,10.24 9.24,8 12,8 C14.76,8 17,10.24 17,13 C17,15.76 14.76,18 12,18 Z M12,10 C10.34,10 9,11.34 9,13 C9,14.66 10.34,16 12,16 C13.66,16 15,14.66 15,13 C15,11.34 13.66,10 12,10 Z"/>
          </Button>
          <Border Width="1" Height="24" Background="{DynamicResource BrdrMain}" Margin="3,0"/>
          <!-- Export: clicking opens the list (mosairEXPORT ▸ / mosairEXPORT As ▸, each with the image quality
               choices: image size and estimated file size); right-click opens the mosairEXPORT folder -->
          <Panel PointerPressed="OnExportPointerPressed">
            <Button x:Name="exportBtn" Classes="icon-btn" ToolTip.Tip="{Binding [TipExport], Source={x:Static svc:Loc.Instance}}"
                    IsEnabled="{Binding CanExport}">
              <!-- Same geometry as the other export icons (bounds 5,3 → 19,20), split so the
                   arrow can drop into the tray while exporting -->
              <Viewbox Width="18" Height="18">
                <Canvas Width="14" Height="17" ClipToBounds="True">
                  <Path x:Name="exportArrow" Canvas.Left="-5" Canvas.Top="-3"
                        Fill="{DynamicResource FgIcon}"
                        Data="M19,9 L15,9 L15,3 L9,3 L9,9 L5,9 L12,16 Z">
                    <Path.RenderTransform>
                      <TranslateTransform/>
                    </Path.RenderTransform>
                  </Path>
                  <Path Canvas.Left="-5" Canvas.Top="-3"
                        Fill="{DynamicResource FgIcon}"
                        Data="M5,18 L5,20 L19,20 L19,18 Z"/>
                </Canvas>
              </Viewbox>
              <!-- Its list (mosairEXPORT ▸ / mosairEXPORT As ▸ with quality choices) is built in code -->
            </Button>
          </Panel>
          <Border Width="1" Height="24" Background="{DynamicResource BrdrMain}" Margin="3,0"/>
          <!-- Theme Toggle -->
          <Button Classes="icon-btn" Click="OnToggleTheme"
                  ToolTip.Tip="{Binding [TipTheme], Source={x:Static svc:Loc.Instance}}">
            <Panel>
              <Viewbox x:Name="iconDark" Width="16" Height="16">
                <Canvas Width="24" Height="24">
                  <Path Fill="{DynamicResource FgIcon}"
                        Data="M21.752 15.002A9.72 9.72 0 0 1 18 15.75c-5.385 0-9.75-4.365-9.75-9.75 0-1.06.197-2.07.556-3C4.575 4.272 1.5 8.21 1.5 12.862 1.5 18.56 6.007 23.063 11.702 23.063c4.652 0 8.59-3.075 9.862-7.307a9.67 9.67 0 0 1 .188-.754Z"/>
                </Canvas>
              </Viewbox>
              <Viewbox x:Name="iconLight" Width="16" Height="16" IsVisible="False">
                <Canvas Width="24" Height="24">
                  <Path Stroke="{DynamicResource FgIcon}" StrokeThickness="2" StrokeLineCap="Round"
                        Data="M12 2v2 M12 20v2 M2 12h2 M20 12h2 M4.93 4.93l1.41 1.41 M17.66 17.66l1.41 1.41 M4.93 19.07l1.41-1.41 M17.66 6.34l1.41-1.41"/>
                  <Path Fill="{DynamicResource FgIcon}"
                        Data="M12 8a4 4 0 1 1 0 8 4 4 0 0 1 0-8Z"/>
                </Canvas>
              </Viewbox>
            </Panel>
          </Button>
          <Border Width="1" Height="24" Background="{DynamicResource BrdrMain}" Margin="3,0"/>
          <!-- Language Toggle -->
          <Button Classes="icon-btn" ToolTip.Tip="{Binding [TipLanguage], Source={x:Static svc:Loc.Instance}}">
            <Button.Flyout>
              <Flyout Placement="BottomEdgeAlignedRight" ShowMode="TransientWithDismissOnPointerMoveAway">
                <Border Background="{DynamicResource BgPanel}" CornerRadius="6" Padding="4"
                        BorderBrush="{DynamicResource BrdrSec}" BorderThickness="1">
                  <StackPanel Spacing="2">
                    <Button Click="OnSetLanguageTr" Padding="8,5" MinWidth="100"
                            Background="Transparent" BorderThickness="0" CornerRadius="4" Cursor="Hand">
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="TR" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource FgSecondary}" Width="22"/>
                        <TextBlock Text="Türkçe" FontSize="11" Foreground="{DynamicResource FgPrimary}"/>
                      </StackPanel>
                    </Button>
                    <Button Click="OnSetLanguageEn" Padding="8,5" MinWidth="100"
                            Background="Transparent" BorderThickness="0" CornerRadius="4" Cursor="Hand">
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="EN" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource FgSecondary}" Width="22"/>
                        <TextBlock Text="English" FontSize="11" Foreground="{DynamicResource FgPrimary}"/>
                      </StackPanel>
                    </Button>
                  </StackPanel>
                </Border>
              </Flyout>
            </Button.Flyout>
            <PathIcon Width="16" Height="16" Foreground="{DynamicResource FgIcon}"
                      Data="M12,2 C6.48,2 2,6.48 2,12 C2,17.52 6.48,22 12,22 C17.52,22 22,17.52 22,12 C22,6.48 17.52,2 12,2 Z M11,19.93 C7.05,19.44 4,16.08 4,12 C4,11.38 4.08,10.79 4.21,10.21 L9,15 L9,16 C9,17.1 9.9,18 11,18 Z M17.9,17.39 C17.64,16.58 16.9,16 16,16 L15,16 L15,13 C15,12.45 14.55,12 14,12 L8,12 L8,10 L10,10 C10.55,10 11,9.55 11,9 L11,7 L13,7 C13.55,7 14,6.55 14,6 L14,4.26 C17.57,5.47 20,8.92 20,12 C20,14.08 19.2,15.97 17.9,17.39 Z"/>
          </Button>
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- ===== STATUS BAR (bottom) ===== -->
    <Border DockPanel.Dock="Bottom" Background="{DynamicResource BgBar}"
            BorderBrush="{DynamicResource BrdrMain}" BorderThickness="0,1,0,0" Height="28">
      <Panel>
      <!-- Wave that flows across the whole bar while any work is in progress -->
      <ctrl:ActivityWave IsActive="{Binding IsBusy}" WaveColor="{DynamicResource AccentFill}"/>
      <Grid ColumnDefinitions="*,Auto,*" Margin="8,3">
        <!-- Left: Used color info -->
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8"
                    VerticalAlignment="Center" IsVisible="{Binding MosaicDone}">
          <TextBlock Text="{Binding UsedColorInfo}" FontSize="11" FontWeight="SemiBold"
                     Foreground="{DynamicResource FgSecondary}" FontFamily="{StaticResource MonoFont}"/>
        </StackPanel>
        <!-- Center: Status + Progress -->
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6"
                    VerticalAlignment="Center" HorizontalAlignment="Center">
          <ProgressBar Value="{Binding Progress}" Minimum="0" Maximum="100"
                       Width="120" Height="10" IsVisible="{Binding IsProcessing}"/>
          <!-- Cancel: only while a cancellable job runs (Mos, stock fit, export); Esc does the same -->
          <Button Click="OnCancelWork" IsVisible="{Binding CanCancel}" VerticalAlignment="Center"
                  Padding="6,0" Height="20" MinHeight="0" CornerRadius="3" Cursor="Hand"
                  Background="Transparent" BorderBrush="{DynamicResource Danger}" BorderThickness="1"
                  ToolTip.Tip="{Binding [TipCancel], Source={x:Static svc:Loc.Instance}}">
            <!-- Red, like the stock red dots, so it stands apart from the neutral status text -->
            <StackPanel Orientation="Horizontal" Spacing="4">
              <PathIcon Width="8" Height="8" Foreground="{DynamicResource Danger}"
                        Data="M2,0 L6,4 L10,0 L12,2 L8,6 L12,10 L10,12 L6,8 L2,12 L0,10 L4,6 L0,2 Z"/>
              <TextBlock Text="{Binding [BtnCancel], Source={x:Static svc:Loc.Instance}}" FontSize="11"
                         Foreground="{DynamicResource DangerText}" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
          <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center"
                     Foreground="{DynamicResource FgSecondary}" FontSize="11"
                     FontFamily="{StaticResource MonoFont}"/>
          <TextBlock Text="{Binding ElapsedTime}" VerticalAlignment="Center"
                     Foreground="{DynamicResource FgMuted}" FontSize="11"
                     FontFamily="{StaticResource MonoFont}"/>
        </StackPanel>
        <!-- Right: Zoom + Fit -->
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4"
                    VerticalAlignment="Center" HorizontalAlignment="Right">
          <Button Classes="icon-btn" ToolTip.Tip="{Binding [TipFit], Source={x:Static svc:Loc.Instance}}" Click="OnResetSize"
                  Width="22" Height="22" Padding="3">
            <PathIcon Width="14" Height="14" Foreground="{DynamicResource FgIcon}"
                      Data="M5,15 L3,15 L3,19 C3,20.1 3.9,21 5,21 L9,21 L9,19 L5,19 Z M5,5 L9,5 L9,3 L5,3 C3.9,3 3,3.9 3,5 L3,9 L5,9 Z M19,3 L15,3 L15,5 L19,5 L19,9 L21,9 L21,5 C21,3.9 20.1,3 19,3 Z M19,19 L15,19 L15,21 L19,21 C20.1,21 21,20.1 21,19 L21,15 L19,15 Z"/>
          </Button>
          <TextBlock Text="{Binding ZoomInfo}" VerticalAlignment="Center"
                     Foreground="{DynamicResource FgSecondary}" FontWeight="SemiBold" FontSize="11"
                     FontFamily="{StaticResource MonoFont}" Margin="0,0,4,0"/>
        </StackPanel>
      </Grid>
      </Panel>
    </Border>

    <!-- ===== MAIN CONTENT ===== -->
    <Grid x:Name="mainGrid">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="380" MinWidth="220" MaxWidth="380"/>
        <ColumnDefinition Width="4"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="4"/>
        <!-- Görsel Ayarları: its own column, widened up to 600 px for finer sliders -->
        <ColumnDefinition Width="300" MinWidth="260" MaxWidth="600"/>
        <ColumnDefinition Width="4"/>
        <ColumnDefinition Width="220" MinWidth="160" MaxWidth="360"/>
      </Grid.ColumnDefinitions>

    <!-- LEFT PANEL -->
    <Border Grid.Column="0" Background="{DynamicResource BgPanel}"
            BorderBrush="{DynamicResource BrdrMain}" BorderThickness="0,0,1,0">
      <DockPanel>
        <!-- Row 1: Dimensions: "[width] × height cm = area m²", then stones and moulds in one card -->
        <Border x:Name="dimsBorder" DockPanel.Dock="Top" Background="{DynamicResource BgBar}" Padding="10,8"
                BorderBrush="{DynamicResource BrdrMain}" BorderThickness="0,0,0,1">
          <Border.Transitions>
            <Transitions>
              <BrushTransition Property="Background" Duration="0:0:0.4"/>
            </Transitions>
          </Border.Transitions>
          <StackPanel Spacing="8">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <TextBox Text="{Binding WidthCm, Converter={StaticResource InvDouble}}" Width="76"
                       FontSize="16" FontWeight="SemiBold" Padding="6,2" FontFamily="{StaticResource MonoFont}"
                       VerticalContentAlignment="Center"
                       Background="{DynamicResource BgInput}" Foreground="{DynamicResource FgPrimary}"
                       BorderBrush="{DynamicResource BrdrMain}" CornerRadius="4"
                       LostFocus="OnWidthChanged"
                       KeyDown="OnWidthKeyDown"
                       GotFocus="OnWidthGotFocus"
                       TextInput="OnWidthTextInput"/>
              <TextBlock Text="cm" FontSize="13" VerticalAlignment="Center" Foreground="{DynamicResource FgMuted}"
                         IsVisible="{Binding !ImageLoaded}"/>
              <!-- The height and area follow once an image is loaded -->
              <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding ImageLoaded}">
                <TextBlock Text="×" FontSize="16" VerticalAlignment="Center" Foreground="{DynamicResource FgMuted}"/>
                <TextBlock Text="{Binding DimensionHeight}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"
                           Foreground="{DynamicResource FgPrimary}" FontFamily="{StaticResource MonoFont}"/>
                <TextBlock Text="cm" FontSize="13" VerticalAlignment="Center" Foreground="{DynamicResource FgMuted}"/>
                <TextBlock Text="=" FontSize="16" VerticalAlignment="Center" Foreground="{DynamicResource FgMuted}"/>
                <TextBlock Text="{Binding DimensionArea}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"
                           Foreground="{DynamicResource FgPrimary}" FontFamily="{StaticResource MonoFont}"/>
              </StackPanel>
            </StackPanel>
            <!-- Stones and moulds as two aligned rows ("Taş  250 × 444 = 111.000"); the columns size to the
                 numbers, so even an 8-digit stone count shows in full -->
            <Border IsVisible="{Binding ImageLoaded}" Background="{DynamicResource BgInput}" CornerRadius="6"
                    Padding="10,5" BorderBrush="{DynamicResource BrdrMain}" BorderThickness="1">
              <Grid ColumnDefinitions="Auto,10,Auto,22,Auto,22,Auto" RowDefinitions="Auto,Auto" RowSpacing="3">
                <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding [InfoStonesLabel], Source={x:Static svc:Loc.Instance}}" FontSize="11"
                           Foreground="{DynamicResource FgMuted}" VerticalAlignment="Center"/>
                <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding InfoStoneCols}" HorizontalAlignment="Right" FontSize="12"
                           Foreground="{DynamicResource FgPrimary}" FontFamily="{StaticResource MonoFont}"/>
                <TextBlock Grid.Row="0" Grid.Column="3" Text="×" HorizontalAlignment="Center" FontSize="12"
                           Foreground="{DynamicResource FgMuted}" FontFamily="{StaticResource MonoFont}"/>
                <TextBlock Grid.Row="0" Grid.Column="4" Text="{Binding InfoStoneRows}" HorizontalAlignment="Right" FontSize="12"
                           Foreground="{DynamicResource FgPrimary}" FontFamily="{StaticResource MonoFont}"/>
                <TextBlock Grid.Row="0" Grid.Column="5" Text="=" HorizontalAlignment="Center" FontSize="12"
                           Foreground="{DynamicResource FgMuted}" FontFamily="{StaticResource MonoFont}"/>
                <TextBlock Grid.Row="0" Grid.Column="6" Text="{Binding InfoStoneTotal}" HorizontalAlignment="Right" FontSize="12"
                           FontWeight="SemiBold" Foreground="{DynamicResource FgPrimary}" FontFamily="{StaticResource MonoFont}"/>
                <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding [InfoMouldsLabel], Source={x:Static svc:Loc.Instance}}" FontSize="11"
                           Foreground="{DynamicResource FgMuted}" VerticalAlignment="Center"/>
                <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding InfoMouldCols}" HorizontalAlignment="Right" FontSize="12"
                           Foreground="{DynamicResource FgPrimary}" FontFamily="{StaticResource MonoFont}"/>
                <TextBlock Grid.Row="1" Grid.Column="3" Text="×" HorizontalAlignment="Center" FontSize="12"
                           Foreground="{DynamicResource FgMuted}" FontFamily="{StaticResource MonoFont}"/>
                <TextBlock Grid.Row="1" Grid.Column="4" Text="{Binding InfoMouldRows}" HorizontalAlignment="Right" FontSize="12"
                           Foreground="{DynamicResource FgPrimary}" FontFamily="{StaticResource MonoFont}"/>
                <TextBlock Grid.Row="1" Grid.Column="5" Text="=" HorizontalAlignment="Center" FontSize="12"
                           Foreground="{DynamicResource FgMuted}" FontFamily="{StaticResource MonoFont}"/>
                <TextBlock Grid.Row="1" Grid.Column="6" Text="{Binding InfoMouldTotal}" HorizontalAlignment="Right" FontSize="12"
                           FontWeight="SemiBold" Foreground="{DynamicResource FgPrimary}" FontFamily="{StaticResource MonoFont}"/>
              </Grid>
            </Border>
          </StackPanel>
        </Border>

        <!-- Catalog bar: a two-part "select all | clear all" control (22 px, 10 px text) -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource BgBar}" Padding="6,4"
                BorderBrush="{DynamicResource BrdrMain}" BorderThickness="0,0,0,1">
          <Border HorizontalAlignment="Left" Background="{DynamicResource BgInput}" BorderBrush="{DynamicResource BrdrMain}"
                  BorderThickness="1" CornerRadius="4" Height="22" ClipToBounds="True">
            <StackPanel Orientation="Horizontal">
              <Button Content="{Binding [BtnSelectAll], Source={x:Static svc:Loc.Instance}}" Click="OnSelectAll"
                      ToolTip.Tip="{Binding [MenuSelectAll], Source={x:Static svc:Loc.Instance}}"
                      FontSize="10" FontWeight="SemiBold" Padding="8,0" VerticalContentAlignment="Center"
                      Background="Transparent" Foreground="{DynamicResource AccentText}" BorderThickness="0" CornerRadius="0"/>
              <Border Width="1" Background="{DynamicResource BrdrMain}"/>
              <Button Content="{Binding [BtnDeselectAll], Source={x:Static svc:Loc.Instance}}" Click="OnDeselectAll"
                      ToolTip.Tip="{Binding [MenuDeselectAll], Source={x:Static svc:Loc.Instance}}"
                      FontSize="10" Padding="8,0" VerticalContentAlignment="Center"
                      Background="Transparent" Foreground="{DynamicResource FgSecondary}" BorderThickness="0" CornerRadius="0"/>
            </StackPanel>
          </Border>
        </Border>

        <!-- 3 Column layout -->
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="100"/>
            <ColumnDefinition Width="1"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="1"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <!-- Headers -->
          <Border Grid.Column="0" Background="{DynamicResource BgBar}"
                  BorderBrush="{DynamicResource BrdrMain}" BorderThickness="0,0,0,1" Padding="4,2" Height="20"
                  VerticalAlignment="Top">
            <TextBlock Text="{Binding [ColCatalog], Source={x:Static svc:Loc.Instance}}" FontSize="11" FontWeight="SemiBold"
                       Foreground="{DynamicResource FgMuted}" HorizontalAlignment="Center"/>
          </Border>
          <Border Grid.Column="2" Background="{DynamicResource BgBar}"
                  BorderBrush="{DynamicResource BrdrMain}" BorderThickness="0,0,0,1" Padding="4,2" Height="20"
                  VerticalAlignment="Top">
            <TextBlock Text="{Binding [ColMatch], Source={x:Static svc:Loc.Instance}}" FontSize="11" FontWeight="SemiBold"
                       Foreground="{DynamicResource FgMuted}" HorizontalAlignment="Center"/>
          </Border>
          <Border Grid.Column="4" Background="{DynamicResource BgBar}"
                  BorderBrush="{DynamicResource BrdrMain}" BorderThickness="0,0,0,1" Padding="4,2" Height="20"
                  VerticalAlignment="Top">
            <TextBlock Text="{Binding [ColAssigned], Source={x:Static svc:Loc.Instance}}" FontSize="11" FontWeight="SemiBold"
                       Foreground="{DynamicResource FgMuted}" HorizontalAlignment="Center"/>
          </Border>

          <!-- Col 1: Katalog -->
          <ListBox x:Name="catalogListBox" Grid.Column="0" ItemsSource="{Binding CatalogColors}"
                   SelectionMode="Single" Background="{DynamicResource BgBar}"
                   Padding="0" Margin="0,20,0,0" BorderThickness="0"
                   ClipToBounds="True" SelectionChanged="OnCatalogSelectionChanged">
            <ListBox.Styles>
              <Style Selector="ListBoxItem">
                <Setter Property="Padding" Value="2,0"/>
                <Setter Property="MinHeight" Value="16"/>
              </Style>
            </ListBox.Styles>
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:ColorItem">
                <StackPanel Orientation="Horizontal" Spacing="1" Height="16">
                  <StackPanel.Styles>
                    <Style Selector="ToolTip">
                      <Setter Property="MaxWidth" Value="300"/>
                    </Style>
                  </StackPanel.Styles>
                  <Panel Width="6" VerticalAlignment="Center">
                    <Ellipse Width="6" Height="6" Fill="{DynamicResource Danger}" IsVisible="{Binding StockShort}"/>
                  </Panel>
                  <CheckBox IsChecked="{Binding IsSelected}"
                            Click="OnColorCheckChanged" Margin="0" Padding="0"
                            MinWidth="18" MaxWidth="18"/>
                  <TextBlock Text="{Binding ID}" FontSize="9" Foreground="{DynamicResource FgMuted}"
                             VerticalAlignment="Center" Width="14" TextAlignment="Right"
                             FontFamily="{StaticResource MonoFont}"/>
                  <Panel Width="16" Height="14" VerticalAlignment="Center" Margin="2,0,1,0">
                    <ToolTip.Tip>
                      <StackPanel Spacing="4">
                        <DockPanel>
                          <!-- Stock from the sheet, as in WPF: on hand → remaining kg -->
                          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="8,0,0,0"
                                      VerticalAlignment="Center">
                            <TextBlock Text="{Binding StockKgText}" Foreground="{Binding StockKgBrush}" FontSize="10"
                                       IsVisible="{Binding StockKgVisible}"/>
                            <TextBlock Text=" → " FontSize="10" IsVisible="{Binding StockArrowVisible}"/>
                            <TextBlock Text="{Binding RemainingText}" Foreground="{Binding RemainingBrush}" FontSize="10"
                                       IsVisible="{Binding RemainingVisible}"/>
                          </StackPanel>
                          <TextBlock Text="{Binding TooltipHeader}" FontWeight="Bold" FontSize="12"/>
                        </DockPanel>
                        <Image Source="{Binding TooltipBitmap}" Stretch="None"
                               IsVisible="{Binding TooltipBitmap, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                      </StackPanel>
                    </ToolTip.Tip>
                    <Border CornerRadius="2" Background="{Binding ColorBrush}" BorderBrush="{DynamicResource BrdrTer}" BorderThickness="1"/>
                    <Image Source="{Binding ThumbnailBitmap}" Stretch="UniformToFill"
                           IsVisible="{Binding ThumbnailBitmap, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                  </Panel>
                  <TextBlock Text="{Binding CodeName}" FontSize="9" Foreground="{DynamicResource FgPrimary}"
                             VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                             FontFamily="{StaticResource MonoFont}"/>
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <!-- Separator 1 -->
          <Border Grid.Column="1" Background="{DynamicResource BrdrMain}" Margin="0,20,0,0"/>

          <!-- Col 2: Palet -->
          <ScrollViewer x:Name="paletteScroll" Grid.Column="2"
                        VerticalScrollBarVisibility="Hidden"
                        HorizontalScrollBarVisibility="Disabled"
                        Margin="0,20,0,0">
            <ItemsControl ItemsSource="{Binding PaletteColors}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:PaletteItem">
                  <Border Height="16" HorizontalAlignment="Center" Padding="2,1">
                    <Border Width="18" Height="14" CornerRadius="2"
                            Background="{Binding ColorBrush}"
                            BorderBrush="{DynamicResource BrdrTer}" BorderThickness="1"/>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>

          <!-- Separator 2 -->
          <Border Grid.Column="3" Background="{DynamicResource BrdrMain}" Margin="0,20,0,0"/>

          <!-- Col 3: Atanan -->
          <ScrollViewer x:Name="assignedScroll" Grid.Column="4"
                        VerticalScrollBarVisibility="Auto"
                        HorizontalScrollBarVisibility="Disabled"
                        Margin="0,20,0,0">
            <ItemsControl ItemsSource="{Binding AssignedColors}" Margin="0,0,14,0">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:AssignedItem">
                  <Border Background="{Binding RowBrush}" Padding="2,0" Height="16"
                          ClipToBounds="True">
                    <Grid ColumnDefinitions="Auto,Auto,*">
                      <TextBlock Grid.Column="0" Text="{Binding ID}" FontSize="9"
                                 FontWeight="Bold" Foreground="{Binding TextBrush}"
                                 VerticalAlignment="Center" TextAlignment="Right"
                                 MinWidth="20"
                                 FontFamily="{StaticResource MonoFont}"/>
                      <TextBlock Grid.Column="1" Text="{Binding CodeName}" FontSize="9"
                                 FontWeight="Bold" Foreground="{Binding TextBrush}"
                                 VerticalAlignment="Center" Margin="4,0,0,0"
                                 TextTrimming="CharacterEllipsis"
                                 FontFamily="{StaticResource MonoFont}"/>
                      <TextBlock Grid.Column="2" Text="{Binding PixelCount}" FontSize="9"
                                 FontWeight="Bold" Foreground="{Binding TextBrush}"
                                 VerticalAlignment="Center" HorizontalAlignment="Right"
                                 FontFamily="{StaticResource MonoFont}"/>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Grid>
      </DockPanel>
    </Border>

    <!-- Panel / Canvas Splitter -->
    <GridSplitter Grid.Column="1" Width="4" Background="{DynamicResource BrdrMain}"
                  ResizeDirection="Columns" Cursor="SizeWestEast"/>

    <!-- ===== CANVAS ===== -->
    <Border x:Name="canvasBorder" Grid.Column="2" Background="{DynamicResource BgCanvas}"
            DragDrop.AllowDrop="True">
      <!-- Tinted with the loaded image's colour (MainWindow.ApplyImageTint), changing smoothly -->
      <Border.Transitions>
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.4"/>
        </Transitions>
      </Border.Transitions>
      <Panel>
        <ScrollViewer x:Name="imageScroller"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto"
                      ScrollChanged="OnScrollChanged">
          <Panel x:Name="imagePanel" Margin="4"
                 Width="{Binding ImageDisplayWidth}"
                 Height="{Binding ImageDisplayHeight}">
            <!-- Before Mos: the loaded image (smooth scaling while it is shown smaller than its size, set in code) -->
            <Image x:Name="sourceImage" Source="{Binding DisplayBitmap}"
                   IsVisible="{Binding ShowSourceView}"
                   Width="{Binding SourceViewWidth}" Height="{Binding SourceViewHeight}"
                   HorizontalAlignment="Left" VerticalAlignment="Top"
                   Stretch="Fill"
                   RenderOptions.BitmapInterpolationMode="LowQuality"
                   PointerWheelChanged="OnImageWheel"
                   PointerMoved="OnImagePointerMoved"
                   PointerPressed="OnImagePointerPressed"
                   PointerReleased="OnImagePointerReleased"/>
            <!-- After Mos: the stone image, drawn tile by tile for the visible part only -->
            <ctrl:MosaicView x:Name="mosaicView"
                             IsVisible="{Binding ShowMosaicView}"
                             Source="{Binding RenderSource}"
                             Overview="{Binding OverviewBitmap}"
                             StonePixelSize="{Binding StonePixelSize}"
                             ShowGrid="{Binding ShowGrid}"
                             GridColor="{Binding GridColor}"
                             PointerWheelChanged="OnImageWheel"
                             PointerMoved="OnImagePointerMoved"
                             PointerPressed="OnImagePointerPressed"
                             PointerReleased="OnImagePointerReleased"/>
            <ctrl:GridOverlay ShowGrid="{Binding ShowGrid}"
                              StoneSize="{Binding StonePixelSize}"
                              BitmapWidth="{Binding BitmapPixelWidth}"
                              BitmapHeight="{Binding BitmapPixelHeight}"
                              StoneColumns="{Binding StoneColumns}"
                              StoneRows="{Binding InfoStoneRows}"
                              GridColor="{Binding GridColor}"
                              IsHitTestVisible="False"/>
          </Panel>
        </ScrollViewer>
        <!-- While an Anlık Mos replaces the mosaic: a still picture of the previous one (MainWindow.FreezeMosaicView) -->
        <Image x:Name="liveMosFreeze" IsVisible="False" IsHitTestVisible="False" Stretch="Fill"
               HorizontalAlignment="Left" VerticalAlignment="Top"/>

        <!-- Mini Map / Navigator -->
        <Border x:Name="navPanel"
                HorizontalAlignment="Right" VerticalAlignment="Top"
                Margin="0,6,6,0" Width="150" Height="150"
                Background="{DynamicResource NavBg}" CornerRadius="6"
                BorderBrush="{DynamicResource BrdrTer}" BorderThickness="1"
                IsVisible="{Binding ImageLoaded}"
                PointerPressed="OnNavPointerPressed"
                PointerMoved="OnNavPointerMoved"
                ClipToBounds="True">
          <Panel>
            <Image Source="{Binding NavBitmap}" Stretch="Uniform"
                   RenderOptions.BitmapInterpolationMode="LowQuality"/>
            <Canvas>
              <Border Canvas.Left="{Binding NavViewLeft}"
                      Canvas.Top="{Binding NavViewTop}"
                      Width="{Binding NavViewWidth}"
                      Height="{Binding NavViewHeight}"
                      BorderBrush="{DynamicResource AccentBorder}" BorderThickness="1.5"
                      Background="{DynamicResource AccentSubtle}" CornerRadius="1"/>
            </Canvas>
          </Panel>
        </Border>

      </Panel>
    </Border>

    <!-- Canvas / Görsel Ayarları splitter -->
    <GridSplitter x:Name="adjustSplitter" Grid.Column="3" Width="4" Background="{DynamicResource BrdrMain}"
                  ResizeDirection="Columns" Cursor="SizeWestEast"/>

    <!-- ===== GÖRSEL AYARLARI: Işık and Ton/Doygunluk, like Photoshop's adjustment panels ===== -->
    <Border Grid.Column="4" Background="{DynamicResource BgPanel}"
            BorderBrush="{DynamicResource BrdrMain}" BorderThickness="1,0,0,0"
            IsVisible="{Binding IsAdjustPanelOpen}">
      <DockPanel>
        <Border DockPanel.Dock="Top" Background="{DynamicResource BgBar}" Padding="8,2,2,2"
                BorderBrush="{DynamicResource BrdrMain}" BorderThickness="0,0,0,1">
          <DockPanel>
            <Button DockPanel.Dock="Right" Click="OnToggleAdjustPanel" Width="22" Height="20" Padding="0"
                    Background="Transparent" BorderThickness="0" CornerRadius="4" Cursor="Hand"
                    ToolTip.Tip="{Binding [TipPanelHide], Source={x:Static svc:Loc.Instance}}">
              <PathIcon Width="10" Height="10" Foreground="{DynamicResource FgMuted}" Data="M3,11 L21,11 L21,13 L3,13 Z"/>
            </Button>
            <Ellipse DockPanel.Dock="Right" Width="6" Height="6" Fill="{DynamicResource AccentText}" Margin="0,0,8,0"
                     VerticalAlignment="Center" IsVisible="{Binding IsAdjusted}"/>
            <TextBlock Text="{Binding [AdjTitle], Source={x:Static svc:Loc.Instance}}" FontSize="11" FontWeight="SemiBold"
                       Foreground="{DynamicResource FgMuted}" VerticalAlignment="Center"
                       ToolTip.Tip="{Binding [TipAdjust], Source={x:Static svc:Loc.Instance}}"/>
          </DockPanel>
        </Border>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="4" Margin="10,8,10,2">
          <ToggleButton Classes="chip" IsChecked="{Binding IsLightTab}" Content="{Binding [AdjTabLight], Source={x:Static svc:Loc.Instance}}"
                        FontSize="11" Padding="10,3"/>
          <ToggleButton Classes="chip" IsChecked="{Binding IsColorTab}" Content="{Binding [AdjTabColor], Source={x:Static svc:Loc.Instance}}"
                        FontSize="11" Padding="10,3"/>
        </StackPanel>
        <!-- Anlık Mos: each change is followed by a Mos (on), or the image is shown until the next Mos (off). A checkbox,
             so it does not look like the tabs; while on, its two colour choices show below it -->
        <StackPanel DockPanel.Dock="Top" Margin="10,6,10,2" Spacing="0">
          <CheckBox IsChecked="{Binding LiveMos}" ToolTip.Tip="{Binding [TipAdjLiveMos], Source={x:Static svc:Loc.Instance}}">
            <TextBlock Text="{Binding [AdjLiveMos], Source={x:Static svc:Loc.Instance}}" FontSize="11" FontWeight="SemiBold"
                       Foreground="{DynamicResource FgPrimary}" VerticalAlignment="Center"/>
          </CheckBox>
          <StackPanel Margin="24,0,0,0" IsVisible="{Binding LiveMos}">
            <RadioButton GroupName="liveMosColors" IsChecked="{Binding LiveMosAllColors}"
                         ToolTip.Tip="{Binding [TipLiveMosAll], Source={x:Static svc:Loc.Instance}}">
              <TextBlock Text="{Binding [AdjLiveMosAll], Source={x:Static svc:Loc.Instance}}" FontSize="11"
                         Foreground="{DynamicResource FgSecondary}" VerticalAlignment="Center"/>
            </RadioButton>
            <RadioButton GroupName="liveMosColors" IsChecked="{Binding LiveMosSelectedColors}"
                         ToolTip.Tip="{Binding [TipLiveMosSelected], Source={x:Static svc:Loc.Instance}}">
              <TextBlock Text="{Binding [AdjLiveMosSelected], Source={x:Static svc:Loc.Instance}}" FontSize="11"
                         Foreground="{DynamicResource FgSecondary}" VerticalAlignment="Center"/>
            </RadioButton>
          </StackPanel>
        </StackPanel>
        <DockPanel DockPanel.Dock="Bottom" Margin="10,4,10,10">
          <Button DockPanel.Dock="Right" Content="{Binding [AdjReset], Source={x:Static svc:Loc.Instance}}" Click="OnAdjustReset"
                  FontSize="11" Padding="12,3" CornerRadius="4" BorderThickness="1"
                  Background="{DynamicResource BgInput}" Foreground="{DynamicResource FgSecondary}"
                  BorderBrush="{DynamicResource BrdrMain}" IsEnabled="{Binding IsAdjusted}"/>
          <TextBlock Text="{Binding [AdjHint], Source={x:Static svc:Loc.Instance}}" FontSize="10" TextWrapping="Wrap" Margin="0,0,8,0"
                     VerticalAlignment="Center" Foreground="{DynamicResource FgMuted}"/>
        </DockPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="12,6,12,6" IsEnabled="{Binding CanAdjust}">
            <ItemsControl ItemsSource="{Binding LightParams}" IsVisible="{Binding IsLightTab}">
              <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:AdjustParam">
              <StackPanel Margin="0,4,0,6" Spacing="3">
                <DockPanel>
                  <TextBox DockPanel.Dock="Right" Width="60" Height="22" MinHeight="22" Padding="5,1" FontSize="11"
                           TextAlignment="Right" VerticalContentAlignment="Center" FontFamily="{StaticResource MonoFont}"
                           Text="{Binding Text, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" KeyDown="OnAdjustTextKeyDown"
                           Classes="adj-num"/>
                  <TextBlock Text="{Binding Label}" FontSize="11" VerticalAlignment="Center"
                             Foreground="{DynamicResource FgSecondary}"/>
                </DockPanel>
                <ctrl:AdjustSlider Minimum="{Binding Min}" Maximum="{Binding Max}" Value="{Binding SliderValue}"
                                   DefaultValue="{Binding Default}" TrackBrush="{Binding Track}"
                                   EmptyTrackBrush="{DynamicResource BrdrTer}" ThumbBrush="{DynamicResource FgPrimary}"
                                   ThumbBorderBrush="{DynamicResource BgInput}"
                                   ToolTip.Tip="{Binding [TipAdjSlider], Source={x:Static svc:Loc.Instance}}"/>
              </StackPanel>
            </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <StackPanel IsVisible="{Binding IsColorTab}" Spacing="6">
              <!-- Colour ranges: Ana (all colours), reds, yellows, greens, cyans, blues, magentas -->
              <ItemsControl ItemsSource="{Binding AdjustRanges}" IsEnabled="{Binding CanPickRange}" Margin="0,2,0,0">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:AdjustRange">
                    <Button Click="OnAdjustRangeClick" Tag="{Binding Index}" Width="28" Height="28" Padding="0" Margin="0,0,4,4"
                            Background="Transparent" BorderThickness="0" CornerRadius="14" Cursor="Hand"
                            ToolTip.Tip="{Binding Label}">
                      <Panel>
                        <Ellipse Width="20" Height="20" Fill="{Binding Swatch}"
                                 Stroke="{DynamicResource BrdrTer}" StrokeThickness="1"/>
                        <Ellipse Width="26" Height="26" Stroke="{DynamicResource AccentBorder}" StrokeThickness="2"
                                 IsVisible="{Binding IsSelected}"/>
                        <Ellipse Width="6" Height="6" Fill="{DynamicResource FgPrimary}" HorizontalAlignment="Right"
                                 VerticalAlignment="Bottom" Margin="0,0,1,1" IsVisible="{Binding IsUsed}"/>
                      </Panel>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <ItemsControl ItemsSource="{Binding ColorParams}">
                <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:AdjustParam">
              <StackPanel Margin="0,4,0,6" Spacing="3">
                <DockPanel>
                  <TextBox DockPanel.Dock="Right" Width="60" Height="22" MinHeight="22" Padding="5,1" FontSize="11"
                           TextAlignment="Right" VerticalContentAlignment="Center" FontFamily="{StaticResource MonoFont}"
                           Text="{Binding Text, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" KeyDown="OnAdjustTextKeyDown"
                           Classes="adj-num"/>
                  <TextBlock Text="{Binding Label}" FontSize="11" VerticalAlignment="Center"
                             Foreground="{DynamicResource FgSecondary}"/>
                </DockPanel>
                <ctrl:AdjustSlider Minimum="{Binding Min}" Maximum="{Binding Max}" Value="{Binding SliderValue}"
                                   DefaultValue="{Binding Default}" TrackBrush="{Binding Track}"
                                   EmptyTrackBrush="{DynamicResource BrdrTer}" ThumbBrush="{DynamicResource FgPrimary}"
                                   ThumbBorderBrush="{DynamicResource BgInput}"
                                   ToolTip.Tip="{Binding [TipAdjSlider], Source={x:Static svc:Loc.Instance}}"/>
              </StackPanel>
            </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <CheckBox IsChecked="{Binding AdjColorize}" Content="{Binding [AdjColorize], Source={x:Static svc:Loc.Instance}}" FontSize="11"
                        ToolTip.Tip="{Binding [TipAdjColorize], Source={x:Static svc:Loc.Instance}}"/>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </DockPanel>
    </Border>

    <!-- Folded Görsel Ayarları: a strip with a show button -->
    <Border Grid.Column="4" Background="{DynamicResource BgBar}"
            BorderBrush="{DynamicResource BrdrMain}" BorderThickness="1,0,0,0"
            IsVisible="{Binding !IsAdjustPanelOpen}">
      <Button Click="OnToggleAdjustPanel" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
              HorizontalContentAlignment="Center" VerticalContentAlignment="Top"
              Background="Transparent" BorderThickness="0" CornerRadius="0" Padding="0,8" Cursor="Hand"
              ToolTip.Tip="{Binding [TipAdjustShow], Source={x:Static svc:Loc.Instance}}">
        <StackPanel Spacing="8">
          <PathIcon Width="10" Height="10" Foreground="{DynamicResource FgSecondary}" HorizontalAlignment="Center"
                    Data="M15.4,4.6 L8,12 L15.4,19.4 L14,20.8 L5.2,12 L14,3.2 Z"/>
          <Ellipse Width="6" Height="6" Fill="{DynamicResource AccentText}" HorizontalAlignment="Center" IsVisible="{Binding IsAdjusted}"/>
          <LayoutTransformControl HorizontalAlignment="Center">
            <LayoutTransformControl.LayoutTransform>
              <RotateTransform Angle="90"/>
            </LayoutTransformControl.LayoutTransform>
            <TextBlock Text="{Binding [MenuAdjustPanel], Source={x:Static svc:Loc.Instance}}" FontSize="11" FontWeight="SemiBold"
                       Foreground="{DynamicResource FgMuted}"/>
          </LayoutTransformControl>
        </StackPanel>
      </Button>
    </Border>

    <!-- Görsel Ayarları / Properties Splitter -->
    <GridSplitter x:Name="propsSplitter" Grid.Column="5" Width="4" Background="{DynamicResource BrdrMain}"
                  ResizeDirection="Columns" Cursor="SizeWestEast"/>

    <!-- ===== PROPERTIES PANEL ===== -->
    <Border Grid.Column="6" Background="{DynamicResource BgPanel}"
            BorderBrush="{DynamicResource BrdrMain}" BorderThickness="1,0,0,0"
            IsVisible="{Binding IsPropertiesPanelOpen}">
      <DockPanel>
        <Border DockPanel.Dock="Top" Background="{DynamicResource BgBar}" Padding="8,2,2,2"
                BorderBrush="{DynamicResource BrdrMain}" BorderThickness="0,0,0,1">
          <DockPanel>
            <!-- Minimize: folds the panel to the strip on the right -->
            <Button DockPanel.Dock="Right" Click="OnTogglePropertiesPanel" Width="22" Height="20" Padding="0"
                    Background="Transparent" BorderThickness="0" CornerRadius="3" Cursor="Hand"
                    ToolTip.Tip="{Binding [TipPanelHide], Source={x:Static svc:Loc.Instance}}">
              <PathIcon Width="10" Height="10" Foreground="{DynamicResource FgMuted}" Data="M3,11 L21,11 L21,13 L3,13 Z"/>
            </Button>
            <TextBlock Text="{Binding [PropTitle], Source={x:Static svc:Loc.Instance}}" FontSize="11" FontWeight="SemiBold"
                       Foreground="{DynamicResource FgMuted}" VerticalAlignment="Center"/>
          </DockPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
         <StackPanel>
          <!-- No image yet -->
          <StackPanel Margin="16,28" Spacing="8" HorizontalAlignment="Center" IsVisible="{Binding ShowNoImageHint}">
            <PathIcon Width="28" Height="28" Foreground="{DynamicResource FgMuted}" HorizontalAlignment="Center"
                      Data="M19,3 L5,3 C3.9,3 3,3.9 3,5 L3,19 C3,20.1 3.9,21 5,21 L19,21 C20.1,21 21,20.1 21,19 L21,5 C21,3.9 20.1,3 19,3 Z M19,19 L5,19 L5,5 L19,5 Z M14.1,11.9 L11.3,15.5 L9.3,13.1 L6.5,16.7 L17.5,16.7 Z"/>
            <TextBlock Text="{Binding [PropNoImage], Source={x:Static svc:Loc.Instance}}" FontSize="10" TextWrapping="Wrap" TextAlignment="Center"
                       Foreground="{DynamicResource FgMuted}"/>
          </StackPanel>

          <!-- Image information (while no stone is selected): preview, details, colours, most used stones -->
          <StackPanel Margin="8" Spacing="8" IsVisible="{Binding ShowImageInfo}">
            <Border CornerRadius="6" ClipToBounds="True" BorderBrush="{DynamicResource BrdrMain}" BorderThickness="1">
              <StackPanel>
                <Panel Background="{DynamicResource BgCanvas}" IsVisible="{Binding ImageInfoFound}">
                  <Image Source="{Binding ImageInfoThumb}" Stretch="Uniform" MaxHeight="150"
                         RenderOptions.BitmapInterpolationMode="HighQuality"/>
                  <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="6" Padding="5,1" CornerRadius="3"
                          Background="#B0000000">
                    <TextBlock Text="{Binding ImageInfoType}" FontSize="11" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                  </Border>
                </Panel>
                <Border Background="{DynamicResource BgInput}" Padding="8,6">
                  <StackPanel Spacing="2">
                    <TextBlock Text="{Binding [PropImage], Source={x:Static svc:Loc.Instance}}" Classes="section-title" Margin="0"/>
                    <TextBlock Text="{Binding ImageInfoName}" FontSize="11" FontWeight="SemiBold" TextWrapping="Wrap"
                               Foreground="{DynamicResource FgPrimary}"/>
                    <TextBlock Text="{Binding [PropImageMissing], Source={x:Static svc:Loc.Instance}}" FontSize="10" Foreground="{DynamicResource DangerText}"
                               IsVisible="{Binding !ImageInfoFound}"/>
                  </StackPanel>
                </Border>
              </StackPanel>
            </Border>

            <Border Classes="info-card" IsVisible="{Binding ImageInfoFound}">
              <StackPanel Spacing="6">
                <TextBlock Text="{Binding [PropDetails], Source={x:Static svc:Loc.Instance}}" Classes="section-title" Margin="0"/>
                <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="5">
                <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding [PropResolution], Source={x:Static svc:Loc.Instance}}" FontSize="10"
                           Foreground="{DynamicResource FgMuted}" Margin="0,0,10,0"/>
                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding ImageInfoResolution}" FontSize="10" HorizontalAlignment="Right"
                           TextTrimming="CharacterEllipsis" Foreground="{DynamicResource FgPrimary}" FontFamily="{StaticResource MonoFont}"/>
                <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding [PropMegapixels], Source={x:Static svc:Loc.Instance}}" FontSize="10"
                           Foreground="{DynamicResource FgMuted}" Margin="0,0,10,0"/>
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ImageInfoMegapixels}" FontSize="10" HorizontalAlignment="Right"
                           TextTrimming="CharacterEllipsis" Foreground="{DynamicResource FgPrimary}" FontFamily="{StaticResource MonoFont}"/>
                <TextBlock Grid.Row="2" Grid.Column="0" Text="{Binding [PropAspect], Source={x:Static svc:Loc.Instance}}" FontSize="10"
                           Foreground="{DynamicResource FgMuted}" Margin="0,0,10,0"/>
                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding ImageInfoAspect}" FontSize="10" HorizontalAlignment="Right"
                           TextTrimming="CharacterEllipsis" Foreground="{DynamicResource FgPrimary}" FontFamily="{StaticResource MonoFont}"/>
                <TextBlock Grid.Row="3" Grid.Column="0" Text="{Binding [PropFileSize], Source={x:Static svc:Loc.Instance}}" FontSize="10"
                           Foreground="{DynamicResource FgMuted}" Margin="0,0,10,0"/>
                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding ImageInfoSize}" FontSize="10" HorizontalAlignment="Right"
                           TextTrimming="CharacterEllipsis" Foreground="{DynamicResource FgPrimary}" FontFamily="{StaticResource MonoFont}"/>
                <TextBlock Grid.Row="4" Grid.Column="0" Text="{Binding [PropModified], Source={x:Static svc:Loc.Instance}}" FontSize="10"
                           Foreground="{DynamicResource FgMuted}" Margin="0,0,10,0"/>
                <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding ImageInfoDate}" FontSize="10" HorizontalAlignment="Right"
                           TextTrimming="CharacterEllipsis" Foreground="{DynamicResource FgPrimary}" FontFamily="{StaticResource MonoFont}"/>
                </Grid>
              </StackPanel>
            </Border>

            <TextBlock Text="{Binding [PropStoneHint], Source={x:Static svc:Loc.Instance}}" FontSize="11" TextWrapping="Wrap" Margin="2,0"
                       Foreground="{DynamicResource FgMuted}" IsVisible="{Binding ShowStoneHint}"/>
          </StackPanel>

          <StackPanel Margin="8,6" Spacing="10"
                      IsVisible="{Binding HasSelection}">

            <!-- Color Swatch -->
            <StackPanel Spacing="4">
              <DockPanel>
                <!-- Back to the image information -->
                <Button DockPanel.Dock="Right" Click="OnClearSelection" Width="18" Height="16" Padding="0"
                        Background="Transparent" BorderThickness="0" CornerRadius="3" Cursor="Hand"
                        ToolTip.Tip="{Binding [TipClearSelection], Source={x:Static svc:Loc.Instance}}">
                  <PathIcon Width="8" Height="8" Foreground="{DynamicResource FgMuted}"
                            Data="M4.2,2.8 L12,10.6 L19.8,2.8 L21.2,4.2 L13.4,12 L21.2,19.8 L19.8,21.2 L12,13.4 L4.2,21.2 L2.8,19.8 L10.6,12 L2.8,4.2 Z"/>
                </Button>
                <TextBlock Text="{Binding [PropColor], Source={x:Static svc:Loc.Instance}}" Classes="section-title"/>
              </DockPanel>
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Border Width="36" Height="36" CornerRadius="4"
                        Background="{Binding PropColorBrush}"
                        BorderBrush="{DynamicResource BrdrTer}" BorderThickness="1"/>
                <StackPanel VerticalAlignment="Center" Spacing="1">
                  <TextBlock Text="{Binding PropStoneId}" FontSize="12"
                             FontWeight="Bold" Foreground="{DynamicResource FgPrimary}"
                             FontFamily="{StaticResource MonoFont}"/>
                  <TextBlock Text="{Binding PropStoneName}" FontSize="10"
                             Foreground="{DynamicResource FgMuted}"
                             FontFamily="{StaticResource MonoFont}"/>
                </StackPanel>
              </StackPanel>
            </StackPanel>

            <!-- Texture Preview -->
            <StackPanel Spacing="4"
                        IsVisible="{Binding PropTextureBitmap, Converter={x:Static ObjectConverters.IsNotNull}}">
              <TextBlock Text="{Binding [PropTexture], Source={x:Static svc:Loc.Instance}}" Classes="section-title"/>
              <Border Width="80" Height="80" CornerRadius="4"
                      HorizontalAlignment="Left"
                      BorderBrush="{DynamicResource BrdrTer}" BorderThickness="1"
                      ClipToBounds="True">
                <Image Source="{Binding PropTextureBitmap}" Stretch="UniformToFill"/>
              </Border>
              <TextBlock Text="{Binding SelectedStoneText}"
                         FontSize="10" Foreground="{DynamicResource FgSecondary}"
                         FontFamily="{StaticResource MonoFont}"/>
            </StackPanel>

            <!-- Stone Variants -->
            <StackPanel Spacing="4"
                        IsVisible="{Binding PropTextureBitmap, Converter={x:Static ObjectConverters.IsNotNull}}">
              <TextBlock Text="{Binding [PropVariants], Source={x:Static svc:Loc.Instance}}" Classes="section-title"/>
              <ItemsControl ItemsSource="{Binding PropStoneThumbs}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal"/>
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:StoneThumbItem">
                    <Button Click="OnSelectStone" Tag="{Binding Index}"
                            Padding="0" Margin="2" Background="Transparent"
                            BorderThickness="0" CornerRadius="3" Cursor="Hand">
                      <Panel Width="44" Height="44">
                        <Border CornerRadius="3" ClipToBounds="True">
                          <Image Source="{Binding Thumbnail}" Stretch="UniformToFill"/>
                        </Border>
                        <Border CornerRadius="3" BorderThickness="2"
                                BorderBrush="{DynamicResource AccentBorder}"
                                IsVisible="{Binding IsSelected}"/>
                        <Border CornerRadius="3" BorderThickness="1"
                                BorderBrush="{DynamicResource BrdrTer}"
                                IsVisible="{Binding !IsSelected}"/>
                      </Panel>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>

            <!-- RGB -->
            <StackPanel Spacing="3">
              <TextBlock Text="{Binding [PropRgb], Source={x:Static svc:Loc.Instance}}" Classes="section-title"/>
              <TextBlock Text="{Binding PropRgbInfo}" FontSize="12"
                         FontWeight="SemiBold" Foreground="{DynamicResource FgPrimary}"
                         FontFamily="{StaticResource MonoFont}"/>
            </StackPanel>

            <!-- Coordinates -->
            <StackPanel Spacing="3">
              <TextBlock Text="{Binding [PropCoordinate], Source={x:Static svc:Loc.Instance}}" Classes="section-title"/>
              <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto">
                <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding [PropPixel], Source={x:Static svc:Loc.Instance}}"
                           FontSize="10" Foreground="{DynamicResource FgMuted}" Margin="0,0,8,2"/>
                <TextBlock Grid.Row="0" Grid.Column="1"
                           Text="{Binding PropPixelCoord}" FontSize="11"
                           Foreground="{DynamicResource FgIcon}"
                           FontFamily="{StaticResource MonoFont}"/>
                <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding [PropMold], Source={x:Static svc:Loc.Instance}}"
                           FontSize="10" Foreground="{DynamicResource FgMuted}" Margin="0,0,8,0"/>
                <TextBlock Grid.Row="1" Grid.Column="1"
                           Text="{Binding PropMouldCoord}" FontSize="11"
                           Foreground="{DynamicResource FgIcon}"
                           FontFamily="{StaticResource MonoFont}"/>
              </Grid>
            </StackPanel>

            <!-- Edit Info -->
            <StackPanel Spacing="3"
                        IsVisible="{Binding IsPixelEditActive}">
              <TextBlock Text="{Binding [PropEditing], Source={x:Static svc:Loc.Instance}}" Classes="section-title"/>
              <TextBlock Text="{Binding EditedPixelCountText}"
                         FontSize="11" Foreground="{DynamicResource FgIcon}"
                         FontFamily="{StaticResource MonoFont}"/>
              <TextBlock Text="{Binding [PropUndoRedo], Source={x:Static svc:Loc.Instance}}"
                         FontSize="11" Foreground="{DynamicResource FgMuted}" Margin="0,2,0,0"/>
            </StackPanel>

          </StackPanel>
         </StackPanel>
        </ScrollViewer>
      </DockPanel>
    </Border>

    <!-- Folded properties panel: a strip with a show button -->
    <Border Grid.Column="6" Background="{DynamicResource BgBar}"
            BorderBrush="{DynamicResource BrdrMain}" BorderThickness="1,0,0,0"
            IsVisible="{Binding !IsPropertiesPanelOpen}">
      <Button Click="OnTogglePropertiesPanel" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
              HorizontalContentAlignment="Center" VerticalContentAlignment="Top"
              Background="Transparent" BorderThickness="0" CornerRadius="0" Padding="0,8" Cursor="Hand"
              ToolTip.Tip="{Binding [TipPanelShow], Source={x:Static svc:Loc.Instance}}">
        <StackPanel Spacing="10">
          <PathIcon Width="10" Height="10" Foreground="{DynamicResource FgSecondary}" HorizontalAlignment="Center"
                    Data="M15.4,4.6 L8,12 L15.4,19.4 L14,20.8 L5.2,12 L14,3.2 Z"/>
          <LayoutTransformControl HorizontalAlignment="Center">
            <LayoutTransformControl.LayoutTransform>
              <RotateTransform Angle="90"/>
            </LayoutTransformControl.LayoutTransform>
            <TextBlock Text="{Binding [PropTitle], Source={x:Static svc:Loc.Instance}}" FontSize="11" FontWeight="SemiBold"
                       Foreground="{DynamicResource FgMuted}"/>
          </LayoutTransformControl>
        </StackPanel>
      </Button>
    </Border>

    <!-- Notice at the bottom right (closes by itself after 7 s; the count stops while the pointer is over it):
         a new image in Downloads / on the Desktop (open it?), or a file just written by an export, a screenshot or
         a project save (open it / show it in its folder). -->
    <Border x:Name="toastPanel" Grid.Column="0" Grid.ColumnSpan="7" IsVisible="False"
            HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,12,12" Width="300"
            Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BrdrTer}" BorderThickness="1"
            CornerRadius="8" ClipToBounds="True" BoxShadow="0 8 24 0 #66000000"
            PointerEntered="OnToastPointerEntered" PointerExited="OnToastPointerExited">
      <StackPanel>
        <Grid ColumnDefinitions="Auto,*,Auto" Margin="10,10,6,8">
          <Border Grid.Column="0" Width="56" Height="56" CornerRadius="4" ClipToBounds="True" VerticalAlignment="Top"
                  Background="{DynamicResource BgCanvas}" Margin="0,0,10,0">
            <Image x:Name="toastThumb" Stretch="UniformToFill"/>
          </Border>
          <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
            <TextBlock x:Name="toastTitle" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentText}"/>
            <TextBlock x:Name="toastName" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource FgPrimary}"
                       TextTrimming="CharacterEllipsis"/>
            <TextBlock x:Name="toastInfo" FontSize="11" Foreground="{DynamicResource FgSecondary}"
                       TextTrimming="CharacterEllipsis"/>
          </StackPanel>
          <Button Grid.Column="2" Click="OnToastDismiss" Width="20" Height="20" Padding="0" VerticalAlignment="Top"
                  Background="Transparent" BorderThickness="0" CornerRadius="3" Cursor="Hand"
                  ToolTip.Tip="{Binding [ToastDismiss], Source={x:Static svc:Loc.Instance}}">
            <PathIcon Width="8" Height="8" Foreground="{DynamicResource FgMuted}"
                      Data="M4.2,2.8 L12,10.6 L19.8,2.8 L21.2,4.2 L13.4,12 L21.2,19.8 L19.8,21.2 L12,13.4 L4.2,21.2 L2.8,19.8 L10.6,12 L2.8,4.2 Z"/>
          </Button>
        </Grid>
        <DockPanel Margin="10,0,10,10">
          <TextBlock x:Name="toastSeconds" DockPanel.Dock="Left" VerticalAlignment="Center" FontSize="11"
                     Foreground="{DynamicResource FgMuted}" FontFamily="{StaticResource MonoFont}"/>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="6">
            <Button x:Name="toastSecondary" Click="OnToastSecondary" Height="28" Padding="12,0"
                    FontSize="11" VerticalContentAlignment="Center" CornerRadius="4"
                    Background="{DynamicResource BgHover}" Foreground="{DynamicResource FgPrimary}"/>
            <Button x:Name="toastPrimary" Click="OnToastPrimary" Height="28" Padding="16,0"
                    FontSize="11" VerticalContentAlignment="Center" Classes="primary"/>
          </StackPanel>
        </DockPanel>
        <!-- Time left -->
        <ProgressBar x:Name="toastBar" Height="3" MinHeight="3" Maximum="100" Value="100" CornerRadius="0"
                     Foreground="{DynamicResource AccentFill}" Background="Transparent"/>
      </StackPanel>
    </Border>
    </Grid>

  </DockPanel>
</Window>
