<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="mosair.Controls.AlertDialog"
        Title=""
        Width="420" SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgCard}"
        ExtendClientAreaToDecorationsHint="False">

  <Border Padding="24" Background="{DynamicResource BgCard}">
    <StackPanel Spacing="16">
      <!-- Title -->
      <TextBlock x:Name="TitleText"
                 FontSize="16" FontWeight="SemiBold"
                 Foreground="{DynamicResource FgPrimary}"/>

      <!-- Message: long reports (e.g. Stoğa göre on a large mosaic) scroll and can be selected and copied -->
      <ScrollViewer MaxHeight="460" HorizontalScrollBarVisibility="Disabled">
        <SelectableTextBlock x:Name="MessageText"
                             FontSize="13" TextWrapping="Wrap"
                             Foreground="{DynamicResource FgMenu}"
                             LineHeight="20"/>
      </ScrollViewer>

      <!-- OK Button -->
      <Button x:Name="OkButton"
              Content="Tamam"
              HorizontalAlignment="Right"
              MinWidth="90" Height="34"
              FontSize="13" FontWeight="Medium"
              Background="#3a7bfd" Foreground="#ffffff"
              CornerRadius="4"
              Click="OnOkClick"/>
    </StackPanel>
  </Border>
</Window>
