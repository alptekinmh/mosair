<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:svc="using:mosair.Services"
        x:Class="mosair.HelpWindow"
        Title="{Binding [MenuUserGuide], Source={x:Static svc:Loc.Instance}}"
        Width="720" Height="680"
        MinWidth="500" MinHeight="400"
        Background="{DynamicResource BgMain}"
        WindowStartupLocation="CenterOwner"
        CanResize="True">

  <Window.Styles>
    <Style Selector="TextBlock.h1">
      <Setter Property="FontSize" Value="20"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Foreground" Value="#4ecb71"/>
      <Setter Property="Margin" Value="0,16,0,8"/>
    </Style>
    <Style Selector="TextBlock.h2">
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Foreground" Value="{DynamicResource FgPrimary}"/>
      <Setter Property="Margin" Value="0,14,0,4"/>
    </Style>
    <Style Selector="TextBlock.body">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Foreground" Value="{DynamicResource FgIcon}"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="LineHeight" Value="20"/>
    </Style>
    <Style Selector="TextBlock.shortcut-key">
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Foreground" Value="#1a1a1e"/>
      <Setter Property="Background" Value="#9898a0"/>
      <Setter Property="Padding" Value="4,1"/>
      <Setter Property="Margin" Value="0,0,4,0"/>
    </Style>
    <Style Selector="TextBlock.shortcut-desc">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Foreground" Value="{DynamicResource FgIcon}"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="Border.section-card">
      <Setter Property="Background" Value="{DynamicResource BgPanel}"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Padding" Value="14,10"/>
      <Setter Property="Margin" Value="0,4,0,4"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BrdrMain}"/>
      <Setter Property="BorderThickness" Value="1"/>
    </Style>
    <Style Selector="Border.icon-badge">
      <Setter Property="Width" Value="28"/>
      <Setter Property="Height" Value="28"/>
      <Setter Property="CornerRadius" Value="6"/>
      <Setter Property="Padding" Value="4"/>
    </Style>
  </Window.Styles>

  <DockPanel>
    <!-- Header -->
    <Border DockPanel.Dock="Top" Background="{DynamicResource BgPanel}" Padding="20,14"
            BorderBrush="{DynamicResource BrdrMain}" BorderThickness="0,0,0,1">
      <StackPanel Orientation="Horizontal" Spacing="12">
        <Border Width="36" Height="36" CornerRadius="8" Background="#4ecb71" Padding="6">
          <PathIcon Width="24" Height="24" Foreground="#1a1a1e"
                    Data="M3,3 L3,10 L10,10 L10,3 Z M5,5 L8,5 L8,8 L5,8 Z M3,14 L3,21 L10,21 L10,14 Z M5,16 L8,16 L8,19 L5,19 Z M14,3 L14,10 L21,10 L21,3 Z M16,5 L19,5 L19,8 L16,8 Z M14,14 L14,21 L21,21 L21,14 Z M16,16 L19,16 L19,19 L16,19 Z"/>
        </Border>
        <StackPanel VerticalAlignment="Center">
          <!-- TR Header -->
          <TextBlock Text="mosair Kullanim Kilavuzu" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource FgPrimary}"
                     IsVisible="{Binding IsTr, Source={x:Static svc:Loc.Instance}}"/>
          <TextBlock Text="Mozaik Tas Uretim Sistemi — Musteri Uygulamasi" FontSize="11" Foreground="{DynamicResource FgMuted}"
                     IsVisible="{Binding IsTr, Source={x:Static svc:Loc.Instance}}"/>
          <!-- EN Header -->
          <TextBlock Text="mosair User Guide" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource FgPrimary}"
                     IsVisible="{Binding IsEn, Source={x:Static svc:Loc.Instance}}"/>
          <TextBlock Text="Mosaic Stone Production System — Client Application" FontSize="11" Foreground="{DynamicResource FgMuted}"
                     IsVisible="{Binding IsEn, Source={x:Static svc:Loc.Instance}}"/>
        </StackPanel>
      </StackPanel>
    </Border>

    <!-- Sidebar navigation - TR -->
    <Border DockPanel.Dock="Left" Width="160" Background="{DynamicResource BgBar}"
            BorderBrush="{DynamicResource BrdrMain}" BorderThickness="0,0,1,0">
      <Panel>
      <!-- TR Nav -->
      <StackPanel Margin="0,8" IsVisible="{Binding IsTr, Source={x:Static svc:Loc.Instance}}">
        <Button Content="Genel Bakis" Tag="0" Click="OnNavClick"
                Background="Transparent" Foreground="{DynamicResource FgIcon}" FontSize="11"
                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                Padding="14,6" BorderThickness="0" CornerRadius="0"/>
        <Button Content="Arayuz Yapisi" Tag="1" Click="OnNavClick"
                Background="Transparent" Foreground="{DynamicResource FgIcon}" FontSize="11"
                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                Padding="14,6" BorderThickness="0" CornerRadius="0"/>
        <Button Content="Klavye Kisayollari" Tag="2" Click="OnNavClick"
                Background="Transparent" Foreground="{DynamicResource FgIcon}" FontSize="11"
                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                Padding="14,6" BorderThickness="0" CornerRadius="0"/>
        <Button Content="Fare Kontrolleri" Tag="3" Click="OnNavClick"
                Background="Transparent" Foreground="{DynamicResource FgIcon}" FontSize="11"
                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                Padding="14,6" BorderThickness="0" CornerRadius="0"/>
        <Button Content="Piksel Duzenleme" Tag="4" Click="OnNavClick"
                Background="Transparent" Foreground="{DynamicResource FgIcon}" FontSize="11"
                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                Padding="14,6" BorderThickness="0" CornerRadius="0"/>
        <Button Content="Optimum Tas Sayisi" Tag="7" Click="OnNavClick"
                Background="Transparent" Foreground="{DynamicResource FgIcon}" FontSize="11"
                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                Padding="14,6" BorderThickness="0" CornerRadius="0"/>
        <Button Content="Stok Yonetimi" Tag="8" Click="OnNavClick"
                Background="Transparent" Foreground="{DynamicResource FgIcon}" FontSize="11"
                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                Padding="14,6" BorderThickness="0" CornerRadius="0"/>
        <Button Content="Proje Yonetimi" Tag="5" Click="OnNavClick"
                Background="Transparent" Foreground="{DynamicResource FgIcon}" FontSize="11"
                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                Padding="14,6" BorderThickness="0" CornerRadius="0"/>
        <Button Content="Ipuclari" Tag="6" Click="OnNavClick"
                Background="Transparent" Foreground="{DynamicResource FgIcon}" FontSize="11"
                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                Padding="14,6" BorderThickness="0" CornerRadius="0"/>
      </StackPanel>
      <!-- EN Nav -->
      <StackPanel Margin="0,8" IsVisible="{Binding IsEn, Source={x:Static svc:Loc.Instance}}">
        <Button Content="Overview" Tag="0" Click="OnNavClick"
                Background="Transparent" Foreground="{DynamicResource FgIcon}" FontSize="11"
                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                Padding="14,6" BorderThickness="0" CornerRadius="0"/>
        <Button Content="Interface Layout" Tag="1" Click="OnNavClick"
                Background="Transparent" Foreground="{DynamicResource FgIcon}" FontSize="11"
                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                Padding="14,6" BorderThickness="0" CornerRadius="0"/>
        <Button Content="Keyboard Shortcuts" Tag="2" Click="OnNavClick"
                Background="Transparent" Foreground="{DynamicResource FgIcon}" FontSize="11"
                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                Padding="14,6" BorderThickness="0" CornerRadius="0"/>
        <Button Content="Mouse Controls" Tag="3" Click="OnNavClick"
                Background="Transparent" Foreground="{DynamicResource FgIcon}" FontSize="11"
                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                Padding="14,6" BorderThickness="0" CornerRadius="0"/>
        <Button Content="Pixel Editing" Tag="4" Click="OnNavClick"
                Background="Transparent" Foreground="{DynamicResource FgIcon}" FontSize="11"
                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                Padding="14,6" BorderThickness="0" CornerRadius="0"/>
        <Button Content="Optimum Stone Count" Tag="7" Click="OnNavClick"
                Background="Transparent" Foreground="{DynamicResource FgIcon}" FontSize="11"
                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                Padding="14,6" BorderThickness="0" CornerRadius="0"/>
        <Button Content="Stock Management" Tag="8" Click="OnNavClick"
                Background="Transparent" Foreground="{DynamicResource FgIcon}" FontSize="11"
                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                Padding="14,6" BorderThickness="0" CornerRadius="0"/>
        <Button Content="Project Management" Tag="5" Click="OnNavClick"
                Background="Transparent" Foreground="{DynamicResource FgIcon}" FontSize="11"
                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                Padding="14,6" BorderThickness="0" CornerRadius="0"/>
        <Button Content="Tips" Tag="6" Click="OnNavClick"
                Background="Transparent" Foreground="{DynamicResource FgIcon}" FontSize="11"
                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                Padding="14,6" BorderThickness="0" CornerRadius="0"/>
      </StackPanel>
      </Panel>
    </Border>

    <!-- Main content -->
    <ScrollViewer x:Name="contentScroll" VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled" Padding="20,0,20,20">
      <Panel>

      <!-- ==================== TURKISH CONTENT ==================== -->
      <StackPanel x:Name="contentPanel" Spacing="2" MaxWidth="500"
                  IsVisible="{Binding IsTr, Source={x:Static svc:Loc.Instance}}">

        <TextBlock x:Name="sec0" Classes="h1" Text="Genel Bakis"/>
        <TextBlock Classes="body"
                   Text="mosair, dogal tas mozaik uretim surecinde kullanilan musteri odakli bir masaustu uygulamadir. Bir gorseli yukleyerek mozaiklestirme islemini baslatin, sonucu inceleyin, piksel bazinda duzenleme yapin ve projenizi kaydedin."/>

        <Border Classes="section-card" Margin="0,8,0,4">
          <StackPanel Spacing="8">
            <TextBlock Classes="h2" Text="Temel Is Akisi" Margin="0"/>
            <StackPanel Spacing="6">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Border Classes="icon-badge" Background="#5C6BC0">
                  <TextBlock Text="1" FontWeight="Bold" Foreground="White" FontSize="14"
                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Text="Gorsel Yukle" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource FgPrimary}"/>
                  <TextBlock Text="PNG, JPG, BMP veya TIFF formatinda gorsel secin" Classes="body" FontSize="11"/>
                </StackPanel>
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Border Classes="icon-badge" Background="#43A047">
                  <TextBlock Text="2" FontWeight="Bold" Foreground="White" FontSize="14"
                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Text="Mozaiklestir (Mos)" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource FgPrimary}"/>
                  <TextBlock Text="Gorseli mozaik tas renklerine donusturun; Optimum aciksa tas sayisi otomatik bulunur, Stoga gore aciksa sonuc stoga sigdirilir" Classes="body" FontSize="11"/>
                </StackPanel>
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Border Classes="icon-badge" Background="#FF8F00">
                  <TextBlock Text="3" FontWeight="Bold" Foreground="White" FontSize="14"
                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Text="Incele ve Duzenle" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource FgPrimary}"/>
                  <TextBlock Text="Sonucu zoom yapin, piksel bazinda renk degistirin" Classes="body" FontSize="11"/>
                </StackPanel>
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Border Classes="icon-badge" Background="#E53935">
                  <TextBlock Text="4" FontWeight="Bold" Foreground="White" FontSize="14"
                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Text="Kaydet / Disa Aktar" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource FgPrimary}"/>
                  <TextBlock Text="Projeyi .mos olarak kaydedin veya PNG/JPEG olarak disari aktarin" Classes="body" FontSize="11"/>
                </StackPanel>
              </StackPanel>
            </StackPanel>
          </StackPanel>
        </Border>

        <TextBlock x:Name="sec1" Classes="h1" Text="Arayuz Yapisi"/>
        <Border Classes="section-card">
          <StackPanel Spacing="4">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Border Width="10" Height="10" CornerRadius="2" Background="#5C6BC0"/>
              <TextBlock Classes="h2" Text="Sol Panel — Renk Yonetimi" Margin="0"/>
            </StackPanel>
            <TextBlock Classes="body" Text="Uc sutunlu yapi: Katalog (tum renk listesi), Palet (indeks sirasi) ve Atanan (kullanilan renkler + piksel sayisi). Her rengin yaninda kucuk doku onizlemesi ve tooltip'te buyuk onizleme gorulur."/>
            <TextBlock Classes="body" Margin="0,4,0,0" Text="Katalogdaki isaretli taslar Mos'ta kullanilabilecek taslardir. Mos'tan sonra sadece kullanilan taslar isaretli kalir. Atanan sutununda sadece mozaikte gercekten kullanilan taslar listelenir."/>
            <TextBlock Classes="body" Margin="0,4,0,0" Text="Bir tasin solundaki kirmizi nokta o tasin stogunun yetmedigini gosterir. Bu noktayi Stok Cek (kirmiziyla isaretle secenegi), Stok Kontrol ve stogu hala yetmeyen tas birakan bir Stoga gore Mos koyar; yeni bir Mos eski noktalari siler. Tasin doku resminin uzerine gelince ipucunda buyuk onizleme ve stok gorunur: okun solunda elimizdeki kg (Bizdeki), saginda mozaikten sonra kalacak kg; 0 veya alti kirmizi, ustu yesil."/>
            <TextBlock Classes="body" Margin="0,4,0,0" Text="Sol panelin ustunde genislik (cm) kutusu bulunur; Enter ile ya da kutudan cikinca uygulanir. Bir tas 1,2 cm'dir, deger en yakin tas sayisina yuvarlanir. Altinda gercek olcu ve alan, tas sayisi, kalip sayisi (26x26 tas) ve orijinal gorselin piksel olcusu yazar. Gorsel istenen genislik icin yetersizse Cozunurluk Yetersiz uyarisi cikar. Tum Renkleri Sec / Kaldir dugmeleri butun katalogu isaretler ya da isaretleri kaldirir."/>
          </StackPanel>
        </Border>
        <Border Classes="section-card">
          <StackPanel Spacing="4">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Border Width="10" Height="10" CornerRadius="2" Background="#AB47BC"/>
              <TextBlock Classes="h2" Text="Ust — Menu ve Toolbar" Margin="0"/>
            </StackPanel>
            <TextBlock Classes="body" Text="Toolbar soldan saga: Gorsel Yukle, Proje Ac, Kaydet, Farkli Kaydet, Mos, Piksel Duzenle, Izgara (ve rengi), Interpolasyon, Google Drive ikonu (tiklayinca Drive'a Kaydet; yanindaki okta Drive'dan Ac ve Drive Klasoru Ayarlari), bes stok ikonu (stok tablosu ve Stok Cek ikonlarinin yaninda birer ok), Optimum ve Stoga gore kutulari, Optimum ile yapilan Mos sonrasi gorunen Tas kaydiricisi. Sagda Ekran goruntusu (kamera: gorsel alaninda o an gorunen kismi PNG olarak mosairEXPORT klasorune kaydeder; mini harita ve kaydirma cubuklari girmez), Disa Aktar (tiklayinca mosairEXPORT / mosairEXPORT As listesi acilir), tema (koyu/acik) ve dil (TR/EN) dugmeleri bulunur. Dugmelerin uzerine gelince kisa ipucu cikar."/>
            <TextBlock Classes="body" Margin="0,4,0,0" Text="Paneller arasindaki ayiricilari surukleyerek genisliklerini degistirebilirsiniz. Baslik cubuguna cift tiklamak pencereyi buyutur veya eski boyutuna dondurur. Baslik cubugunun ortasinda acik dosyanin adi yazar: gorsel yuklenince fotografin adi, proje kaydedilince veya acilinca projenin adi."/>
            <TextBlock Classes="body" Margin="0,4,0,0" Text="Ay/gunes dugmesi koyu ve acik tema arasinda gecer; dunya dugmesi dili Turkce / English yapar ve menuler, ipuclari ve bu kilavuz aninda degisir. Ikisi de kalici degildir: uygulama koyu tema ve Turkce ile acilir."/>
            <TextBlock Classes="body" Margin="0,4,0,0" Text="Uyarilar kucuk bir pencerede cikar ve Anladim ile kapanir. Tabloyu degistiren stok islemleri once Evet / Hayir ile onay ister."/>
            <TextBlock Classes="body" Margin="0,4,0,0" Text="Araclar menusu toolbar'daki tum araclari icerir: Mozaiklestir, Piksel Duzenle, Izgara Goster, Izgara Rengi, Interpolasyon Yontemi, Optimum Tas Sayisi, Stoga Gore Ayarla, Tas Sayisi ve Stok. Acik olan secenekler ✓ ile isaretlidir; menu ve toolbar her zaman ayni durumu gosterir. Tas Sayisi yalnizca Optimum ile yapilan Mos'tan sonra, Stok ise bir stok islemi surmuyorken kullanilabilir."/>
            <TextBlock Classes="body" Margin="0,4,0,0" Text="Dosya menusu: Gorsel Yukle, Proje Ac, Proje Kaydet, Proje Farkli Kaydet, mosairEXPORT ve mosairEXPORT As (ikisi de goruntu kalitesi seceneklerini acar), Ekran Goruntusu Al (kamera ikonuyla ayni), Yeni Gorselleri Bildir (isaretliyken Indirilenler'e ve Masaustune gelen yeni gorseller icin bildirim cikar), Google Drive (Drive'a Kaydet, Drive'dan Ac, Drive Klasoru Ayarlari). Duzenle: Tum Renkleri Sec / Kaldir ve Islemi Iptal Et (Esc; durum cubugundaki kirmizi Iptal dugmesiyle ayni, yalnizca iptal edilebilen bir is surerken etkin). Gorunum: Ekrana Sigdir, Yumusak Fare Hareketi (acikken tekerlekle zoom yumusak bir gecisle yapilir, sag tusla surukleme birakilinca goruntu biraz suzulur; kapaliyken zoom aninda olur), Ozellikler Paneli (F4; sagdaki paneli gizler/gosterir). Yardim: Kullanim Kilavuzu (F1). Kilavuz acikken ana pencere kullanilamaz; ayri bir Hakkinda penceresi yoktur."/>
          </StackPanel>
        </Border>
        <Border Classes="section-card">
          <StackPanel Spacing="4">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Border Width="10" Height="10" CornerRadius="2" Background="#43A047"/>
              <TextBlock Classes="h2" Text="Orta — Canvas (Gorsel Alani)" Margin="0"/>
            </StackPanel>
            <TextBlock Classes="body" Text="Mozaik gorselin goruntulenip duzenledigi ana alandir. Mouse tekerlegi ile zoom yapin (imlecin altindaki nokta yerinde kalir; dokunmatik yuzeyde kucuk adimlar daha az yakinlastirir), sag tus ile surukleyerek pan yapin. Gorunum > Yumusak Fare Hareketi acikken (varsayilan) zoom kisa ve yumusak bir gecisle olur; hizlica surukleyip birakinca goruntu ayni yonde biraz suzulup yavaslayarak durur. Gorsele tiklamak ya da Ekrana Sigdir suzulmeyi durdurur. Gorseli dogrudan surukle-birak ile de yukleyebilirsiniz."/>
            <TextBlock Classes="body" Margin="0,4,0,0" Text="Sag ustte Mini Harita (Navigator) bulunur — buyuk mozaiklerde nerede oldugunuzu gosterir."/>
            <TextBlock Classes="body" Margin="0,4,0,0" Text="Mos'tan sonra tas dokulu goruntu parca parca, yalnizca ekranda gorunen kisim icin cizilir: cok uzaktan taslar kendi renkleriyle gorunur, yakinlastirdikca dokular netlesir. Daha keskin parca hazirlanirken bir bolge kisa bir sure bulanik gorunebilir. Yeterince yakinlastirinca tas fotograflari kendi cozunurluklerinde (tas basina 100 piksel) cizilir; ayri bir detay ayari yoktur. Goruntu boyutu icin sinir yoktur; cok buyuk mozaikler de (or. 20 m) calisir. Izgara ve izgara rengi degisiklikleri aninda uygulanir."/>
            <TextBlock Classes="body" Margin="0,4,0,0" Text="Ekrana Sigdir (durum cubugundaki dugme, Gorunum menusu veya kisayol) gorseli pencereye sigdirir; gorsel yuklenince (Gorsel Yukle, surukle-birak, yeni gorsel bildirimi), Mos ve Proje Ac sonrasi kendiliginden uygulanir. Mos'tan sonra zoom orani tas basina 100 piksellik goruntuye gore hesaplanir; disa aktarilan dosyanin boyutunu etkilemez."/>
          </StackPanel>
        </Border>
        <Border Classes="section-card">
          <StackPanel Spacing="4">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Border Width="10" Height="10" CornerRadius="2" Background="#FF8F00"/>
              <TextBlock Classes="h2" Text="Sag Panel — Properties" Margin="0"/>
            </StackPanel>
            <TextBlock Classes="body" Text="Secili tasin detaylarini gosterir: renk swatch'u, tas kodu, doku onizlemesi, RGB degerleri, piksel ve kalip koordinatlari."/>
            <TextBlock Classes="body" Margin="0,4,0,0" Text="Varyantlar bolumunde bir doku resmine tiklarsaniz o pikseldeki tasin dokusu degisir; bu degisiklik de Geri Al / Yinele ile geri alinabilir."/>
            <TextBlock Classes="body" Margin="0,4,0,0" Text="Tas secili degilken gorselin bilgileri kartlar halinde gorunur: onizleme (kosede dosya turu) ve dosya adi; AYRINTILAR (cozunurluk, megapiksel, en-boy orani, dosya boyutu, degistirilme tarihi); BASKIN RENKLER (renklerin paylarina gore dizildigi renk cubugu ve 6 rengin kodu ile yuzdesi); Mos'tan sonra EN COK KULLANILAN TASLAR (5 tas, yuzdesi, ince bir cubuk ve tas sayisi). RENK basliginin yanindaki x dugmesi tas seciminden gorsel bilgilerine doner."/>
            <TextBlock Classes="body" Margin="0,4,0,0" Text="Gizle / goster: panel basligindaki - dugmesi, F4 ya da Gorunum > Ozellikler Paneli paneli gizler; sag kenarda ince bir serit kalir, seride (ok) tiklayinca panel eski genisligiyle geri acilir. Uygulama her acilista panel acik baslar."/>
          </StackPanel>
        </Border>
        <Border Classes="section-card">
          <StackPanel Spacing="4">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Border Width="10" Height="10" CornerRadius="2" Background="{DynamicResource FgSecondary}"/>
              <TextBlock Classes="h2" Text="Alt — Durum Cubugu" Margin="0"/>
            </StackPanel>
            <TextBlock Classes="body" Text="Solda: kullanilan renk sayisi. Ortada: ilerleme cubugu, islem durumu ve sure. Sagda: Ekrana Sigdir butonu, zoom orani (Zoom=2.0 gibi) ve ekrandaki goruntu boyutu. Acilista ve her gorsel/proje yuklenince stok okuma sonucu, Stoga gore aciksa Mos sonunda stok ozeti de burada yazar. Herhangi bir islem surerken (Mos, stoga gore duzeltme, stok islemleri, Google Drive islemleri, disa aktarma...) cubugun basindan sonuna yesil bir dalga akar; islem bitince soner. Dil degisince mesaj Hazir olur."/>
            <TextBlock Classes="body" Margin="0,4,0,0" Text="Iptal: Mos, stoga gore duzeltme ya da disa aktarma surerken ilerleme cubugunun yaninda bir '✕ Iptal' dugmesi gorunur; Esc ve Duzenle > Islemi Iptal Et ayni isi yapar. Optimum Mos iptal edilirse onceki mozaik oldugu gibi kalir. Klasik Mos iptal edilirse yarim kalan mozaik kaldirilir ve yuklenen gorsel yeniden gosterilir. Mos'ta ya da Tas kaydiricisinda stoga gore duzeltme iptal edilirse mozaik stoga bakilmadan kalir. Stok Kontrol'deki duzeltme iptal edilirse mozaik eski haline doner ve tabloya bir sey yazilmaz. Disa aktarma iptal edilirse yarim dosya silinir. Tas kaydiricisi yalnizca stoga gore duzeltme calisirken iptal edilebilir. Stok tablosu islemleri, Google Drive islemleri ve proje acma iptal edilemez. Isin son adimlarinda (mozaigin yeniden kurulmasi, dokularin hazirlanmasi, disa aktarmada son kodlama) basilan iptal etkisizdir; is normal biter."/>
          </StackPanel>
        </Border>

        <TextBlock x:Name="sec2" Classes="h1" Text="Klavye Kisayollari"/>
        <Border Classes="section-card">
          <StackPanel Spacing="6">
            <TextBlock Text="Dosya" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource FgMuted}" Margin="0,0,0,2"/>
            <StackPanel Orientation="Horizontal"><TextBlock Classes="shortcut-key" Text="{Binding KeyModI, Source={x:Static svc:Loc.Instance}}"/><TextBlock Classes="shortcut-desc" Text="Gorsel yukle"/></StackPanel>
            <StackPanel Orientation="Horizontal"><TextBlock Classes="shortcut-key" Text="{Binding KeyModO, Source={x:Static svc:Loc.Instance}}"/><TextBlock Classes="shortcut-desc" Text="Proje ac (.mos)"/></StackPanel>
            <StackPanel Orientation="Horizontal"><TextBlock Classes="shortcut-key" Text="{Binding KeyModS, Source={x:Static svc:Loc.Instance}}"/><TextBlock Classes="shortcut-desc" Text="Projeyi kaydet"/></StackPanel>
            <StackPanel Orientation="Horizontal"><TextBlock Classes="shortcut-key" Text="{Binding KeyModShiftS, Source={x:Static svc:Loc.Instance}}"/><TextBlock Classes="shortcut-desc" Text="Farkli kaydet"/></StackPanel>
            <StackPanel Orientation="Horizontal"><TextBlock Classes="shortcut-key" Text="{Binding KeyModE, Source={x:Static svc:Loc.Instance}}"/><TextBlock Classes="shortcut-desc" Text="Gorseli disa aktar (varsayilan kaliteyle)"/></StackPanel>
            <Border Height="1" Background="{DynamicResource BrdrMain}" Margin="0,4"/>
            <TextBlock Text="Araclar" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource FgMuted}" Margin="0,0,0,2"/>
            <StackPanel Orientation="Horizontal"><TextBlock Classes="shortcut-key" Text="{Binding KeyModM, Source={x:Static svc:Loc.Instance}}"/><TextBlock Classes="shortcut-desc" Text="Mozaiklestir"/></StackPanel>
            <StackPanel Orientation="Horizontal"><TextBlock Classes="shortcut-key" Text="{Binding KeyMod0, Source={x:Static svc:Loc.Instance}}"/><TextBlock Classes="shortcut-desc" Text="Ekrana sigdir"/></StackPanel>
            <StackPanel Orientation="Horizontal"><TextBlock Classes="shortcut-key" Text="Esc"/><TextBlock Classes="shortcut-desc" Text="Suren islemi iptal et (Mos, stoga gore duzeltme, disa aktarma)"/></StackPanel>
            <Border Height="1" Background="{DynamicResource BrdrMain}" Margin="0,4"/>
            <TextBlock Text="Duzenleme" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource FgMuted}" Margin="0,0,0,2"/>
            <StackPanel Orientation="Horizontal"><TextBlock Classes="shortcut-key" Text="{Binding KeyModZ, Source={x:Static svc:Loc.Instance}}"/><TextBlock Classes="shortcut-desc" Text="Geri al (Undo)"/></StackPanel>
            <StackPanel Orientation="Horizontal"><TextBlock Classes="shortcut-key" Text="{Binding KeyModY, Source={x:Static svc:Loc.Instance}}"/><TextBlock Classes="shortcut-desc" Text="Yinele (Redo); Shift+Z ile birlikte de olur"/></StackPanel>
            <Border Height="1" Background="{DynamicResource BrdrMain}" Margin="0,4"/>
            <TextBlock Text="Yardim" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource FgMuted}" Margin="0,0,0,2"/>
            <StackPanel Orientation="Horizontal"><TextBlock Classes="shortcut-key" Text="F1"/><TextBlock Classes="shortcut-desc" Text="Kullanim kilavuzunu ac"/></StackPanel>
            <StackPanel Orientation="Horizontal"><TextBlock Classes="shortcut-key" Text="F4"/><TextBlock Classes="shortcut-desc" Text="Ozellikler panelini gizle / goster"/></StackPanel>
          </StackPanel>
        </Border>

        <TextBlock x:Name="sec3" Classes="h1" Text="Fare Kontrolleri"/>
        <Border Classes="section-card">
          <StackPanel Spacing="6">
            <TextBlock Text="Canvas Uzerinde" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource FgMuted}" Margin="0,0,0,2"/>
            <StackPanel Orientation="Horizontal"><TextBlock Classes="shortcut-key" Text="Tekerlek"/><TextBlock Classes="shortcut-desc" Text="Zoom (yukari: yakinlastir, asagi: uzaklastir; yumusak gecisle)"/></StackPanel>
            <StackPanel Orientation="Horizontal"><TextBlock Classes="shortcut-key" Text="Sag Tus + Surukle"/><TextBlock Classes="shortcut-desc" Text="Pan (gorselde gezinme)"/></StackPanel>
            <StackPanel Orientation="Horizontal"><TextBlock Classes="shortcut-key" Text="Sol Tus"/><TextBlock Classes="shortcut-desc" Text="Piksel sec / duzenleme"/></StackPanel>
            <StackPanel Orientation="Horizontal"><TextBlock Classes="shortcut-key" Text="Orta Tus"/><TextBlock Classes="shortcut-desc" Text="Piksel duzenleme modunu ac/kapa"/></StackPanel>
            <Border Height="1" Background="{DynamicResource BrdrMain}" Margin="0,4"/>
            <TextBlock Text="Mini Harita" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource FgMuted}" Margin="0,0,0,2"/>
            <StackPanel Orientation="Horizontal"><TextBlock Classes="shortcut-key" Text="Sol Tus"/><TextBlock Classes="shortcut-desc" Text="Tikla veya surukle — o bolgeye git"/></StackPanel>
            <Border Height="1" Background="{DynamicResource BrdrMain}" Margin="0,4"/>
            <TextBlock Text="Katalog" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource FgMuted}" Margin="0,0,0,2"/>
            <StackPanel Orientation="Horizontal"><TextBlock Classes="shortcut-key" Text="Onay Kutusu"/><TextBlock Classes="shortcut-desc" TextWrapping="Wrap" MaxWidth="380" Text="Tasi Mos'a dahil et / cikar"/></StackPanel>
            <StackPanel Orientation="Horizontal"><TextBlock Classes="shortcut-key" Text="Satir"/><TextBlock Classes="shortcut-desc" TextWrapping="Wrap" MaxWidth="380" Text="Piksel duzenleme acikken kaynak rengi sec"/></StackPanel>
            <StackPanel Orientation="Horizontal"><TextBlock Classes="shortcut-key" Text="Ustunde Bekle"/><TextBlock Classes="shortcut-desc" TextWrapping="Wrap" MaxWidth="380" Text="Doku resminde: buyuk onizleme ve stok kg"/></StackPanel>
            <Border Height="1" Background="{DynamicResource BrdrMain}" Margin="0,4"/>
            <TextBlock Text="Toolbar" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource FgMuted}" Margin="0,0,0,2"/>
            <StackPanel Orientation="Horizontal"><TextBlock Classes="shortcut-key" Text="Sol Tus"/><TextBlock Classes="shortcut-desc" TextWrapping="Wrap" MaxWidth="380" Text="Disa aktar ikonunda: mosairEXPORT / mosairEXPORT As listesi, goruntu kalitesi secenekleriyle. Google Drive ikonunda: Drive'a Kaydet."/></StackPanel>
            <StackPanel Orientation="Horizontal"><TextBlock Classes="shortcut-key" Text="Sag Tus"/><TextBlock Classes="shortcut-desc" TextWrapping="Wrap" MaxWidth="380" Text="Stok tablosu ikonunda: Stok Ayarlari. Stok Sil ikonunda: bu / tum mozaik sutunlarini temizle. Disa aktar ikonunda: mosairEXPORT klasorunu ac."/></StackPanel>
            <StackPanel Orientation="Horizontal"><TextBlock Classes="shortcut-key" Text="Ok (▾)"/><TextBlock Classes="shortcut-desc" TextWrapping="Wrap" MaxWidth="380" Text="Google Drive: Drive'a Kaydet / Drive'dan Ac / Drive Klasoru Ayarlari. Stok tablosu: ac / ayarlar. Stok Cek: devre disi birak / kirmiziyla isaretle."/></StackPanel>
            <StackPanel Orientation="Horizontal"><TextBlock Classes="shortcut-key" Text="Ustunde Bekle"/><TextBlock Classes="shortcut-desc" TextWrapping="Wrap" MaxWidth="380" Text="Stoga gore kutusunda: aciklama ve son stok raporu"/></StackPanel>
            <Border Height="1" Background="{DynamicResource BrdrMain}" Margin="0,4"/>
            <TextBlock Text="Pencere" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource FgMuted}" Margin="0,0,0,2"/>
            <StackPanel Orientation="Horizontal"><TextBlock Classes="shortcut-key" Text="Surukle"/><TextBlock Classes="shortcut-desc" TextWrapping="Wrap" MaxWidth="380" Text="Baslik cubugu: pencereyi tasi (cift tik: buyut / eski boyut). Panel ayiricilari: genislik degistir."/></StackPanel>
          </StackPanel>
        </Border>

        <TextBlock x:Name="sec4" Classes="h1" Text="Piksel Duzenleme"/>
        <TextBlock Classes="body" Text="Mozaik uzerinde tekil tas renklerini degistirmenizi saglayan guclu bir aractir."/>
        <Border Classes="section-card" Margin="0,8,0,4">
          <StackPanel Spacing="8">
            <TextBlock Classes="h2" Text="Nasil Kullanilir?" Margin="0"/>
            <StackPanel Spacing="6">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Border Classes="icon-badge" Background="#FF6600"><TextBlock Text="1" FontWeight="Bold" Foreground="White" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Text="Modu Ac" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource FgPrimary}"/>
                  <TextBlock Text="Orta fare tusuna, toolbar'daki kalem ikonuna veya Araclar > Piksel Duzenle'ye basin (once Mos yapilmis olmali). Toolbar'da 'source' turuncu yanar." Classes="body" FontSize="11" TextWrapping="Wrap" MaxWidth="440"/>
                </StackPanel>
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Border Classes="icon-badge" Background="#FF6600"><TextBlock Text="2" FontWeight="Bold" Foreground="White" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Text="Kaynak Rengi Sec" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource FgPrimary}"/>
                  <TextBlock Text="Kullanmak istediginiz renkteki bir tasa sol tiklayin ya da soldaki katalogdan bir tas secin." Classes="body" FontSize="11" TextWrapping="Wrap" MaxWidth="440"/>
                </StackPanel>
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Border Classes="icon-badge" Background="#FF6600"><TextBlock Text="3" FontWeight="Bold" Foreground="White" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Text="Hedef Piksele Uygula" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource FgPrimary}"/>
                  <TextBlock Text="Degistirmek istediginiz tasa sol tiklayin. Renk aninda degisir; ayni kaynakla birden cok tas boyanabilir." Classes="body" FontSize="11" TextWrapping="Wrap" MaxWidth="440"/>
                </StackPanel>
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Border Classes="icon-badge" Background="#FF6600"><TextBlock Text="4" FontWeight="Bold" Foreground="White" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Text="Geri Al / Yinele / Kapat" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource FgPrimary}"/>
                  <TextBlock Text="Geri Al ve Yinele kisayollari duzenlemeleri geri alir. Modu kapatmak icin orta tusa ya da kalem ikonuna tekrar basin." Classes="body" FontSize="11" TextWrapping="Wrap" MaxWidth="440"/>
                </StackPanel>
              </StackPanel>
            </StackPanel>
          </StackPanel>
        </Border>
        <Border Classes="section-card">
          <StackPanel Spacing="4">
            <TextBlock Classes="h2" Text="Bilinmesi Gerekenler" Margin="0"/>
            <TextBlock Classes="body" Text="• Yeni gorsel, yeni Mos, Tas sayisinin degismesi ve Stok Kontrol sirasindaki stoga gore yeniden duzeltme piksel duzenlemelerini sifirlar (stoga gore duzeltme once onay sorar)."/>
            <TextBlock Classes="body" Text="• Geri Al once tas varyanti degisikliklerini, sonra renk duzenlemelerini geri alir."/>
            <TextBlock Classes="body" Text="• Katalogdan secilip mozaigin paletinde olmayan bir tas kullanilirsa, proje kaydedilirken palete eklenir."/>
            <TextBlock Classes="body" Text="• Duzenlenen tas kendi doku varyantiyla, diger taslarla ayni sekilde (izgara dahil) cizilir; ekranda disa aktarilan dosyadakiyle ayni gorunur."/>
          </StackPanel>
        </Border>

        <TextBlock x:Name="sec7" Classes="h1" Text="Optimum Tas Sayisi"/>
        <TextBlock Classes="body" Text="Optimum, gorsel icin kac cesit tas kullanilacagini otomatik bulur. Toolbar'daki 'Optimum' kutusu isaretliyken Mos'a bastiginizda calisir; isareti kaldirirsaniz klasik algoritma kullanilir."/>
        <Border Classes="section-card" Margin="0,8,0,4">
          <StackPanel Spacing="4">
            <TextBlock Classes="h2" Text="Nasil Calisir?" Margin="0"/>
            <TextBlock Classes="body" Text="Once katalogdaki tum isaretli taslarla en iyi sonuc hesaplanir. Sonra goruntuyu en az bozan taslar tek tek cikarilir. Renk farki, detay ve kenarlar ile acik-koyu yapisi gozle fark edilmeyecek kadar korunurken kullanilabilecek en az tas sayisi 'oneri' olarak secilir."/>
          </StackPanel>
        </Border>
        <Border Classes="section-card">
          <StackPanel Spacing="4">
            <TextBlock Classes="h2" Text="Tas Kaydiricisi" Margin="0"/>
            <TextBlock Classes="body" Text="Mos'tan sonra toolbar'da 'Tas' kaydiricisi gorunur ve onerilen degerden baslar. Kaydiricinin degeri kisa bir sure sabit kalinca mozaik secilen tas sayisiyla yeniden kurulur; yaninda onerilen deger yazar."/>
            <TextBlock Classes="body" Margin="0,4,0,0" Text="Daha fazla tas daha zengin detay, daha az tas daha kolay uretim ve daha az stok demektir. Ayni ayar Araclar > Tas Sayisi menusundeki 'Onerilen Degere Don', 'Bir Tas Artir' ve 'Bir Tas Azalt' ile de yapilabilir."/>
          </StackPanel>
        </Border>
        <Border Classes="section-card">
          <StackPanel Spacing="4">
            <TextBlock Classes="h2" Text="Bilinmesi Gerekenler" Margin="0"/>
            <TextBlock Classes="body" Text="• Kaydirici her birakildiginda yapilmis piksel duzenlemeleri sifirlanir."/>
            <TextBlock Classes="body" Text="• Mos'tan sonra katalogda sadece kullanilan taslar isaretli kalir. Katalogda elle degisiklik yapmadiysaniz bir sonraki Optimum Mos, onceki seciminizin tamamindan yeniden baslar."/>
            <TextBlock Classes="body" Text="• Stok islemleriyle devre disi kalan taslar Optimum'un tas havuzundan da cikar."/>
            <TextBlock Classes="body" Text="• Son Mos Stoga gore duzeltildiyse kaydiricidaki her yeni tas sayisi da ayni stoga gore duzeltilir; durum cubugu tablo icin Stok Kontrol'u tekrarlamanizi hatirlatir."/>
            <TextBlock Classes="body" Text="• Acilan projelerde Tas kaydiricisi gorunmez; proje Optimum analizini icermez."/>
          </StackPanel>
        </Border>

        <TextBlock x:Name="sec8" Classes="h1" Text="Stok Yonetimi (Google Sheet)"/>
        <TextBlock Classes="body" Text="Toolbar'daki bes stok ikonu (Interpolasyon ile Optimum arasinda) Google Sheets'teki stok tablosuyla calisir; stok tablosu ve Stok Cek ikonlarinin yaninda birer ok vardir. Ayni islemler Araclar > Stok menusunde de bulunur. Bir stok islemi surerken bu dugmeler pasif olur; stok ayari yapilmamissa uyari cikar."/>
        <Border Classes="section-card" Margin="0,8,0,4">
          <StackPanel Spacing="4">
            <TextBlock Classes="h2" Text="Ilk Kurulum" Margin="0"/>
            <TextBlock Classes="body" Text="Yesil tablo ikonunun yanindaki oka basip Stok Ayarlari'ni secin (ikona sag tiklamak veya Araclar > Stok > Stok Ayarlari da olur) ve Google Sheet ID ile Apps Script URL'yi girin. Bu bilgiler sadece o bilgisayarda saklanir; her bilgisayarda bir kez girilmesi gerekir."/>
            <TextBlock Classes="body" Margin="0,4,0,0" Text="Script URL'yi bilen herkes tabloya yazabilir; bu adresi sadece guvendiginiz kisilerle paylasin."/>
            <TextBlock Classes="body" Margin="0,4,0,0" Text="Ayar penceresinde her alanin altinda aciklama ve girilecek kismi vurgulayan bir ornek vardir. Sheet ID, tablo baglantisinda /d/ ile /edit arasindaki kisimdir; baglantinin tamami da yapistirilabilir. Script URL, tabloda Uzantilar > Apps Komut Dosyasi > Dagit > Dagitimlari yonet'teki Web uygulamasi adresidir ve /exec ile biter. Kaydet ayarlari saklar, Iptal hicbir seyi degistirmez."/>
            <TextBlock Classes="body" Margin="0,4,0,0" Text="Dogru calismasi icin: tablo 'Baglantiya sahip olan herkes' icin en az Goruntuleyen olarak paylasilmali; ilk satirda mos, Bizdeki (kg) ve Tahmini Kalan sutunlari bulunmali; web uygulamasi 'Herkes' erisimiyle dagitilmis olmali. Tabloyu degistiren islemleri once tablonun bir kopyasiyla deneyin."/>
            <TextBlock Classes="body" Margin="0,4,0,0" Text="Uygulama acilirken ve her gorsel ya da proje yuklendiginde tablodaki 'Bizdeki (kg)' degerleri kendiliginden okunur ve katalog ipucunda gorunur; secim degismez. Taslar tablodaki 'mos' numarasiyla (1-124) eslesir."/>
          </StackPanel>
        </Border>
        <Border Classes="section-card">
          <StackPanel Spacing="6">
            <TextBlock Classes="h2" Text="Butonlar" Margin="0"/>
            <StackPanel Orientation="Horizontal"><TextBlock Classes="shortcut-key" Text="Tablo"/><TextBlock Classes="shortcut-desc" TextWrapping="Wrap" MaxWidth="380" Text="Stok tablosunu tarayicida acar. Yanindaki ok: tabloyu ac / stok ayarlari. Tabloyu degistirmez."/></StackPanel>
            <StackPanel Orientation="Horizontal"><TextBlock Classes="shortcut-key" Text="Stok Cek"/><TextBlock Classes="shortcut-desc" TextWrapping="Wrap" MaxWidth="380" Text="'Bizdeki (kg)' degeri 0 veya altinda olan taslarin isaretini kaldirir, stogu olanlari isaretler. Yanindaki oktan 'Stogu olmayanlari kirmiziyla isaretle' secilirse secim degismez, stogu olmayan taslar yalnizca kirmizi noktayla gosterilir. Tabloyu degistirmez."/></StackPanel>
            <StackPanel Orientation="Horizontal"><TextBlock Classes="shortcut-key" Text="Stok Kontrol"/><TextBlock Classes="shortcut-desc" TextWrapping="Wrap" MaxWidth="380" Text="Mozaigin tas adetlerini tablodaki proje sutununa yazar; 'Tahmini Kalan' eksiye dusen taslari kirmizi noktayla isaretler. Ipucunda elimizdeki ve kalacak kg gorunur. Stoga gore aciksa once mozaigi stoga gore denetler (asagiya bakin). Once Mos yapilmis ya da proje acilmis olmalidir. Tabloyu degistirir."/></StackPanel>
            <StackPanel Orientation="Horizontal"><TextBlock Classes="shortcut-key" Text="Stok Sil"/><TextBlock Classes="shortcut-desc" TextWrapping="Wrap" MaxWidth="380" Text="Bu mozaigin sutununu temizler ve basligini mozaikX yapar. Sag tik: tum mozaik sutunlarini temizler. Onay ister, tabloyu degistirir."/></StackPanel>
            <StackPanel Orientation="Horizontal"><TextBlock Classes="shortcut-key" Text="Stok Ekle"/><TextBlock Classes="shortcut-desc" TextWrapping="Wrap" MaxWidth="380" Text="'Tahmini Kalan' degerlerini 'Bizdeki' sutununa tasir ve tum mozaik sutunlarini temizler. Onay ister, tabloyu degistirir."/></StackPanel>
          </StackPanel>
        </Border>
        <Border Classes="section-card">
          <StackPanel Spacing="4">
            <TextBlock Classes="h2" Text="Stoga Gore" Margin="0"/>
            <TextBlock Classes="body" Text="• Optimum'un yanindaki kutu; uygulama acilirken kapalidir. Araclar > Stoga Gore Ayarla ile de acilip kapanir."/>
            <TextBlock Classes="body" Text="• Acikken Mos (Optimum ya da klasik) once normal yapilir, sonra sonuc stoga sigdirilir. Kullanilabilir stok: Bizdeki (kg) eksi diger mozaik sutunlarinin ayirdigi kg (bu projenin sutunu sayilmaz); 1 tas = 3,3 g."/>
            <TextBlock Classes="body" Text="• Stogu yetmeyen tas elde oldugu kadar kullanilir; kalan yer renkce en yakin stoklu tasla doldurulur. Degisiklikler en az fark edilecek yerlere gider, kenarlar korunur. Gerekirse en fazla 2 yeni tas turu eklenir; yetmezse arama adim adim genisler. Az kullanilan taslar cikarilmaz; stok yeterliyse mozaik degismez."/>
            <TextBlock Classes="body" Text="• Stok uygulama acilirken ve her gorsel ya da proje yuklenince okunur; Stok Cek bu stogu yenilemez. Tabloyu degistirdiyseniz gorseli ya da projeyi yeniden yukleyin. Stok ayari hic yapilmamissa kutu etkisizdir ve Mos her zamanki gibi yapilir; ayar var ama stok okunamazsa Mos stoga bakmadan yapilir ve durum cubugunda yazar."/>
            <TextBlock Classes="body" Text="• Kisa ozet durum cubugunda, ayrintili rapor kutunun ipucunda gorunur: hangi tastan hangisine kac tas (kg) aktarildigi, yeni eklenen tas turleri, aramanin genisletilip genisletilmedigi, stogu hala yetmeyen taslar ve tabloda satiri olmayan taslar. Stogu hala yetmeyen taslara kirmizi nokta konur. Buyuk mozaiklerde ozet durum cubuguna sigmazsa orada yalnizca sayilar kalir; Mos ve Stok Kontrol sonrasinda ayrintili rapor bir pencerede acilir (kaydirilabilir, kopyalanabilir). Tas kaydiricisi oynatilinca pencere acilmaz, ayrintilar ipucundadir."/>
            <TextBlock Classes="body" Text="• Tas kaydiricisi degisince yeni tas sayisi da ayni stoga gore duzeltilir."/>
            <TextBlock Classes="body" Text="• Stok Kontrol yazmadan once stogu yeniden okur. Mozaik sigiyorsa oldugu gibi yazar. Sigmiyorsa once yeniden duzeltir ve duzeltilmis adetleri tek seferde yazar; piksel duzenlemeleri varsa once onay sorar, Hayir denirse mevcut adetler yazilir. Acilmis bir projede once bu gorselle Mos yapilmasi istenir ve Stok Kontrol normal haliyle devam eder. Duzeltme surerken Iptal (ya da Esc) basilirsa mozaik eski haline doner ve tabloya bir sey yazilmaz."/>
          </StackPanel>
        </Border>
        <Border Classes="section-card">
          <StackPanel Spacing="4">
            <TextBlock Classes="h2" Text="Ornek Akis" Margin="0"/>
            <TextBlock Classes="body" Text="Stoga gore acikken: 1. Mos yapin; mozaik stoga gore kurulur.  2. Sonucu ve Stoga gore ipucundaki raporu inceleyin.  3. Stok Kontrol ile adetleri tabloya yazin.  4. Uretimden sonra Stok Ekle ile kalan stogu tabloya isleyin."/>
            <TextBlock Classes="body" Margin="0,4,0,0" Text="Stoga gore kapaliyken (varsayilan): 1. Stok Cek ile stogu biten taslari devre disi birakin.  2. Mos yapin.  3. Stok Kontrol ile adetleri tabloya yazin.  4. Kirmizi noktali taslar varsa onlari devre disi birakip tekrar Mos yapin ve kontrolu tekrarlayin.  5. Uretimden sonra Stok Ekle ile kalan stogu tabloya isleyin."/>
            <TextBlock Classes="body" Margin="0,4,0,0" Text="Tablodaki sutun adi gorsel dosyasinin adidir; ornegin 7.jpg icin '7'. Gorsel bilinmiyorsa acilan .mos dosyasinin adi kullanilir."/>
          </StackPanel>
        </Border>

        <TextBlock x:Name="sec5" Classes="h1" Text="Proje Yonetimi"/>
        <Border Classes="section-card">
          <StackPanel Spacing="4">
            <TextBlock Classes="h2" Text=".mos Proje Dosyasi" Margin="0"/>
            <TextBlock Classes="body" Text="Mozaiklestirme sonucu, renk atamalari, katalog secimi, piksel duzenlemeleri, tas varyantlari ve ayarlar (genislik, izgara, interpolasyon) .mos formatinda kaydedilir. Kaydet, projeyi Masaustu/mosairPROJECT klasorunde gorsel adiyla acilan klasore yazar ve gorseli yanina kopyalar; Farkli Kaydet secilen adla bir klasor acar. Kaydetme ve acma arka planda yapilir, pencere donmaz: durum cubugunda 'Proje kaydediliyor' / 'Proje aciliyor' yazar ve dalga akar. Kaydet'e basildigi andaki mozaik yazilir; dosya once gecici adla yazilip sonra yerine konur, yarida kalan bir kayit eski projeyi bozmaz. Bir kayit surerken Kaydet dugmeleri pasiftir. Optimum analizi ve stok bilgisi kaydedilmez. mosair'de kaydedilen projeler WPF uygulamasinda da acilabilir; WPF'te JSON olarak kaydedilen projeler de mosair'de acilir. Eski WPF surumlerinin binary .mos dosyalari once guncel WPF'te acilip yeniden kaydedilmelidir."/>
            <StackPanel Orientation="Horizontal" Spacing="2" Margin="0,6,0,0">
              <TextBlock FontSize="12" Foreground="{DynamicResource FgMuted}" Text="Kaydetme: "/><TextBlock FontSize="12" Foreground="{DynamicResource FgMuted}" Text="{Binding KeyModS, Source={x:Static svc:Loc.Instance}}"/>
              <TextBlock FontSize="12" Foreground="{DynamicResource FgMuted}" Text=" | Farkli Kaydet: "/><TextBlock FontSize="12" Foreground="{DynamicResource FgMuted}" Text="{Binding KeyModShiftS, Source={x:Static svc:Loc.Instance}}"/>
              <TextBlock FontSize="12" Foreground="{DynamicResource FgMuted}" Text=" | Acma: "/><TextBlock FontSize="12" Foreground="{DynamicResource FgMuted}" Text="{Binding KeyModO, Source={x:Static svc:Loc.Instance}}"/>
            </StackPanel>
            <TextBlock Classes="h2" Text="Google Drive" Margin="0,10,0,0"/>
            <TextBlock Classes="body" Text="Projeler, orijinal gorselleriyle birlikte bir Google Drive klasorune kaydedilip oradan acilabilir. Toolbar'daki renkli Drive ikonu (Interpolasyon'dan sonra, yesil stok tablosu ikonunun solunda) Drive'a Kaydet'tir; yanindaki okta ve Dosya > Google Drive menusunde Drive'a Kaydet, Drive'dan Ac ve Drive Klasoru Ayarlari vardir. Uygulamada Google'a giris yapilmaz: klasorun sahibinin bir kez kurdugu bir Apps Script web uygulamasi Drive'a yazar ve okur."/>
            <TextBlock Classes="body" Margin="0,4,0,0" Text="Kurulum (bir kez): Drive Klasoru Ayarlari'nda Script kodunu kopyala'ya basin; script.google.com'da yeni projeye yapistirip kaydedin; Dagit > Yeni dagitim > Web uygulamasi (Yuruten: Ben, Erisimi olan: Herkes); /exec ile biten adresi Apps Script URL alanina, Drive klasorunun baglantisini klasor alanina yapistirin (baglantinin tamami olur, klasor kimligi kendiliginden ayrilir); Baglantiyi dene ile klasor adini gorun ve Kaydet'e basin. Ayarlar yalnizca bu bilgisayarda (drive.json) saklanir. Ayar yokken bir Drive islemi secilirse uyari cikar ve ayar penceresi acilir."/>
            <TextBlock Classes="body" Margin="0,4,0,0" Text="Drive'a Kaydet: once Mos yapilmis ya da proje acilmis olmalidir. Klasor duzeni Kaydet (mosairPROJECT) ile aynidir: Drive klasorunun icinde gorsel adinda bir proje klasoru, icinde gorsel adi.mos ve orijinal gorsel (gorsel yalnizca o klasorde henuz yoksa gonderilir). Ayni adli proje varsa eskisi Drive cop kutusuna tasinir. Acik dosyanin adi ve yerel kayit degismez. Drive'dan Ac: Drive'a benzeyen bir proje tarayicisi acilir; her proje, orijinal gorselin kucuk resmi, adi, tarihi ve boyutuyla bir karttir. Proje ara kutusu (proje ya da klasor adinda arar), siralama (En yeni ustte / Ada gore), Yenile ve klasoru tarayicida acan Drive'da goster dugmeleri vardir. Bir karta cift tiklayin ya da secip Ac'a basin; proje gorseliyle birlikte bilgisayara indirilip Proje Ac gibi acilir ve pencereye sigdirilir."/>
            <TextBlock Classes="body" Margin="0,4,0,0" Text="Guvenlik ve sinirlar: Script adresini bilen herkes klasore yazip okuyabilir; adresi yalnizca guvendiginiz kisilerle paylasin. Script ozelliklerine ALLOWED_FOLDERS (virgulle klasor kimlikleri) eklenirse script yalnizca bu klasorlerle calisir. Projeler sikistirilarak gonderilir, ama Google cok buyuk istekleri (yaklasik 50 MB) kabul etmez. Drive islemleri surerken durum cubugundaki dalga akar ve islem iptal edilemez. Uygulama guncellenince script'i de guncelleyin: Script kodunu kopyala, script.google.com'da eski kodun yerine yapistirip kaydedin, Dagit > Dagitimlari yonet > kalem > Surum: Yeni surum > Dagit (adres degismez; yeni dagitim olusturmayin). Eski script'le proje klasorun kokune yazilir, gorsel gitmez ve onizleme gorunmez."/>
          </StackPanel>
        </Border>
        <Border Classes="section-card">
          <StackPanel Spacing="4">
            <TextBlock Classes="h2" Text="Disa Aktarma" Margin="0"/>
            <TextBlock Classes="body" Text="Mozaik sonucunu (ekrandaki gercek tas dokulu goruntu) dosyaya kaydeder. Disa aktar ikonuna tiklayinca bir liste acilir: mosairEXPORT ve mosairEXPORT As. Ikisinde de once 'Goruntu kalitesi seciniz' basligi ve 10 goruntu kalitesi secenegi vardir; her secenek yalnizca goruntunun piksel boyutunu ve tahmini dosya boyutunu gosterir (or. 13.333 × 23.688 px · JPEG ≈ 420 MB). Varsayilan secenekte (varsayilan) yazar. Dosya boyutlari liste acilinca hesaplanir; hazir olmayan secenekte hesaplaniyor yazar. Ayni secenekler Dosya menusundeki mosairEXPORT ve mosairEXPORT As altinda da vardir."/>
            <TextBlock Classes="body" Margin="0,4,0,0" Text="mosairEXPORT secilen kaliteyle Masaustu/mosairEXPORT klasorune kaydeder; dosya adi tarih, saat, gorsel adi ve cm olculerini icerir. JPEG mumkunse ve bellege sigarsa JPEG, degilse PNG yazar. mosairEXPORT As konum ve bicim (JPEG/PNG) sorar. Ctrl/⌘+E listeyi acmadan varsayilan kaliteyle mosairEXPORT yapar. Grid aciksa gridli olarak kaydedilir. Disa aktar ikonuna sag tiklamak mosairEXPORT klasorunu acar."/>
            <TextBlock Classes="body" Margin="0,4,0,0" Text="Boyut siniri yoktur; goruntu her zaman secilen goruntu kalitesiyle kaydedilir, kendiliginden kucultulmez. Daha kucuk dosya icin daha dusuk bir goruntu kalitesi secin. Tas goruntuleri yuklu degilse her tas kendi renginde, ayni boyutta cizilir. Tek sinir JPEG'in kendisidir: kenar basina en fazla 65.535 piksel; daha buyuk goruntu icin PNG ya da daha dusuk bir kalite secin. Buyuk PNG parca parca yazilir ve az bellek kullanir; buyuk JPEG yaklasik genislik × yukseklik × 4 bayt bellek ister. Bu yuzden mosairEXPORT bellek yetmeyecekse PNG kaydeder; mosairEXPORT As ile boyle bir JPEG secilirse once sorulur (Evet: yine de JPEG, Hayir: vazgec). Buyuk dosyalarda durum cubugu ilerlemeyi yuzde olarak gosterir. Disa aktarma durum cubugundaki Iptal dugmesiyle ya da Esc ile kesilebilir. Yarim kalan ya da iptal edilen dosya silinir. Ornek: 20 m'lik bir mozaik 66.680 × 66.680 px'lik PNG olarak yaklasik 26 saniyede 2,8 GB olur. Disa aktarma basladigi andaki mozaigi yazar; bu sirada yapilan duzenlemeler dosyaya girmez."/>
          </StackPanel>
        </Border>

        <TextBlock x:Name="sec6" Classes="h1" Text="Ipuclari"/>
        <Border Classes="section-card">
          <StackPanel Spacing="6">
            <StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="&#x1F4A1;" FontSize="16" VerticalAlignment="Top"/><TextBlock Classes="body" Text="Genislik (cm) degerini degistirdikten sonra Enter'a basin — boyut bilgileri otomatik guncellenir."/></StackPanel>
            <Border Height="1" Background="{DynamicResource BgCard}"/>
            <StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="&#x1F4A1;" FontSize="16" VerticalAlignment="Top"/><TextBlock Classes="body" Text="Ctrl/⌘+E varsayilan kaliteyle disa aktarir; listede bu secenekte (varsayilan) yazar. Ekrandaki zoom dosyayi etkilemez. Yuksek goruntu kalitesi dosyayi buyutur ve disa aktarmayi yavaslatir."/></StackPanel>
            <Border Height="1" Background="{DynamicResource BgCard}"/>
            <StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="&#x1F4A1;" FontSize="16" VerticalAlignment="Top"/><TextBlock Classes="body" Text="Gorseli dogrudan dosya yoneticisinden surukleyip uygulamaya birakin."/></StackPanel>
            <Border Height="1" Background="{DynamicResource BgCard}"/>
            <StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="&#x1F4A1;" FontSize="16" VerticalAlignment="Top"/><TextBlock Classes="body" Text="Indirilenler'e ya da Masaustune yeni bir JPEG/PNG gelince sag altta 'mosair'de acilsin mi?' bildirimi cikar; Ac ile gorsel yuklenip pencereye sigdirilir. Bildirim 7 sn sonra kendiliginden kapanir; fare uzerindeyken sure durur. Alt klasorler izlenmez. Dosya > Yeni Gorselleri Bildir ile kapatilabilir."/></StackPanel>
            <Border Height="1" Background="{DynamicResource BgCard}"/>
            <StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="&#x1F4A1;" FontSize="16" VerticalAlignment="Top"/><TextBlock Classes="body" Text="Mini haritayi kullanarak buyuk mozaiklerde hizlica gezinin."/></StackPanel>
            <Border Height="1" Background="{DynamicResource BgCard}"/>
            <StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="&#x1F4A1;" FontSize="16" VerticalAlignment="Top"/><TextBlock Classes="body" Text="Renkli bir gorselde Optimum'un sonucu fazla sade geldiyse Tas kaydiricisini birkac adim artirin; detay ve renk cesitliligi artar."/></StackPanel>
            <Border Height="1" Background="{DynamicResource BgCard}"/>
            <StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="&#x1F4A1;" FontSize="16" VerticalAlignment="Top"/><TextBlock Classes="body" Text="Belirli bir tasi hic kullanmak istemiyorsaniz katalogda isaretini kaldirip Mos yapin; Optimum sadece isaretli taslar arasindan secer."/></StackPanel>
            <Border Height="1" Background="{DynamicResource BgCard}"/>
            <StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="&#x1F4A1;" FontSize="16" VerticalAlignment="Top"/><TextBlock Classes="body" Text="Stok tablosu ayarlanmamissa Stoga gore kutusu hicbir sey yapmaz; kutuyu kapatmaniza gerek yoktur."/></StackPanel>
          </StackPanel>
        </Border>
        <Border Height="20"/>
      </StackPanel>

      <!-- ==================== ENGLISH CONTENT ==================== -->
      <StackPanel x:Name="contentPanelEn" Spacing="2" MaxWidth="500"
                  IsVisible="{Binding IsEn, Source={x:Static svc:Loc.Instance}}">

        <TextBlock x:Name="sec0en" Classes="h1" Text="Overview"/>
        <TextBlock Classes="body"
                   Text="mosair is a client desktop application used in the natural stone mosaic production process. Load an image to start the mosaicization process, review the result, make pixel-level edits, and save your project."/>

        <Border Classes="section-card" Margin="0,8,0,4">
          <StackPanel Spacing="8">
            <TextBlock Classes="h2" Text="Basic Workflow" Margin="0"/>
            <StackPanel Spacing="6">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Border Classes="icon-badge" Background="#5C6BC0"><TextBlock Text="1" FontWeight="Bold" Foreground="White" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Text="Load Image" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource FgPrimary}"/>
                  <TextBlock Text="Select an image in PNG, JPG, BMP, or TIFF format" Classes="body" FontSize="11"/>
                </StackPanel>
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Border Classes="icon-badge" Background="#43A047"><TextBlock Text="2" FontWeight="Bold" Foreground="White" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Text="Mosaicize (Mos)" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource FgPrimary}"/>
                  <TextBlock Text="Convert the image to mosaic stone colors; with Optimum on, the stone count is found automatically, and with By stock on, the result is fitted to stock" Classes="body" FontSize="11"/>
                </StackPanel>
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Border Classes="icon-badge" Background="#FF8F00"><TextBlock Text="3" FontWeight="Bold" Foreground="White" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Text="Review and Edit" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource FgPrimary}"/>
                  <TextBlock Text="Zoom into the result, change colors at pixel level" Classes="body" FontSize="11"/>
                </StackPanel>
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Border Classes="icon-badge" Background="#E53935"><TextBlock Text="4" FontWeight="Bold" Foreground="White" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Text="Save / Export" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource FgPrimary}"/>
                  <TextBlock Text="Save as .mos project or export as PNG/JPEG" Classes="body" FontSize="11"/>
                </StackPanel>
              </StackPanel>
            </StackPanel>
          </StackPanel>
        </Border>

        <TextBlock x:Name="sec1en" Classes="h1" Text="Interface Layout"/>
        <Border Classes="section-card">
          <StackPanel Spacing="4">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Border Width="10" Height="10" CornerRadius="2" Background="#5C6BC0"/>
              <TextBlock Classes="h2" Text="Left Panel — Color Management" Margin="0"/>
            </StackPanel>
            <TextBlock Classes="body" Text="Three-column layout: Catalog (full color list), Palette (index order), and Assigned (used colors + pixel count). Each color shows a small texture preview with a larger tooltip preview."/>
            <TextBlock Classes="body" Margin="0,4,0,0" Text="Checked catalog stones are the ones Mos may use. After a Mos, only the stones actually used stay checked. The Assigned column lists only stones that appear in the mosaic."/>
            <TextBlock Classes="body" Margin="0,4,0,0" Text="A red dot to the left of a stone means its stock is not enough. The dot is set by Fetch Stock (the mark-in-red option), Check Stock, and a By stock Mos that still leaves a stone short; a new Mos clears old dots. Hovering the stone's texture thumbnail shows a large preview and its stock: kg on hand (Bizdeki) left of the arrow, kg left after the mosaic on the right; 0 or less is red, above is green."/>
            <TextBlock Classes="body" Margin="0,4,0,0" Text="The width (cm) box is at the top of the left panel; it applies on Enter or when you leave the box. One stone is 1.2 cm and the value is rounded to the nearest stone count. Below it are the real size and area, the stone count, the mold count (26x26 stones) and the original image size in pixels. If the image is too small for the width, the Insufficient Resolution alert appears. The Select / Deselect All Colors buttons check or uncheck the whole catalog."/>
          </StackPanel>
        </Border>
        <Border Classes="section-card">
          <StackPanel Spacing="4">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Border Width="10" Height="10" CornerRadius="2" Background="#AB47BC"/>
              <TextBlock Classes="h2" Text="Top — Menu and Toolbar" Margin="0"/>
            </StackPanel>
            <TextBlock Classes="body" Text="Toolbar from left to right: Load Image, Open Project, Save, Save As, Mos, Pixel Edit, Grid (and its color), Interpolation, the Google Drive icon (click: Save to Drive; its arrow also has Open from Drive and Drive Folder Settings), five stock icons (an arrow next to the stock sheet and Fetch Stock icons), the Optimum and By stock boxes, and the Stones slider that appears after a Mos made with Optimum. Screenshot (camera: saves what the image area shows right now as a PNG in the mosairEXPORT folder; the navigator and scroll bars are left out), Export (clicking opens the mosairEXPORT / mosairEXPORT As list), theme (dark/light) and language (TR/EN) buttons are on the right. Hovering a button shows a short tooltip."/>
            <TextBlock Classes="body" Margin="0,4,0,0" Text="Drag the splitters between panels to resize them. Double-click the title bar to maximize or restore the window. The middle of the title bar shows the open file's name: the photo's name after loading an image, the project's name once it is saved or opened."/>
            <TextBlock Classes="body" Margin="0,4,0,0" Text="The moon/sun button switches between dark and light theme; the globe button switches the language to Türkçe / English, and menus, tooltips and this guide change at once. Neither is remembered: the app starts in dark theme and Turkish."/>
            <TextBlock Classes="body" Margin="0,4,0,0" Text="Alerts appear in a small window and close with OK. Stock actions that change the sheet first ask for confirmation with Yes / No."/>
            <TextBlock Classes="body" Margin="0,4,0,0" Text="The Tools menu contains every toolbar tool: Mosaicize, Pixel Edit, Show Grid, Grid Color, Interpolation Method, Optimum Stone Count, Fit to Stock, Stone Count and Stock. Active options are marked with ✓; the menu and toolbar always show the same state. Stone Count is available only after a Mos made with Optimum, and Stock only while no stock action is running."/>
            <TextBlock Classes="body" Margin="0,4,0,0" Text="File menu: Load Image, Open Project, Save Project, Save Project As, mosairEXPORT and mosairEXPORT As (both open the image quality choices), Take Screenshot (same as the camera icon), Notify New Images (while ticked, new images in Downloads and on the Desktop are offered), Google Drive (Save to Drive, Open from Drive, Drive Folder Settings). Edit: Select / Deselect All Colors and Cancel Running Job (Esc; same as the red Cancel button in the status bar, enabled only while a cancellable job runs). View: Fit to Screen, Smooth Mouse Motion (when on, wheel zoom glides to the new zoom and a right-drag pan glides on briefly after release; when off, zoom is instant), Properties Panel (F4; hides/shows the right panel). Help: User Guide (F1). While the guide is open the main window cannot be used; there is no separate About window."/>
          </StackPanel>
        </Border>
        <Border Classes="section-card">
          <StackPanel Spacing="4">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Border Width="10" Height="10" CornerRadius="2" Background="#43A047"/>
              <TextBlock Classes="h2" Text="Center — Canvas (Image Area)" Margin="0"/>
            </StackPanel>
            <TextBlock Classes="body" Text="The main area where the mosaic image is displayed and edited. Use the mouse wheel to zoom (the point under the cursor stays put; small touchpad steps zoom less), right-click drag to pan. With View > Smooth Mouse Motion on (the default) zooming glides briefly to the new zoom, and after a quick drag the image glides on in the same direction and slows to a stop. Clicking the image or Fit to Screen stops the glide. You can also drag-and-drop images directly."/>
            <TextBlock Classes="body" Margin="0,4,0,0" Text="Top-right shows the Mini Map (Navigator) — shows your position in large mosaics."/>
            <TextBlock Classes="body" Margin="0,4,0,0" Text="After Mos the stone-texture image is drawn piece by piece, only for the part on screen: from far away stones show in their own colors, and textures sharpen as you zoom in. While a sharper piece is being prepared, an area may look blurred for a moment. Zoomed in far enough, the stone photos are drawn at their own resolution (100 pixels per stone); there is no separate detail setting. There is no image size limit; very large mosaics (e.g. 20 m) work too. Changes to the grid and the grid color apply at once."/>
            <TextBlock Classes="body" Margin="0,4,0,0" Text="Fit to Screen (status bar button, View menu or shortcut) fits the image to the window; it is applied automatically when an image is loaded (Load Image, drag and drop, the new-image notice), after Mos and after Open Project. After Mos the zoom ratio refers to an image of 100 pixels per stone; it does not affect the size of the exported file."/>
          </StackPanel>
        </Border>
        <Border Classes="section-card">
          <StackPanel Spacing="4">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Border Width="10" Height="10" CornerRadius="2" Background="#FF8F00"/>
              <TextBlock Classes="h2" Text="Right Panel — Properties" Margin="0"/>
            </StackPanel>
            <TextBlock Classes="body" Text="Shows details of the selected stone: color swatch, stone code, texture preview, RGB values, pixel and mold coordinates."/>
            <TextBlock Classes="body" Margin="0,4,0,0" Text="Click a texture in Variants to change the stone texture at that pixel; this can also be undone and redone."/>
            <TextBlock Classes="body" Margin="0,4,0,0" Text="While no stone is selected the image's details appear as cards: a preview (file type in the corner) and the file name; DETAILS (resolution, megapixels, aspect ratio, file size, date modified); DOMINANT COLORS (a bar of the colors by share and the 6 colors with code and share); after Mos, MOST USED STONES (5 stones with share, a thin bar and stone count). The x button next to COLOR goes back from a stone to the image details."/>
            <TextBlock Classes="body" Margin="0,4,0,0" Text="Hide / show: the - button in the panel header, F4 or View > Properties Panel hides the panel; a thin strip stays at the right edge, and clicking the strip (arrow) opens the panel again at its previous width. The panel is open each time the app starts."/>
          </StackPanel>
        </Border>
        <Border Classes="section-card">
          <StackPanel Spacing="4">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Border Width="10" Height="10" CornerRadius="2" Background="{DynamicResource FgSecondary}"/>
              <TextBlock Classes="h2" Text="Bottom — Status Bar" Margin="0"/>
            </StackPanel>
            <TextBlock Classes="body" Text="Left: used color count. Center: progress bar, process status and duration. Right: Fit to Screen button, zoom factor (like Zoom=2.0) and on-screen image size. The stock read result at start-up and on each image/project load, and with By stock on the stock summary after a Mos, also appear here. While any work is in progress (Mos, stock fit, stock actions, Google Drive actions, export...) a green wave flows across the whole bar and fades out when the work ends. Changing the language resets the message to Ready."/>
            <TextBlock Classes="body" Margin="0,4,0,0" Text="Cancel: while a Mos, a stock fit or an export runs, a '✕ Cancel' button appears next to the progress bar; Esc and Edit > Cancel Running Job do the same. A cancelled Optimum Mos leaves the previous mosaic as it was. A cancelled classic Mos removes the half-built mosaic and shows the loaded image again. A cancelled stock fit in Mos or on the Stones slider leaves the mosaic without the stock fit. A cancelled fit inside Check Stock puts the mosaic back as it was and writes nothing to the sheet. A cancelled export deletes the partial file. The Stones slider can be cancelled only while a stock fit runs. Stock sheet actions, Google Drive actions and opening a project cannot be cancelled. Cancel pressed during the last steps of a job (rebuilding the mosaic, preparing textures, the final encoding of an export) has no effect; the job finishes normally."/>
          </StackPanel>
        </Border>

        <TextBlock x:Name="sec2en" Classes="h1" Text="Keyboard Shortcuts"/>
        <Border Classes="section-card">
          <StackPanel Spacing="6">
            <TextBlock Text="File" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource FgMuted}" Margin="0,0,0,2"/>
            <StackPanel Orientation="Horizontal"><TextBlock Classes="shortcut-key" Text="{Binding KeyModI, Source={x:Static svc:Loc.Instance}}"/><TextBlock Classes="shortcut-desc" Text="Load image"/></StackPanel>
            <StackPanel Orientation="Horizontal"><TextBlock Classes="shortcut-key" Text="{Binding KeyModO, Source={x:Static svc:Loc.Instance}}"/><TextBlock Classes="shortcut-desc" Text="Open project (.mos)"/></StackPanel>
            <StackPanel Orientation="Horizontal"><TextBlock Classes="shortcut-key" Text="{Binding KeyModS, Source={x:Static svc:Loc.Instance}}"/><TextBlock Classes="shortcut-desc" Text="Save project"/></StackPanel>
            <StackPanel Orientation="Horizontal"><TextBlock Classes="shortcut-key" Text="{Binding KeyModShiftS, Source={x:Static svc:Loc.Instance}}"/><TextBlock Classes="shortcut-desc" Text="Save as"/></StackPanel>
            <StackPanel Orientation="Horizontal"><TextBlock Classes="shortcut-key" Text="{Binding KeyModE, Source={x:Static svc:Loc.Instance}}"/><TextBlock Classes="shortcut-desc" Text="Export image (at the default quality)"/></StackPanel>
            <Border Height="1" Background="{DynamicResource BrdrMain}" Margin="0,4"/>
            <TextBlock Text="Tools" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource FgMuted}" Margin="0,0,0,2"/>
            <StackPanel Orientation="Horizontal"><TextBlock Classes="shortcut-key" Text="{Binding KeyModM, Source={x:Static svc:Loc.Instance}}"/><TextBlock Classes="shortcut-desc" Text="Mosaicize"/></StackPanel>
            <StackPanel Orientation="Horizontal"><TextBlock Classes="shortcut-key" Text="{Binding KeyMod0, Source={x:Static svc:Loc.Instance}}"/><TextBlock Classes="shortcut-desc" Text="Fit to screen"/></StackPanel>
            <StackPanel Orientation="Horizontal"><TextBlock Classes="shortcut-key" Text="Esc"/><TextBlock Classes="shortcut-desc" Text="Cancel the running job (Mos, stock fit, export)"/></StackPanel>
            <Border Height="1" Background="{DynamicResource BrdrMain}" Margin="0,4"/>
            <TextBlock Text="Editing" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource FgMuted}" Margin="0,0,0,2"/>
            <StackPanel Orientation="Horizontal"><TextBlock Classes="shortcut-key" Text="{Binding KeyModZ, Source={x:Static svc:Loc.Instance}}"/><TextBlock Classes="shortcut-desc" Text="Undo"/></StackPanel>
            <StackPanel Orientation="Horizontal"><TextBlock Classes="shortcut-key" Text="{Binding KeyModY, Source={x:Static svc:Loc.Instance}}"/><TextBlock Classes="shortcut-desc" Text="Redo; also works with Shift+Z"/></StackPanel>
            <Border Height="1" Background="{DynamicResource BrdrMain}" Margin="0,4"/>
            <TextBlock Text="Help" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource FgMuted}" Margin="0,0,0,2"/>
            <StackPanel Orientation="Horizontal"><TextBlock Classes="shortcut-key" Text="F1"/><TextBlock Classes="shortcut-desc" Text="Open user guide"/></StackPanel>
            <StackPanel Orientation="Horizontal"><TextBlock Classes="shortcut-key" Text="F4"/><TextBlock Classes="shortcut-desc" Text="Hide / show the properties panel"/></StackPanel>
          </StackPanel>
        </Border>

        <TextBlock x:Name="sec3en" Classes="h1" Text="Mouse Controls"/>
        <Border Classes="section-card">
          <StackPanel Spacing="6">
            <TextBlock Text="On Canvas" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource FgMuted}" Margin="0,0,0,2"/>
            <StackPanel Orientation="Horizontal"><TextBlock Classes="shortcut-key" Text="Wheel"/><TextBlock Classes="shortcut-desc" Text="Zoom (up: zoom in, down: zoom out; glides smoothly)"/></StackPanel>
            <StackPanel Orientation="Horizontal"><TextBlock Classes="shortcut-key" Text="Right + Drag"/><TextBlock Classes="shortcut-desc" Text="Pan (navigate the image)"/></StackPanel>
            <StackPanel Orientation="Horizontal"><TextBlock Classes="shortcut-key" Text="Left Click"/><TextBlock Classes="shortcut-desc" Text="Select pixel / editing operations"/></StackPanel>
            <StackPanel Orientation="Horizontal"><TextBlock Classes="shortcut-key" Text="Middle Click"/><TextBlock Classes="shortcut-desc" Text="Toggle pixel editing mode"/></StackPanel>
            <Border Height="1" Background="{DynamicResource BrdrMain}" Margin="0,4"/>
            <TextBlock Text="Mini Map" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource FgMuted}" Margin="0,0,0,2"/>
            <StackPanel Orientation="Horizontal"><TextBlock Classes="shortcut-key" Text="Left Click"/><TextBlock Classes="shortcut-desc" Text="Click or drag — navigate to that area"/></StackPanel>
            <Border Height="1" Background="{DynamicResource BrdrMain}" Margin="0,4"/>
            <TextBlock Text="Catalog" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource FgMuted}" Margin="0,0,0,2"/>
            <StackPanel Orientation="Horizontal"><TextBlock Classes="shortcut-key" Text="Checkbox"/><TextBlock Classes="shortcut-desc" TextWrapping="Wrap" MaxWidth="380" Text="Include / exclude the stone in Mos"/></StackPanel>
            <StackPanel Orientation="Horizontal"><TextBlock Classes="shortcut-key" Text="Row"/><TextBlock Classes="shortcut-desc" TextWrapping="Wrap" MaxWidth="380" Text="With pixel editing on: pick the source color"/></StackPanel>
            <StackPanel Orientation="Horizontal"><TextBlock Classes="shortcut-key" Text="Hover"/><TextBlock Classes="shortcut-desc" TextWrapping="Wrap" MaxWidth="380" Text="On the texture thumbnail: large preview and stock kg"/></StackPanel>
            <Border Height="1" Background="{DynamicResource BrdrMain}" Margin="0,4"/>
            <TextBlock Text="Toolbar" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource FgMuted}" Margin="0,0,0,2"/>
            <StackPanel Orientation="Horizontal"><TextBlock Classes="shortcut-key" Text="Left Click"/><TextBlock Classes="shortcut-desc" TextWrapping="Wrap" MaxWidth="380" Text="Export icon: the mosairEXPORT / mosairEXPORT As list with the image quality choices. Google Drive icon: Save to Drive."/></StackPanel>
            <StackPanel Orientation="Horizontal"><TextBlock Classes="shortcut-key" Text="Right Click"/><TextBlock Classes="shortcut-desc" TextWrapping="Wrap" MaxWidth="380" Text="Stock sheet icon: Stock Settings. Clear Stock icon: clear this / all mosaic columns. Export icon: open the mosairEXPORT folder."/></StackPanel>
            <StackPanel Orientation="Horizontal"><TextBlock Classes="shortcut-key" Text="Arrow (▾)"/><TextBlock Classes="shortcut-desc" TextWrapping="Wrap" MaxWidth="380" Text="Google Drive: Save to Drive / Open from Drive / Drive Folder Settings. Stock sheet: open / settings. Fetch Stock: disable / mark in red."/></StackPanel>
            <StackPanel Orientation="Horizontal"><TextBlock Classes="shortcut-key" Text="Hover"/><TextBlock Classes="shortcut-desc" TextWrapping="Wrap" MaxWidth="380" Text="By stock box: description and the last stock report"/></StackPanel>
            <Border Height="1" Background="{DynamicResource BrdrMain}" Margin="0,4"/>
            <TextBlock Text="Window" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource FgMuted}" Margin="0,0,0,2"/>
            <StackPanel Orientation="Horizontal"><TextBlock Classes="shortcut-key" Text="Drag"/><TextBlock Classes="shortcut-desc" TextWrapping="Wrap" MaxWidth="380" Text="Title bar: move the window (double-click: maximize / restore). Panel splitters: change the width."/></StackPanel>
          </StackPanel>
        </Border>

        <TextBlock x:Name="sec4en" Classes="h1" Text="Pixel Editing"/>
        <TextBlock Classes="body" Text="A powerful tool that allows you to change individual stone colors on the mosaic."/>
        <Border Classes="section-card" Margin="0,8,0,4">
          <StackPanel Spacing="8">
            <TextBlock Classes="h2" Text="How to Use" Margin="0"/>
            <StackPanel Spacing="6">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Border Classes="icon-badge" Background="#FF6600"><TextBlock Text="1" FontWeight="Bold" Foreground="White" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Text="Activate Mode" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource FgPrimary}"/>
                  <TextBlock Text="Press the middle mouse button, the pencil icon in the toolbar, or Tools > Pixel Edit (a Mos must have run first). 'source' lights up orange in the toolbar." Classes="body" FontSize="11" TextWrapping="Wrap" MaxWidth="440"/>
                </StackPanel>
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Border Classes="icon-badge" Background="#FF6600"><TextBlock Text="2" FontWeight="Bold" Foreground="White" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Text="Select Source Color" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource FgPrimary}"/>
                  <TextBlock Text="Left-click on a stone with the color you want to use, or pick a stone from the catalog on the left." Classes="body" FontSize="11" TextWrapping="Wrap" MaxWidth="440"/>
                </StackPanel>
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Border Classes="icon-badge" Background="#FF6600"><TextBlock Text="3" FontWeight="Bold" Foreground="White" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Text="Apply to Target Pixel" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource FgPrimary}"/>
                  <TextBlock Text="Left-click on the stone you want to change. The color changes instantly; you can paint several stones with the same source." Classes="body" FontSize="11" TextWrapping="Wrap" MaxWidth="440"/>
                </StackPanel>
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Border Classes="icon-badge" Background="#FF6600"><TextBlock Text="4" FontWeight="Bold" Foreground="White" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Text="Undo / Redo / Close" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource FgPrimary}"/>
                  <TextBlock Text="The Undo and Redo shortcuts undo and redo edits. To turn the mode off, press the middle button or the pencil icon again." Classes="body" FontSize="11" TextWrapping="Wrap" MaxWidth="440"/>
                </StackPanel>
              </StackPanel>
            </StackPanel>
          </StackPanel>
        </Border>
        <Border Classes="section-card">
          <StackPanel Spacing="4">
            <TextBlock Classes="h2" Text="Good to Know" Margin="0"/>
            <TextBlock Classes="body" Text="• A new image, a new Mos, a change of the stone count and a by-stock re-fit during Check Stock reset pixel edits (the by-stock re-fit asks first)."/>
            <TextBlock Classes="body" Text="• Undo first undoes stone-variant changes, then color edits."/>
            <TextBlock Classes="body" Text="• If you use a catalog stone that is not in the mosaic's palette, it is added to the palette when the project is saved."/>
            <TextBlock Classes="body" Text="• An edited stone is drawn with its own texture variant, the same way as the other stones (grid included); on screen it looks the same as in the exported file."/>
          </StackPanel>
        </Border>

        <TextBlock x:Name="sec7en" Classes="h1" Text="Optimum Stone Count"/>
        <TextBlock Classes="body" Text="Optimum finds how many kinds of stone the image needs. It runs when you press Mos with the 'Optimum' box in the toolbar checked; uncheck it to use the classic algorithm."/>
        <Border Classes="section-card" Margin="0,8,0,4">
          <StackPanel Spacing="4">
            <TextBlock Classes="h2" Text="How It Works" Margin="0"/>
            <TextBlock Classes="body" Text="First the best result is computed with every checked catalog stone. Then the stones whose removal hurts the image least are removed one at a time. The smallest stone count that keeps color accuracy, detail and edges, and light/dark structure visually unchanged is chosen as the suggestion."/>
          </StackPanel>
        </Border>
        <Border Classes="section-card">
          <StackPanel Spacing="4">
            <TextBlock Classes="h2" Text="Stones Slider" Margin="0"/>
            <TextBlock Classes="body" Text="After a Mos, a 'Stones' slider appears in the toolbar, starting at the suggested value. Once its value stays put for a moment, the mosaic is rebuilt with the chosen stone count; the suggested value is shown next to it."/>
            <TextBlock Classes="body" Margin="0,4,0,0" Text="More stones means richer detail; fewer stones means easier production and less stock. The same adjustment is available under Tools > Stone Count: 'Back to Suggested', 'One More Stone' and 'One Fewer Stone'."/>
          </StackPanel>
        </Border>
        <Border Classes="section-card">
          <StackPanel Spacing="4">
            <TextBlock Classes="h2" Text="Good to Know" Margin="0"/>
            <TextBlock Classes="body" Text="• Each time the slider is released, pixel edits are reset."/>
            <TextBlock Classes="body" Text="• After a Mos only the used stones stay checked in the catalog. If you have not changed the catalog by hand, the next Optimum Mos starts again from your full previous selection."/>
            <TextBlock Classes="body" Text="• Stones disabled by stock actions are also removed from Optimum's stone pool."/>
            <TextBlock Classes="body" Text="• If the last Mos was fitted to stock (By stock), every new stone count on the slider is fitted to the same stock; the status bar reminds you to run Check Stock again for the sheet."/>
            <TextBlock Classes="body" Text="• Opened projects do not show the Stones slider; a project does not contain the Optimum analysis."/>
          </StackPanel>
        </Border>

        <TextBlock x:Name="sec8en" Classes="h1" Text="Stock Management (Google Sheet)"/>
        <TextBlock Classes="body" Text="The five stock icons in the toolbar (between Interpolation and Optimum) work with the stock spreadsheet in Google Sheets; the stock sheet and Fetch Stock icons each have an arrow next to them. The same actions are under Tools > Stock. While a stock action runs these buttons are disabled; if stock is not set up, an alert appears."/>
        <Border Classes="section-card" Margin="0,8,0,4">
          <StackPanel Spacing="4">
            <TextBlock Classes="h2" Text="First-Time Setup" Margin="0"/>
            <TextBlock Classes="body" Text="Click the arrow next to the green sheet icon and choose Stock Settings (right-clicking the icon or Tools > Stock > Stock Settings also works) and enter the Google Sheet ID and the Apps Script URL. They are stored only on that computer and must be entered once per computer."/>
            <TextBlock Classes="body" Margin="0,4,0,0" Text="Anyone with the Script URL can write to the sheet; share it only with people you trust."/>
            <TextBlock Classes="body" Margin="0,4,0,0" Text="Under each field in the settings window there is a description and an example with the part to enter highlighted. The Sheet ID is the part of the sheet link between /d/ and /edit; you can also paste the whole link. The Script URL is the Web app address under Extensions > Apps Script > Deploy > Manage deployments in the sheet and ends with /exec. Save stores the settings, Cancel changes nothing."/>
            <TextBlock Classes="body" Margin="0,4,0,0" Text="Requirements: the sheet must be shared with 'Anyone with the link' with at least Viewer access; the first row must have the mos, Bizdeki (kg) and Tahmini Kalan columns; the web app must be deployed with 'Anyone' access. Try actions that change the sheet on a copy of the sheet first."/>
            <TextBlock Classes="body" Margin="0,4,0,0" Text="When the app starts and whenever an image or project is loaded, the sheet's 'Bizdeki (kg)' values are read automatically and shown in the catalog tooltip; the selection does not change. Stones are matched by the sheet's 'mos' number (1-124)."/>
          </StackPanel>
        </Border>
        <Border Classes="section-card">
          <StackPanel Spacing="6">
            <TextBlock Classes="h2" Text="Buttons" Margin="0"/>
            <StackPanel Orientation="Horizontal"><TextBlock Classes="shortcut-key" Text="Sheet"/><TextBlock Classes="shortcut-desc" TextWrapping="Wrap" MaxWidth="380" Text="Opens the stock sheet in the browser. Arrow next to it: open sheet / stock settings. Does not change the sheet."/></StackPanel>
            <StackPanel Orientation="Horizontal"><TextBlock Classes="shortcut-key" Text="Fetch Stock"/><TextBlock Classes="shortcut-desc" TextWrapping="Wrap" MaxWidth="380" Text="Unchecks stones whose 'Bizdeki (kg)' is 0 or less and checks stones that have stock. With 'Mark stones with no stock in red' from the arrow next to it, the selection stays as it is and stones without stock only get a red dot. Does not change the sheet."/></StackPanel>
            <StackPanel Orientation="Horizontal"><TextBlock Classes="shortcut-key" Text="Check Stock"/><TextBlock Classes="shortcut-desc" TextWrapping="Wrap" MaxWidth="380" Text="Writes the mosaic's stone counts to the project column in the sheet; stones whose 'Tahmini Kalan' goes negative get a red dot. The tooltip shows kg on hand and kg left. With By stock on, it first checks the mosaic against stock (see below). A Mos must have been made or a project opened first. Changes the sheet."/></StackPanel>
            <StackPanel Orientation="Horizontal"><TextBlock Classes="shortcut-key" Text="Clear Stock"/><TextBlock Classes="shortcut-desc" TextWrapping="Wrap" MaxWidth="380" Text="Clears this mosaic's column and resets its header to mozaikX. Right-click: clears all mosaic columns. Asks for confirmation, changes the sheet."/></StackPanel>
            <StackPanel Orientation="Horizontal"><TextBlock Classes="shortcut-key" Text="Add Stock"/><TextBlock Classes="shortcut-desc" TextWrapping="Wrap" MaxWidth="380" Text="Moves 'Tahmini Kalan' values into the 'Bizdeki' column and clears all mosaic columns. Asks for confirmation, changes the sheet."/></StackPanel>
          </StackPanel>
        </Border>
        <Border Classes="section-card">
          <StackPanel Spacing="4">
            <TextBlock Classes="h2" Text="By Stock" Margin="0"/>
            <TextBlock Classes="body" Text="• The box next to Optimum; off when the app starts. Tools > Fit to Stock also turns it on and off."/>
            <TextBlock Classes="body" Text="• When on, Mos (Optimum or classic) is made normally first, then the result is fitted to stock. Available stock: Bizdeki (kg) minus the kg set aside by the other mosaic columns (this project's column is not counted); 1 stone = 3.3 g."/>
            <TextBlock Classes="body" Text="• A stone without enough stock is used as far as its stock goes; the rest is filled with the closest-coloured stone in stock. Changes go where they are least visible and edges are protected. If needed, at most 2 new stone types are added; if that is not enough, the search widens step by step. Rarely used stones are not dropped; if stock is enough, the mosaic does not change."/>
            <TextBlock Classes="body" Text="• Stock is read when the app starts and whenever an image or project is loaded; Fetch Stock does not refresh it. If you changed the sheet, load the image or project again. If no stock sheet is set up, the box has no effect and Mos works as usual; if one is set up but stock cannot be read, Mos is made without it and the status bar says so."/>
            <TextBlock Classes="body" Text="• A short summary appears in the status bar and the full report in the box's tooltip: how many stones (kg) moved from which stone to which, new stone types added, whether the search had to widen, stones still short and stones without a row in the sheet. Stones still short get a red dot. On large mosaics, if the summary does not fit the status bar, only the counts stay there; after Mos and Check Stock the full report opens in a window (scrollable, text can be copied). Moving the stone slider does not open the window; the details are in the tooltip."/>
            <TextBlock Classes="body" Text="• When the Stones slider changes, the new stone count is fitted to the same stock too."/>
            <TextBlock Classes="body" Text="• Check Stock reads stock again before writing. If the mosaic fits, it is written as it is. If not, it is fitted again first and the corrected counts are written in one go; if there are pixel edits it asks first, and with No the current counts are written. On an opened project you are asked to run Mos with this image first, and Check Stock continues as usual. If Cancel (or Esc) is pressed during the fit, the mosaic goes back to how it was and nothing is written to the sheet."/>
          </StackPanel>
        </Border>
        <Border Classes="section-card">
          <StackPanel Spacing="4">
            <TextBlock Classes="h2" Text="Example Flow" Margin="0"/>
            <TextBlock Classes="body" Text="With By stock on: 1. Run Mos; the mosaic is built to fit stock.  2. Review the result and the report in the By stock tooltip.  3. Check Stock to write the counts to the sheet.  4. After production, Add Stock to record the remaining stock in the sheet."/>
            <TextBlock Classes="body" Margin="0,4,0,0" Text="With By stock off (default): 1. Fetch Stock to disable stones that ran out.  2. Run Mos.  3. Check Stock to write the counts to the sheet.  4. If stones get a red dot, disable them and run Mos again and repeat the check.  5. After production, Add Stock to record the remaining stock in the sheet."/>
            <TextBlock Classes="body" Margin="0,4,0,0" Text="The column name in the sheet is the image file name; for example '7' for 7.jpg. If the image is not known, the name of the opened .mos file is used."/>
          </StackPanel>
        </Border>

        <TextBlock x:Name="sec5en" Classes="h1" Text="Project Management"/>
        <Border Classes="section-card">
          <StackPanel Spacing="4">
            <TextBlock Classes="h2" Text=".mos Project File" Margin="0"/>
            <TextBlock Classes="body" Text="The mosaic result, color assignments, catalog selection, pixel edits, stone variants and settings (width, grid, interpolation) are saved in .mos format. Save writes the project to a folder named after the image under Desktop/mosairPROJECT and copies the image next to it; Save As creates a folder with the chosen name. Saving and opening run in the background, so the window does not freeze: the status bar shows 'Saving project' / 'Opening project' and the wave runs. The mosaic as it is when Save is pressed is written; the file is written under a temporary name first and then put in place, so an interrupted save never damages the old project. The Save buttons are disabled while a save runs. The Optimum analysis and stock data are not saved. Projects saved in mosair can also be opened in the WPF application, and projects the WPF app saves as JSON open in mosair. Binary .mos files from older WPF versions must first be opened and saved again in the current WPF."/>
            <StackPanel Orientation="Horizontal" Spacing="2" Margin="0,6,0,0">
              <TextBlock FontSize="12" Foreground="{DynamicResource FgMuted}" Text="Save: "/><TextBlock FontSize="12" Foreground="{DynamicResource FgMuted}" Text="{Binding KeyModS, Source={x:Static svc:Loc.Instance}}"/>
              <TextBlock FontSize="12" Foreground="{DynamicResource FgMuted}" Text=" | Save As: "/><TextBlock FontSize="12" Foreground="{DynamicResource FgMuted}" Text="{Binding KeyModShiftS, Source={x:Static svc:Loc.Instance}}"/>
              <TextBlock FontSize="12" Foreground="{DynamicResource FgMuted}" Text=" | Open: "/><TextBlock FontSize="12" Foreground="{DynamicResource FgMuted}" Text="{Binding KeyModO, Source={x:Static svc:Loc.Instance}}"/>
            </StackPanel>
            <TextBlock Classes="h2" Text="Google Drive" Margin="0,10,0,0"/>
            <TextBlock Classes="body" Text="Projects can be saved, together with their original image, to a Google Drive folder and opened from it. The colored Drive icon in the toolbar (after Interpolation, left of the green stock sheet icon) is Save to Drive; its arrow and the File > Google Drive menu hold Save to Drive, Open from Drive and Drive Folder Settings. There is no Google sign-in in the app: an Apps Script web app that the folder owner sets up once writes to and reads from Drive."/>
            <TextBlock Classes="body" Margin="0,4,0,0" Text="Setup (once): in Drive Folder Settings press Copy script code; paste it into a new project on script.google.com and save; Deploy > New deployment > Web app (Execute as: Me, Who has access: Anyone); paste the address ending in /exec into the Apps Script URL field and the Drive folder link into the folder field (the whole link works, the folder ID is taken from it); press Test connection to see the folder name, then Save. The settings are stored on this computer only (drive.json). If a Drive action is chosen without settings, an alert explains and the settings window opens."/>
            <TextBlock Classes="body" Margin="0,4,0,0" Text="Save to Drive: a Mos must be done or a project opened first. The folder layout is the same as Save (mosairPROJECT): a project folder named after the image inside the Drive folder, holding image name.mos and the original image (the image is sent only when that folder does not have it yet). A project with the same name is moved to the Drive trash. The open file name and the local save stay unchanged. Open from Drive: a Drive-like project browser opens; each project is a card with a preview of the original image, its name, date and size. It has a Search projects box (searches project and folder names), sorting (Newest first / By name), Refresh and Show in Drive, which opens the folder in the browser. Double-click a card or select it and press Open; the project is downloaded with its image, opened like Open Project and fitted to the window."/>
            <TextBlock Classes="body" Margin="0,4,0,0" Text="Security and limits: anyone with the script address can write to and read from the folder; share it only with people you trust. If ALLOWED_FOLDERS (comma-separated folder IDs) is added to the script properties, the script works only with those folders. Projects are sent compressed, but Google does not accept very large requests (about 50 MB). While a Drive action runs the status bar wave flows and the action cannot be cancelled. When the app is updated, update the script too: Copy script code, paste it over the old code on script.google.com and save, then Deploy > Manage deployments > pencil > Version: New version > Deploy (the address stays the same; do not create a new deployment). With an old script the project goes to the root of the folder, the image is not sent and no preview appears."/>
          </StackPanel>
        </Border>
        <Border Classes="section-card">
          <StackPanel Spacing="4">
            <TextBlock Classes="h2" Text="Export" Margin="0"/>
            <TextBlock Classes="body" Text="Saves the mosaic result (the real stone-texture image on screen) to a file. Clicking the export icon opens a list: mosairEXPORT and mosairEXPORT As. Both start with the title 'Choose image quality' followed by 10 image quality choices; each choice shows only the image size in pixels and the estimated file size (e.g. 13,333 × 23,688 px · JPEG ≈ 420 MB). The default choice says (default). The file sizes are estimated when the list opens; until ready a choice says estimating. The same choices are under mosairEXPORT and mosairEXPORT As in the File menu."/>
            <TextBlock Classes="body" Margin="0,4,0,0" Text="mosairEXPORT saves at the chosen quality to the Desktop/mosairEXPORT folder; the file name contains the date, time, image name and size in cm. It writes JPEG when possible and when it fits in memory, otherwise PNG. mosairEXPORT As asks for the location and format (JPEG/PNG). Ctrl/⌘+E does mosairEXPORT at the default quality without opening the list. If the grid is enabled, the export includes grid lines. Right-click the export icon to open the mosairEXPORT folder."/>
            <TextBlock Classes="body" Margin="0,4,0,0" Text="There is no size limit; the image is always saved at the chosen image quality and is never reduced automatically. For a smaller file, choose a lower image quality. Without stone images every stone is drawn in its own colour at the same size. The only limit is JPEG itself: at most 65,535 pixels per side; for a larger image choose PNG or a lower quality. A large PNG is written piece by piece and uses little memory; a large JPEG needs about width × height × 4 bytes of memory. So mosairEXPORT saves PNG when memory would not be enough; if such a JPEG is chosen with mosairEXPORT As, you are asked first (Yes: JPEG anyway, No: cancel). For large files the status bar shows the progress as a percentage. The export can be stopped with the Cancel button in the status bar or with Esc. A half-written or cancelled file is deleted. Example: a 20 m mosaic as a 66,680 × 66,680 px PNG is 2.8 GB and takes about 26 seconds. The export writes the mosaic as it was when the export started; edits made meanwhile do not reach the file."/>
          </StackPanel>
        </Border>

        <TextBlock x:Name="sec6en" Classes="h1" Text="Tips"/>
        <Border Classes="section-card">
          <StackPanel Spacing="6">
            <StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="&#x1F4A1;" FontSize="16" VerticalAlignment="Top"/><TextBlock Classes="body" Text="Press Enter after changing the width (cm) value — dimensions update automatically."/></StackPanel>
            <Border Height="1" Background="{DynamicResource BgCard}"/>
            <StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="&#x1F4A1;" FontSize="16" VerticalAlignment="Top"/><TextBlock Classes="body" Text="Ctrl/⌘+E exports at the default quality; in the list that choice says (default). The zoom on screen does not affect the file. A higher image quality makes the file larger and the export slower."/></StackPanel>
            <Border Height="1" Background="{DynamicResource BgCard}"/>
            <StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="&#x1F4A1;" FontSize="16" VerticalAlignment="Top"/><TextBlock Classes="body" Text="Drag and drop images directly from your file manager into the application."/></StackPanel>
            <Border Height="1" Background="{DynamicResource BgCard}"/>
            <StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="&#x1F4A1;" FontSize="16" VerticalAlignment="Top"/><TextBlock Classes="body" Text="When a new JPEG/PNG arrives in Downloads or on the Desktop, an 'Open it in mosair?' notice appears at the bottom right; Open loads the image fitted to the window. The notice closes by itself after 7 s; the count stops while the pointer is over it. Subfolders are not watched. Turn it off with File > Notify New Images."/></StackPanel>
            <Border Height="1" Background="{DynamicResource BgCard}"/>
            <StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="&#x1F4A1;" FontSize="16" VerticalAlignment="Top"/><TextBlock Classes="body" Text="Use the mini map to quickly navigate large mosaics."/></StackPanel>
            <Border Height="1" Background="{DynamicResource BgCard}"/>
            <StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="&#x1F4A1;" FontSize="16" VerticalAlignment="Top"/><TextBlock Classes="body" Text="If Optimum's result looks too plain for a colorful image, raise the Stones slider a few steps for more detail and color variety."/></StackPanel>
            <Border Height="1" Background="{DynamicResource BgCard}"/>
            <StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="&#x1F4A1;" FontSize="16" VerticalAlignment="Top"/><TextBlock Classes="body" Text="To keep a stone out entirely, uncheck it in the catalog and run Mos; Optimum chooses only among checked stones."/></StackPanel>
            <Border Height="1" Background="{DynamicResource BgCard}"/>
            <StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="&#x1F4A1;" FontSize="16" VerticalAlignment="Top"/><TextBlock Classes="body" Text="If no stock sheet is set up, By stock does nothing; there is no need to uncheck it."/></StackPanel>
          </StackPanel>
        </Border>
        <Border Height="20"/>
      </StackPanel>

      </Panel>
    </ScrollViewer>
  </DockPanel>
</Window>
